{
  "name": "pontx-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "catalog:check": "tsx scripts/catalog-check.ts",
    "catalog:accept": "tsx scripts/accept-candidate.ts",
    "sdk:verify": "tsx scripts/verify-sdk-releases.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pontx/nodejs-sdk": "^0.1.0",
    "@pontx/shadcn-ui": "^1.2.3",
    "@pontx/spec": "^0.1.16-alpha.2",
    "@react-router/node": "7.18.1",
    "@react-router/serve": "7.18.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "7.18.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/react-router": "^1.3.1",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
