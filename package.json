{
  "name": "pontx-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "build": "pnpm radius:verify && pnpm metadata:sync && react-router build && pnpm prerender:verify && pnpm bundle:verify",
    "bundle:verify": "tsx scripts/verify-browser-bundle.ts",
    "prerender:verify": "tsx scripts/verify-prerender-output.ts",
    "dev": "pnpm metadata:sync && react-router dev",
    "start": "react-router-serve ./build/server/nodejs_*/index.js",
    "typecheck": "pnpm metadata:sync && react-router typegen && tsc",
    "test": "pnpm metadata:sync && vitest run",
    "test:watch": "vitest",
    "qa:browser:open": "tsx scripts/open-production-qa-browser.ts",
    "search:eval": "pnpm metadata:sync && tsx scripts/evaluate-search.ts",
    "ai:eval": "pnpm metadata:sync && vitest run app/lib/ai/agent-evaluation.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "metadata:sync": "tsx scripts/sync-metadata.ts",
    "radius:verify": "node scripts/verify-radius-system.mjs",
    "sdk:verify": "pnpm metadata:sync && tsx scripts/verify-sdk-releases.ts"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ag-ui/core": "0.0.57",
    "@anthropic-ai/sdk": "0.117.1",
    "@neondatabase/serverless": "^1.1.0",
    "@pontx/shadcn-ui": "^1.2.18",
    "@pontx/spec": "1.0.0-beta.9",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@react-router/node": "7.18.2",
    "@react-router/serve": "7.18.2",
    "better-auth": "^1.6.26",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "isbot": "^5.1.36",
    "lodash-es": "^4.18.1",
    "lucide-react": "^1.34.0",
    "motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "7.18.2",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/react-router": "^1.3.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-commonjs": "^0.10.4",
    "vitest": "^4.1.10",
    "yaml": "^2.8.1"
  },
  "pnpm": {
    "overrides": {
      "@pontx/spec": "1.0.0-beta.9",
      "dompurify@<=3.4.12": "3.4.13",
      "nanoid@<3.3.17": "3.3.17"
    }
  }
}
