e:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2\",\n      className\n    )}\n    {...props}\n  />\n))\nTabsContent.displayName = TabsPrimitive.Content.displayName\n\nexport { Tabs, TabsList, TabsTrigger, TabsContent }\n","/**\n * Validation utilities for API Playground\n * Provides parameter validation based on JSON Schema\n *\n * This module implements validation logic for:\n * - Parameter type validation (string, number, boolean, array)\n * - Format validation (email, URL, pattern matching)\n * - Range validation (min/max length, min/max value)\n * - Required field validation\n * - JSON syntax validation\n *\n * @module validation\n */\n\n// ==================== Type Definitions ====================\n\n/**\n * JSON Schema definition for parameter validation\n * Supports common JSON Schema validation keywords\n */\nexport interface JSONSchema {\n  /** The data type of the parameter */\n  type: 'string' | 'number' | 'integer' | 'boolean' | 'array' | 'object';\n\n  /** Allowed enum values */\n  enum?: string[];\n\n  /** Default value for the parameter */\n  default?: unknown;\n\n  /** Format constraint (email, uri, etc.) */\n  format?: string;\n\n  /** Regular expression pattern for validation */\n  pattern?: string;\n\n  /** Minimum string length */\n  minLength?: number;\n\n  /** Maximum string length */\n  maxLength?: number;\n\n  /** Minimum numeric value */\n  minimum?: number;\n\n  /** Maximum numeric value */\n  maximum?: number;\n}\n\n/**\n * API parameter definition\n * Matches OpenAPI/Pontx parameter specification\n */\nexport interface Parameter {\n  /** Parameter name */\n  name: string;\n\n  /** Parameter location */\n  in: 'path' | 'query' | 'header';\n\n  /** Whether the parameter is required */\n  required?: boolean;\n\n  /** JSON Schema for validation */\n  schema: JSONSchema;\n\n  /** Human-readable description */\n  description?: string;\n}\n\n/**\n * Validation error structure\n */\nexport interface ValidationError {\n  /** Field name