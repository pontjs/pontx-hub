-{"version":3,"file":"ApiDirectory-DzvFhB94.js","sources":["../src/api-directory/DirectorySearch.tsx","../src/api-directory/ApiMenuItem.tsx","../src/api-directory/TagGroup.tsx","../src/api-directory/ApiDirectory.tsx"],"sourcesContent":["import * as React from \"react\";\nimport { Search, X } from \"lucide-react\";\nimport { Input } from \"@/components/ui/input\";\nimport { cn } from \"@/utils/cn\";\nimport { useI18n } from \"@/contexts/I18nContext\";\n\nexport interface DirectorySearchProps {\n  /** 搜索值 */\n  value: string;\n  /** 搜索值变化回调 */\n  onChange: (value: string) => void;\n  /** 占位符文本 */\n  placeholder?: string;\n  /** 自定义样式 */\n  className?: string;\n}\n\n/**\n * 目录搜索框组件\n * 带搜索图标和清除按钮的输入框\n */\nexport const DirectorySearch: React.FC<DirectorySearchProps> = ({\n  value,\n  onChange,\n  placeholder = \"搜索 API...\",\n  className,\n}) => {\n  const { t } = useI18n();\n  const inputRef = React.useRef<HTMLInputElement>(null);\n\n  const handleClear = React.useCallback(() => {\n    onChange(\"\");\n    inputRef.current?.focus();\n  }, [onChange]);\n\n  const handleChange = React.useCallback(\n    (event: React.ChangeEvent<HTMLInputElement>) => {\n      onChange(event.target.value);\n    },\n    [onChange]\n  );\n\n  const handleKeyDown = React.useCallback(\n    (event: React.KeyboardEvent<HTMLInputElement>) => {\n      if (event.key === \"Escape\" && value) {\n        event.preventDefault();\n        onChange(\"\");\n      }\n    },\n    [value, onChange]\n  );\n\n  return (\n    <div className={cn(\"relative\", className)}>\n      <Search\n        className=\"absolute inset-y-0 left-3 my-auto h-4 w-4 text-muted-foreground pointer-events-none\"\n        aria-hidden=\"true\"\n      />\n      <Input\n        ref={inputRef}\n        type=\"search\"\n        value={value}\n        onChange={handleChange}\n        onKeyDown={handleKeyDown}\n        placeholder={placeholder}\n        aria-label={t(\"searchApis\")}\n        className=\"pl-9 pr-9\"\n      />\n      {value && (\n        <button\n          type=\"button\"\n          onClick={handleClear}\n          aria-label={t(\"clearSearch\")}\n          className={cn(\n            \"absolute inset-y-0 right-2 my-auto\",\n            \"p-1 rounded-sm hover:bg-accent transition-colors\",\n            \"focus:outline-none focus-visible:ring-2 focus-visible:ring-ring\"\n          )}\n        >\n          <X className=\"h-4 w-4 text-muted-foreground\" aria-hidden=\"true\" />\n        </button>\n      )}\n    </div>\n  );\n};\n\nDirectorySearch.displayName = \"DirectorySearch\";\n","import * as React from \"react\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { cn } from \"@/utils/cn\";\nimport type { PontxAPI } from \"@pontx/spec\";\nimport { useI18n } from \"@/contexts/I18nContext\";\n\n/**\n * 获取 HTTP 方法对应的颜色样式\n */\nexport const getMethodColor = (method: string): string => {\n  switch (method.toLowerCase()) {\n    case \"get\":\n      return \"bg-green-100 text-green-800 border-green-200\";\n    case \"post\":\n      return \"bg-blue-100 text-blue-800 border-blue-200\";\n    case \"put\":\n      return \"bg-yellow-100 text-yellow-800 border-yellow-200\";\n    case \"delete\":\n      return \"bg-red-100 text-red-800 border-red-200\";\n    case \"patch\":\n      return \"bg-purple-100 text-purple-800 border-purple-200\";\n    case \"options\":\n    case \"head\":\n    default:\n      return \"bg-gray-100 text-gray-800 border-gray-200\";\n  }\n};\n\nexport interface ApiMenuItemProps {\n  /** API 数据 */\n  api: PontxAPI & { name: string };\n  /** 是否选中 */\n  selected?: boolean;\n  /** 是否显示 HTTP 方法徽章 */\n  showMethod?: boolean;\n  /** 点击回调 */\n  onClick?: (apiName: string, api: PontxAPI) => void;\n  /** 自定义样式 */\n  className?: string;\n}\n\n/**\n * API 菜单项组件\n * 显示单个 API 的信息，支持选中状态和键盘交互\n */\nexport const ApiMenuItem = React.forwardRef<HTMLButtonElement, ApiMenuItemProps>(\n  ({ api, selected = false, showMethod = true, onClick, className }, ref) => {\n    const { t } = useI18n();\n    const handleClick = React.useCallback(() => {\n      onClick?.(api.name, api);\n    }, [api, onClick]);\n\n    const handleKeyDown = React.useCallback(\n      (event: React.KeyboardEvent<HTMLButtonElement>) => {\n        if (event.key === \"Enter\" || event.key === \" \") {\n          event.preventDefault();\n          onClick?.(api.name, api);\n        }\n      },\n      [api, onClick]\n    );\n\n    return (\n      <li role=\"none\" className=\"w-full min-w-0 overflow-hidden\">\n        <button\n          ref={ref}\n          type=\"button\"\n          role=\"menuitem\"\n          aria-selected={selected}\n          onClick={handleClick}\n          onKeyDown={handleKeyDown}\n          className={cn(\n            \"block w-full max-w-full overflow-hidden text-left px-3 py-2 rounded-md transition-colors\",\n            \"hover:bg-accent focus:bg-accent\",\n            \"focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-1\",\n            selected && \"bg-accent border-l-2 border-primary\",\n            className\n          )}\n        >\n          <div className=\"flex w-full min-w-0 items-center gap-2 overflow-hidden\">\n            {showMethod && api.method && (\n              <Badge\n                className={cn(\n                  \"font-mono text-[10px] px-1.5 py-0 h-5 shrink-0 uppercase\",\n                  getMethodColor(api.method)\n                )}\n                aria-label={`${t(\"httpMethod\")} ${api.method}`}\n              >\n                {api.method}\n              </Badge>\n            )}\n            <div className=\"min-w-0 flex-1\">\n              <span\n                className=\"block min-w-0 truncate font-mono text-sm\"\n                title={api.name}\n              >\n                {api.name.includes(\"/\") ? api.name.split(\"/\").pop() : api.name}\n              </span>\n              {api.title && (\n                <p\n                  className=\"mt-0.5 truncate text-xs text-muted-foreground\"\n                  title={api.title}\n                >\n                  {api.title}\n                </p>\n              )}\n            </div>\n          </div>\n        </button>\n      </li>\n    );\n  }\n);\n\nApiMenuItem.displayName = \"ApiMenuItem\";\n","import * as React from \"react\";\nimport { ChevronDown, ChevronRight } from \"lucide-react\";\nimport { cn } from \"@/utils/cn\";\nimport { ApiMenuItem } from \"./ApiMenuItem\";\nimport type { PontxAPI } from \"@pontx/spec\";\nimport { useI18n } from \"@/contexts/I18nContext\";\n\nexport interface TagGroupProps {\n  /** 标签名称 */\n  tagName: string;\n  /** 该标签下的 API 列表 */\n  apis: Array<PontxAPI & { name: string }>;\n  /** 是否展开 */\n  expanded?: boolean;\n  /** 展开状态变化回调 */\n  onExpandedChange?: (expanded: boolean) => void;\n  /** 当前选中的 API name */\n  selectedApiName?: string;\n  /** 是否显示 HTTP 方法徽章 */\n  showMethod?: boolean;\n  /** API 选中回调 */\n  onApiSelect?: (apiName: string, api: PontxAPI, tagName: string) => void;\n  /** 自定义样式 */\n  className?: string;\n}\n\n/**\n * 标签分组组件\n * 可折叠的 API 分组，显示标签名和 API 数量\n */\nexport const TagGroup: React.FC<TagGroupProps> = ({\n  tagName,\n  apis,\n  expanded = false,\n  onExpandedChange,\n  selectedApiName,\n  showMethod = true,\n  onApiSelect,\n  className,\n}) => {\n  const { locale, t } = useI18n();\n  const handleToggle = React.useCallback(() => {\n    onExpandedChange?.(!expanded);\n  }, [expanded, onExpandedChange]);\n\n  /** 包装 onApiSelect，注入当前 tagName */\n  const handleApiSelect = React.useCallback(\n    (apiName: string, api: PontxAPI) => {\n      onApiSelect?.(apiName, api, tagName);\n    },\n    [onApiSelect, tagName],\n  );\n\n  const handleKeyDown = React.useCallback(\n    (event: React.KeyboardEvent<HTMLButtonElement>) => {\n      if (event.key === \"Enter\" || event.key === \" \") {\n        event.preventDefault();\n        onExpandedChange?.(!expanded);\n      }\n    },\n    [expanded, onExpandedChange]\n  );\n\n  const ChevronIcon = expanded ? ChevronDown : ChevronRight;\n\n  return (\n    <div className={cn(\"min-w-0 overflow-hidden border-b border-border last:border-b-0\", className)}>\n      <button\n        type=\"button\"\n        onClick={handleToggle}\n        onKeyDown={handleKeyDown}\n        aria-expanded={expanded}\n        aria-controls={`tag-group-${tagName}`}\n        className={cn(\n          \"w-full flex items-center justify-between px-3 py-2\",\n          \"hover:bg-accent transition-colors\",\n          \"focus:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset\"\n        )}\n      >\n        <div className=\"flex items-center gap-2\">\n          <ChevronIcon\n            className=\"h-4 w-4 text-muted-foreground shrink-0\"\n            aria-hidden=\"true\"\n          />\n          <span className=\"font-medium text-sm truncate\">{tagName}</span>\n        </div>\n        <span\n          className=\"text-xs text-muted-foreground tabular-nums\"\n          aria-label={locale === \"zh-CN\" ? `${apis.length} 个 API` : `${apis.length} APIs`}\n        >\n          ({apis.length})\n        </span>\n      </button>\n\n      {expanded && (\n        <ul\n          id={`tag-group-${tagName}`}\n          role=\"menu\"\n          aria-label={`${tagName} ${t(\"apiList\")}`}\n          className=\"m-0 w-full min-w-0 list-none p-0 pb-2\"\n        >\n          {apis.map((api) => (\n            <ApiMenuItem\n              key={api.name}\n              api={api}\n              selected={selectedApiName === api.name}\n              showMethod={showMethod}\n              onClick={handleApiSelect}\n            />\n          ))}\n        </ul>\n      )}\n    </div>\n  );\n};\n\nTagGroup.displayName = \"TagGroup\";\n","import * as React from \"react\";\nimport { PontxSpec, PontxAPI } from \"@pontx/spec\";\nimport { cn } from \"@/utils/cn\";\nimport { DirectorySearch } from \"./DirectorySearch\";\nimport { TagGroup as TagGroupComponent } from \"./TagGroup\";\nimport { I18nProvider, useI18n, type UiLocale } from \"@/contexts/I18nContext\";\n\n// 本地定义的 TagGroup 类型，与 @pontx/spec 中的一致\ninterface TagGroupData {\n  name: string;\n  apis: Record<string, PontxAPI>;\n  description?: string;\n}\n\nexport interface ApiDirectoryProps {\n  /** API 规格数据 */\n  spec: PontxSpec;\n  /** 当前选中的 API name */\n  selectedApiName?: string;\n  /** API 选中回调 */\n  onApiSelect?: (apiName: string, api: PontxAPI, tagName: string) => void;\n  /** 自定义样式 */\n  className?: string;\n  /** 默认展开的标签列表 */\n  defaultExpandedTags?: string[];\n  /** 是否显示 HTTP 方法徽章 */\n  showMethod?: boolean;\n  /** 搜索框占位符 */\n  searchPlaceholder?: string;\n  /** Locale for component-owned interface copy. Defaults to zh-CN. */\n  locale?: UiLocale;\n}\n\n// API 带有确定的 name 字段\ntype ApiWithName = PontxAPI & { name: string };\n\n/**\n * 判断 API 是否匹配搜索关键词\n */\nconst matchesSearch = (api: ApiWithName, searchTerm: string): boolean => {\n  const term = searchTerm.toLowerCase();\n  return (\n    (api.name?.toLowerCase().includes(term) ?? false) ||\n    (api.title?.toLowerCase().includes(term) ?? false) ||\n    (api.summary?.toLowerCase().includes(term) ?? false) ||\n    (api.description?.toLowerCase().includes(term) ?? false) ||\n    (api.path?.toLowerCase().includes(term) ?? false)\n  );\n};\n\n/**\n * 将 TagGroup 的 apis Record 转换为数组\n */\nconst apisRecordToArray = (apis: Record<string, PontxAPI>): ApiWithName[] => {\n  return Object.entries(apis).map(([name, api]) => ({\n    ...api,\n    name: api.name ?? name,\n  }));\n};\n\n/**\n * API 目录组件\n * 左侧纵向菜单，支持关键词搜索，按 tags 分组展示 API 列表\n */\nconst LocalizedApiDirectory: React.FC<ApiDirectoryProps> = ({\n  spec,\n  selectedApiName,\n  onApiSelect,\n  className,\n  defaultExpandedTags = [],\n  showMethod = true,\n  searchPlaceholder,\n}) => {\n  const { t } = useI18n();\n  const [searchTerm, setSearchTerm] = React.useState(\"\");\n  const [expandedTags, setExpandedTags] = React.useState<Set<string>>(\n    () => new Set(defaultExpandedTags)\n  );\n\n  // 获取按标签分组的 API\n  const tagGroups = React.useMemo(() => {\n    return PontxSpec.getTagGroups(spec) as TagGroupData[];\n  }, [spec]);\n\n  // 选中 API 时自动展开所在分组\n  React.useEffect(() => {\n    if (!selectedApiName) return;\n    for (const group of tagGroups) {\n      if (selectedApiName in group.apis) {\n        setExpandedTags((prev) => {\n          if (prev.has(group.name)) return prev;\n          const next = new Set(prev);\n          next.add(group.name);\n          return next;\n        });\n        break;\n      }\n    }\n  }, [selectedApiName, tagGroups]);\n\n  // 过滤后的标签分组\n  const filteredTagGroups = React.useMemo((): Array<{\n    name: string;\n    apis: ApiWithName[];\n    description?: string;\n  }> => {\n    const result: Array<{\n      name: string;\n      apis: ApiWithName[];\n      description?: string;\n    }> = [];\n\n    for (const group of tagGroups) {\n      const apisArray = apisRecordToArray(group.apis);\n\n      if (!searchTerm.trim()) {\n        result.push({\n          name: group.name,\n          apis: apisArray,\n          description: group.description,\n        });\n      } else {\n        const matchedApis = apisArray.filter((api) =>\n          matchesSearch(api, searchTerm)\n        );\n        if (matchedApis.length > 0) {\n          result.push({\n            name: group.name,\n            apis: matchedApis,\n            description: group.description,\n          });\n        }\n      }\n    }\n\n    return result;\n  }, [tagGroups, searchTerm]);\n\n  // 搜索时自动展开匹配的分组\n  const effectiveExpandedTags = React.useMemo(() => {\n    if (searchTerm.trim()) {\n      return new Set(filteredTagGroups.map((g) => g.name));\n    }\n    return expandedTags;\n  }, [searchTerm, filteredTagGroups, expandedTags]);\n\n  // 处理标签展开/折叠\n  const handleTagExpandedChange = React.useCallback(\n    (tagName: string, expanded: boolean) => {\n      setExpandedTags((prev) => {\n        const next = new Set(prev);\n        if (expanded) {\n          next.add(tagName);\n        } else {\n          next.delete(tagName);\n        }\n        return next;\n      });\n    },\n    []\n  );\n\n  // 处理搜索变化\n  const handleSearchChange = React.useCallback((value: string) => {\n    setSearchTerm(value);\n  }, []);\n\n  const hasResults = filteredTagGroups.length > 0;\n  const isSearching = searchTerm.trim().length > 0;\n\n  return (\n    <nav\n      className={cn(\"flex h-full w-full min-w-0 flex-col overflow-hidden\", className)}\n      aria-label={t(\"apiDirectory\")}\n    >\n      {/* 搜索框 */}\n      <div className=\"p-3 border-b border-border shrink-0\">\n        <DirectorySearch\n          value={searchTerm}\n          onChange={handleSearchChange}\n          placeholder={searchPlaceholder}\n        />\n      </div>\n\n      {/* 分组列表 */}\n      <div className=\"min-w-0 flex-1 overflow-x-hidden overflow-y-auto\">\n        {hasResults ? (\n          filteredTagGroups.map((group) => (\n            <TagGroupComponent\n              key={group.name}\n              tagName={group.name}\n              apis={group.apis}\n              expanded={effectiveExpandedTags.has(group.name)}\n              onExpandedChange={(expanded) =>\n                handleTagExpandedChange(group.name, expanded)\n              }\n              selectedApiName={selectedApiName}\n              showMethod={showMethod}\n              onApiSelect={onApiSelect}\n            />\n          ))\n        ) : (\n          <div\n            className=\"p-4 text-center text-muted-foreground text-sm\"\n            role=\"status\"\n            aria-live=\"polite\"\n          >\n            {isSearching ? (\n              <>\n                {t(\"noMatchingApis\")}: “<span className=\"font-medium\">{searchTerm}</span>”\n              </>\n            ) : (\n              t(\"noApis\")\n            )}\n          </div>\n        )}\n      </div>\n    </nav>\n  );\n};\n\nexport const ApiDirectory: React.FC<ApiDirectoryProps> = (props) => (\n  <I18nProvider locale={props.locale}>\n    <LocalizedApiDirectory {...props} />\n  </I18nProvider>\n);\n\nApiDirectory.displayName = \"ApiDirectory\";\n"],"names":["DirectorySearch","value","onChange","placeholder","className","t","useI18n","inputRef","React","handleClear","handleChange","event","handleKeyDown","cn","jsx","Search","Input","X","getMethodColor","method","ApiMenuItem","api","selected","showMethod","onClick","ref","handleClick","jsxs","Badge","TagGroup","tagName","apis","expanded","onExpandedChange","selectedApiName","onApiSelect","locale","handleToggle","handleApiSelect","apiName","ChevronIcon","ChevronDown","ChevronRight","matchesSearch","searchTerm","term","apisRecordToArray","name","LocalizedApiDirectory","spec","defaultExpandedTags","searchPlaceholder","setSearchTerm","expandedTags","setExpandedTags","tagGroups","PontxSpec","group","prev","next","filteredTagGroups","result","apisArray","matchedApis","effectiveExpandedTags","g","handleTagExpandedChange","handleSearchChange","hasResults","isSearching","TagGroupComponent","Fragment","ApiDirectory","props","I18nProvider"],"mappings":";;;;;;AAqBO,MAAMA,IAAkD,CAAC;AAAA,EAC9D,OAAAC;AAAA,EACA,UAAAC;AAAA,EACA,aAAAC,IAAc;AAAA,EACd,WAAAC;AACF,MAAM;AACJ,QAAM,EAAE,GAAAC,EAAA,IAAMC,EAAA,GACRC,IAAWC,EAAM,OAAyB,IAAI,GAE9CC,IAAcD,EAAM,YAAY,MAAM;AAC1C,IAAAN,EAAS,EAAE,GACXK,EAAS,SAAS,MAAA;AAAA,EACpB,GAAG,CAACL,CAAQ,CAAC,GAEPQ,IAAeF,EAAM;AAAA,IACzB,CAACG,MAA+C;AAC9C,MAAAT,EAASS,EAAM,OAAO,KAAK;AAAA,IAC7B;AAAA,IACA,CAACT,CAAQ;AAAA,EAAA,GAGLU,IAAgBJ,EAAM;AAAA,IAC1B,CAACG,MAAiD;AAChD,MAAIA,EAAM,QAAQ,YAAYV,MAC5BU,EAAM,eAAA,GACNT,EAAS,EAAE;AAAA,IAEf;AAAA,IACA,CAACD,GAAOC,CAAQ;AAAA,EAAA;AAGlB,2BACG,OAAA,EAAI,WAAWW,EAAG,YAAYT,CAAS,GACtC,UAAA;AAAA,IAAA,gBAAAU;AAAA,MAACC;AAAA,MAAA;AAAA,QACC,WAAU;AAAA,QACV,eAAY;AAAA,MAAA;AAAA,IAAA;AAAA,IAEd,gBAAAD;AAAA,MAACE;AAAA,MAAA;AAAA,QACC,KAAKT;AAAA,QACL,MAAK;AAAA,QACL,OAAAN;AAAA,QACA,UAAUS;AAAA,QACV,WAAWE;AAAA,QACX,aAAAT;AAAA,QACA,cAAYE,EAAE,YAAY;AAAA,QAC1B,WAAU;AAAA,MAAA;AAAA,IAAA;AAAA,IAEXJ,KACC,gBAAAa;AAAA,MAAC;AAAA,MAAA;AAAA,QACC,MAAK