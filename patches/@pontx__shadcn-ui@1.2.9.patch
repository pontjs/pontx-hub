间值转换为原生日期或时间控件使用的值。 */\nexport function toDatePickerValue(value: string, format?: string): string {\n  return toTemporalInputValue(value, format);\n}\n\n/** 将日期或日期时间控件的值按 schema.format 序列化回接口参数值。 */\nexport function fromDatePickerValue(\n  value: string,\n  format?: string,\n  referenceValue?: string\n): string {\n  return fromTemporalInputValue(value, format, referenceValue);\n}\n\n/**\n * Generate example data from a JSON Schema\n *\n * Priority order for example generation:\n * 1. Explicit `example` field\n * 2. First item from `examples` array\n * 3. `default` value\n * 4. First value from `enum`\n * 5. Generated value based on type and format\n *\n * Handles circular references to prevent infinite recursion.\n *\n * @param schema - The JSON Schema to generate example from\n * @param visited - Set of visited schema references to detect circular references\n * @returns Generated example data matching the schema\n * @example\n * ```typescript\n * const schema = { type: 'string', format: 'email' };\n * const example = generateExampleFromSchema(schema);\n * // Returns: \"user@example.com\"\n * ```\n */\nexport function generateExampleFromSchema(\n  schema: JSONSchema,\n  visited: Set<string> = new Set()\n): any {\n  // Handle circular references\n  const schemaKey = JSON.stringify(schema);\n  if (visited.has(schemaKey)) {\n    return null; // Return null for circular references\n  }\n  visited.add(schemaKey);\n\n  // Priority 1: Use explicit example if provided\n  if (schema.example !== undefined) {\n    return schema.example;\n  }\n\n  // Priority 2: Use first example from examples array\n  if (schema.examples && schema.examples.length > 0) {\n    return schema.examples[0];\n  }\n\n  // Priority 3: Use default value if provided\n  if (schema.default !== undefined) {\n    return schema.default;\n  }\n\n  // Priority 4: Use enum value if provided\n  if (schema.enum && schema.enum.length > 0) {\n    return schema.enum[0];\n  }\n\n  // Handle allOf by merging schemas\n  if (schema.allOf && schema.allOf.length > 0) {\n    const merged: any = {};\n    for (const subSchema of schema.allOf) {\n      const example = generateExampleFromSchema(subSchema, visited);\n      if (typeof example === \"object\" && !Array.isArray(example)) {\n        Object.assign(merged, example);\n      }\n    }\n    return merged;\n  }\n\n  // Handle anyOf and oneOf by using first schema\n  if (schema.anyOf && schema.anyOf.length > 0) {\n    return generateExampleFromSchema(schema.anyOf[0], visited);\n  }\n\n  if (schema.oneOf && schema.oneOf.length > 0) {\n    return generateExampleFromSchema(schema.oneOf[0], visited);\n  }\n\n  // Generate based on type\n  switch (schema.type) {\n    case \"string\":\n      return generateStringExample(schema);\n\n    case \"number\":\n      return 42;\n\n    case \"integer\":\n      return 42;\n\n    case \"boolean\":\n      return true;\n\n    case \"null\":\n      return null;\n\n    case \"array\":\n      if (schema.items) {\n        const itemExample = generateExampleFromSchema(schema.items, visited);\n        return [itemExample];\n      }\n      return [];\n\n    case \"object\":\n      return generateObjectExample(schema, visited);\n\n    default:\n      // If no type specified, try to infer from properties\n      if (schema.properties) {\n        return generateObjectExample(schema, visited);\n      }\n      return null;\n  }\n}\n\n/**\n * Generate string example based on format\n * Supports common string formats defined in JSON Schema specification\n *\n * @param schema - The JSON Schema with string type\n * @returns A string example matching the format, or generic \"string\" if no format specified\n * @internal\n */\nfunction generateStringExample(schema: JSONSchema): string {\n  switch (schema.format) {\n    case \"email\":\n      return \"user@example.com\";\n\n    case \"date-time\":\n      return new Date().toISOString();\n\n    case \"uri\":\n    case \"url\":\n      return \"https://example.com\";\n\n    case \"uuid\":\n      return \"123e4567-e89b-12d3-a456-426614174000\";\n\n    case \"date\":\n      return new Date().toISOString().split(\"T\")[0];\n\n    case \"time\":\n      return new Date().toISOString().split(\"T\")[1];\n\n    default:\n      return \"string\";\n  }\n}\n\n/**\n * Generate object example from schema properties\n * Recursively generates examples for all defined properties\n *\n * @param schema - The JSON Schema with object type\n * @param visited - Set of visited schemas for circular reference detection\n * @returns An object with example values for each property\n * @internal\n */\nfunction generateObjectExample(\n  schema: JSONSchema,\n  visited: Set<string>\n): Record<string, any> {\n  const result: Record<string, any> = {};\n\n  if (schema.properties) {\n    for (const [key, propSchema] of Object.entries(schema.properties)) {\n      result[key] = generateExampleFromSchema(propSchema, visited);\n    }\n  }\n\n  return result;\n}\n\n/**\n * Generate empty template from a JSON Schema\n *\n * Creates a template object with empty/zero values for each type:\n * - string: \"\"\n * - number/integer: 0\n * - boolean: false\n * - array: []\n * - object: {} with empty properties\n * - null: null\n *\n * Uses `default` values from schema if provided.\n * Handles circular references to prevent infinite recursion.\n *\n * @param schema - The JSON Schema to generate template from\n * @param visited - Set of visited schema references to detect circular references\n * @returns Generated template with empty/default values\n * @example\n * ```typescript\n * const schema = {\n *   type: 'object',\n *   properties: {\n *     name: { type: 'string' },\n *     age: { type: 'number' }\n *   }\n * };\n * const template = generateTemplateFromSchema(schema);\n * // Returns: { name: \"\", age: 0 }\n * ```\n */\nexport function generateTemplateFromSchema(\n  schema: JSONSchema,\n  visited: Set<string> = new Set()\n): any {\n  // Handle circular references\n  const schemaKey = JSON.stringify(schema);\n  if (visited.has(schemaKey)) {\n    return null; // Return null for circular references\n  }\n  visited.add(schemaKey);\n\n  // Priority 1: Use default value if provided\n  if (schema.default !== undefined) {\n    return schema.default;\n  }\n\n  // Generate based on type\n  switch (schema.type) {\n    case \"string\":\n      return \"\";\n\n    case \"number\":\n    case \"integer\":\n      return 0;\n\n    case \"boolean\":\n      return false;\n\n    case \"null\":\n      return null;\n\n    case \"array\":\n      return []; // Empty array for template\n\n    case \"object\":\n      return generateObjectTemplate(schema, visited);\n\n    default:\n      // If no type specified, try to infer from properties\n      if (schema.properties) {\n        return generateObjectTemplate(schema, visited);\n      }\n      return null;\n  }\n}\n\n/**\n * Generate object template from schema properties\n * Creates an object with empty/default values for all properties\n *\n * @param schema - The JSON Schema with object type\n * @param visited - Set of visited schemas for circular reference detection\n * @returns An object with empty/default values for each property\n * @internal\n */\nfunction generateObjectTemplate(\n  schema: JSONSchema,\n  visited: Set<string>\n): Record<string, any> {\n  const result: Record<string, any> = {};\n\n  if (schema.properties) {\n    for (const [key, propSchema] of Object.entries(schema.properties)) {\n      // Include all properties in template (both required and optional)\n      result[key] = generateTemplateFromSchema(propSchema, visited);\n    }\n  }\n\n  return result;\n}\n\n/**\n * Resolve $ref references in a JSON Schema\n *\n * Recursively resolves JSON Schema $ref references by looking up referenced schemas\n * in the components object. Supports references in the format:\n * - `#/components/schemas/SchemaName`\n *\n * Handles circular references by detecting and preventing infinite recursion.\n * When a circular reference is detected, returns a placeholder object.\n *\n * @param schema - The JSON Schema to resolve references in\n * @param components - The components/schemas object containing referenced schemas\n * @param visited - Set of visited references to detect circular references\n * @returns Schema with all $ref references resolved\n * @example\n * ```typescript\n * const schema = { $ref: '#/components/schemas/User' };\n * const components = {\n *   User: { type: 'object', properties: { name: { type: 'string' } } }\n * };\n * const resolved = resolveSchemaRefs(schema, components);\n * // Returns: { type: 'object', properties: { name: { type: 'string' } } }\n * ```\n */\nexport function resolveSchemaRefs(\n  schema: JSONSchema,\n  components?: Record<string, JSONSchema>,\n  visited: Set<string> = new Set()\n): JSONSchema {\n  // If schema is null or undefined, return as-is\n  if (!schema || typeof schema !== \"object\") {\n    return schema;\n  }\n\n  // Handle $ref\n  if (schema.$ref) {\n    // Check for circular reference\n    if (visited.has(schema.$ref)) {\n      // Return a placeholder to prevent infinite recursion\n      return { type: \"object\", description: \"Circular reference detected\" };\n    }\n\n    visited.add(schema.$ref);\n\n    // Parse the $ref path\n    const refPath = schema.$ref;\n    let resolvedSchema: JSONSchema | undefined;\n\n    // Handle #/components/schemas/Name format\n    if (refPath.startsWith(\"#/components/schemas/\")) {\n      const schemaName = refPath.split(\"/\").pop();\n      if (schemaName && components && components[schemaName]) {\n        resolvedSchema = components[schemaName];\n      }\n    }\n\n    // If we found the referenced schema, resolve it recursively\n    if (resolvedSchema) {\n      return resolveSchemaRefs(resolvedSchema, components, visited);\n    }\n\n    // If we couldn't resolve the reference, return the original schema\n    return schema;\n  }\n\n  // Clone the schema to avoid mutating the original\n  const resolved: JSONSchema = { ...schema };\n\n  // Resolve $refs in properties\n  if (schema.properties) {\n    resolved.properties = {};\n    for (const [key, propSchema] of Object.entries(schema.properties)) {\n      resolved.properties[key] = resolveSchemaRefs(\n        propSchema,\n        components,\n        new Set(visited) // Create new visited set for each property to allow multiple paths\n      );\n    }\n  }\n\n  // Resolve $refs in items\n  if (schema.items) {\n    resolved.items = resolveSchemaRefs(\n      schema.items,\n      components,\n      new Set(visited)\n    );\n  }\n\n  // Resolve $refs in allOf\n  if (schema.allOf) {\n    resolved.allOf = schema.allOf.map((s) =>\n      resolveSchemaRefs(s, components, new Set(visited))\n    );\n  }\n\n  // Resolve $refs in anyOf\n  if (schema.anyOf) {\n    resolved.anyOf = schema.anyOf.map((s) =>\n      resolveSchemaRefs(s, components, new Set(visited))\n    );\n  }\n\n  // Resolve $refs in oneOf\n  if (schema.oneOf) {\n    resolved.oneOf = schema.oneOf.map((s) =>\n      resolveSchemaRefs(s, components, new Set(visited))\n    );\n  }\n\n  return resolved;\n}\n","/**\n * Request Body Editor Component\n * Provides Monaco Editor for editing API request bodies with JSON validation\n */\n\nimport React, { useEffect, useState, useCallback, useMemo } from \"react\";\nimport { MonacoEditorWrapper } from \"@/components/ui/monaco-editor-wrapper\";\nimport { generateExampleFromSchema, generateTemplateFromSchema, type JSONSchema } from \"@/lib/schema\";\nimport { validateJSON } from \"@/lib/validation\";\n\nexport interface RequestBodyEditorProps {\n  /** Request body schema definition */\n  schema?: JSONSchema;\n\n  /** Current JSON content */\n  value: string;\n\n  /** Content change callback */\n  onChange: (value: string) => void;\n\n  /** JSON validation error */\n  error?: string;\n\n  /** Editor height in pixels */\n  height?: number;\n\n  /** Theme (light/dark) */\n  theme?: \"vs-light\" | \"vs-dark\";\n\n  /** Force fallback to textarea (for testing) */\n  useFallback?: boolean;\n}\n\n/**\n * Request Body Editor with Monaco Editor integration\n */\nexport const RequestBodyEditor: React.FC<RequestBodyEditorProps> = ({\n  schema,\n  value,\n  onChange,\n  error,\n  height = 300,\n  theme = \"vs-light\",\n  useFallback = false,\n}) => {\n  const [initialized, setInitialized] = useState(false);\n  const [localError, setLocalError] = useState<string | null>(null);\n\n  // Generate initial value from schema if value is empty\n  const initialValue = useMemo(() => {\n    if (value && value.trim() !== \"\") {\n      return value;\n    }\n\n    if (!schema) {\n      return \"{}\";\n    }\n\n    if (schema.example !== undefined) {\n      return JSON.stringify(schema.example, null, 2);\n    }\n\n    if (schema.examples && schema.examples.length > 0) {\n      return JSON.stringify(schema.examples[0], null, 2);\n    }\n\n    if (schema.default !== undefined) {\n      return JSON.stringify(schema.default, null, 2);\n    }\n\n    try {\n      const example = generateExampleFromSchema(schema);\n      if (example !== null && example !== undefined) {\n        return JSON.stringify(example, null, 2);\n      }\n    } catch (err) {\n      console.warn(\"Failed to generate example from schema:\", err);\n    }\n\n    try {\n      const template = generateTemplateFromSchema(schema);\n      return JSON.stringify(template, null, 2);\n    } catch (err) {\n      console.warn(\"Failed to generate template from schema:\", err);\n    }\n\n    return \"{}\";\n  }, [schema, value]);\n\n  useEffect(() => {\n    if (!initialized) {\n      setInitialized(true);\n      if (!value || value.trim() === \"\") {\n        onChange(initialValue);\n      } else {\n        const validationError = validateJSON(value);\n        setLocalError(validationError);\n      }\n    }\n  }, [initialized, value, initialValue, onChange]);\n\n  const handleChange = useCallback(\n    (newValue: string) => {\n      onChange(newValue);\n      const validationError = validateJSON(newValue);\n      setLocalError(validationError);\n    },\n    [onChange]\n  );\n\n  const isDark = theme === \"vs-dark\";\n  const displayError = error || localError;\n\n  if (useFallback) {\n    return (\n      <div className=\"relative\">\n        <div className=\"mb-2 rounded-md bg-yellow-50 p-2 text-sm text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-200\">\n          JSON 编辑器加载失败，使用基本编辑器\n        </div>\n        <textarea\n          value={value}\n          onChange={(e) => {\n            const newValue = e.target.value;\n            handleChange(newValue);\n          }}\n          className=\"w-full rounded-md border border-gray-300 p-2 font-mono text-sm dark:border-gray-700 dark:bg-gray-900\"\n          style={{ height: `${height}px` }}\n          data-testid=\"fallback-textarea\"\n        />\n        {displayError && (\n          <div className=\"mt-2 text-sm text-red-600 dark:text-red-400\" role=\"alert\">\n            {displayError}\n          </div>\n        )}\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"relative\">\n      <div className=\"rounded-md border border-gray-200 dark:border-gray-700\" data-testid=\"request-body-editor\">\n        <MonacoEditorWrapper\n          value={value}\n          onChange={handleChange}\n          isDark={isDark}\n          height={height}\n          readOnly={false}\n        />\n      </div>\n      {displayError && (\n        <div className=\"mt-2 text-sm text-red-600 dark:text-red-400\" role=\"alert\">\n          {displayError}\n        </div>\n      )}\n    </div>\n  );\n};\n\nRequestBodyEditor.displayName = \"RequestBodyEditor\";\n","/**\n * Execute Button Component\n * Renders the execute/send request button with loading state and validation\n */\n\nimport React, { useCallback } from 'react';\nimport { Button } from '@/components/ui/button';\nimport { useI18n } from '@/contexts/I18nContext';\n\nexport interface ExecuteButtonProps {\n  /** Callback when execute button is clicked */\n  onExecute: () => void;\n\n  /** Whether the request is currently executing */\n  isExecuting: boolean;\n\n  /** Whether the button should be disabled */\n  disabled: boolean;\n\n  /** Reason why the button is disabled (for tooltip) */\n  disabledReason?: string;\n\n  /** Optional validation callback before executing */\n  onValidate?: () => boolean;\n\n  /** Error handler callback */\n  onError?: (error: Error) => void;\n}\n\n/**\n * Execute Button Component\n */\nexport const ExecuteButton: React.FC<ExecuteButtonProps> = ({\n  onExecute,\n  isExecuting,\n  disabled,\n  disabledReason,\n  onValidate,\n  onError,\n}) => {\n  const { t } = useI18n();\n  const handleClick = useCallback(async () => {\n    try {\n      if (onValidate) {\n        const isValid = onValidate();\n        if (!isValid) {\n          return;\n        }\n      }\n\n      onExecute();\n    } catch (error) {\n      console.error('Error executing request:', error);\n      if (onError && error instanceof Error) {\n        onError(error);\n      }\n    }\n  }, [onExecute, onValidate, onError]);\n\n  const isDisabled = disabled || isExecuting;\n\n  return (\n    <div className=\"flex justify-end border-t border-gray-200 pt-4 dark:border-gray-700\">\n      <Button\n        onClick={handleClick}\n        disabled={isDisabled}\n        title={disabled ? disabledReason : undefined}\n        aria-busy={isExecuting}\n        className=\"min-w-[120px]\"\n      >\n        {isExecuting ? (\n          <>\n            <span className=\"mr-2 inline-block h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent\" data-testid=\"loading-spinner\" />\n            {t('executing')}\n          </>\n        ) : (\n          t('executeRequest')\n        )}\n      </Button>\n    </div>\n  );\n};\n\nExecuteButton.displayName = 'ExecuteButton';\n","import { getLocationForJsonPath, parseWithPointers } from \"@stoplight/json\";\nimport type { JSONSchema } from \"@/lib/schema\";\n\nexport type JsonFieldPath = Array<string | number>;\n\nexport interface JsonFieldDescription {\n  /** JSON 数据路径。 */\n  path: JsonFieldPath;\n  /** Monaco 使用的一基行号。 */\n  lineNumber: number;\n  /** Schema 中未经截断的完整说明。 */\n  description: string;\n  /** 适合在代码行尾展示的单行短说明。 */\n  inlineDescription: string;\n}\n\nconst DEFAULT_INLINE_DESCRIPTION_LENGTH = 72;\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return Boolean(value) && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction decodeJsonPointerSegment(segment: string): string {\n  return decodeURIComponent(segment).replace(/~1/g, \"/\").replace(/~0/g, \"~\");\n}\n\nfunction resolveLocalRef(rootSchema: JSONSchema, ref: string): JSONSchema | undefined {\n  if (!ref.startsWith(\"#/\")) return undefined;\n\n  let current: unknown = rootSchema;\n  for (const segment of ref.slice(2).split(\"/\").map(decodeJsonPointerSegment)) {\n    if (!isRecord(current) || !(segment in current)) return undefined;\n    current = current[segment];\n  }\n\n  return isRecord(current) ? (current as JSONSchema) : undefined;\n}\n\nfunction dereferenceSchema(\n  schema: JSONSchema | undefined,\n  rootSchema: JSONSchema,\n  visitedRefs: Set<string>\n): JSONSchema | undefined {\n  if (!schema?.$ref || visitedRefs.has(schema.$ref)) return schema;\n\n  const resolved = resolveLocalRef(rootSchema, schema.$ref);\n  if (!resolved) return schema;\n\n  const nextVisitedRefs = new Set(visitedRefs);\n  nextVisitedRefs.add(schema.$ref);\n  return dereferenceSchema(resolved, rootSchema, nextVisitedRefs);\n}\n\nfunction findSchemaAtPath(\n  schema: JSONSchema | undefined,\n  path: JsonFieldPath,\n  rootSchema: JSONSchema,\n  visitedRefs: Set<string> = new Set()\n): JSONSchema | undefined {\n  const resolvedSchema = dereferenceSchema(schema, rootSchema, visitedRefs);\n  if (!resolvedSchema) return undefined;\n  if (path.length === 0) return resolvedSchema;\n\n  const compositeSchemas = [\n    ...(resolvedSchema.allOf ?? []),\n    ...(resolvedSchema.oneOf ?? []),\n    ...(resolvedSchema.anyOf ?? []),\n  ];\n  for (const compositeSchema of compositeSchemas) {\n    const match = findSchemaAtPath(\n      compositeSchema,\n      path,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n    if (match) return match;\n  }\n\n  const [segment, ...remainingPath] = path;\n  if (typeof segment === \"number\" && resolvedSchema.items) {\n    return findSchemaAtPath(\n      resolvedSchema.items,\n      remainingPath,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n  }\n\n  const propertySchema = resolvedSchema.properties?.[String(segment)];\n  if (propertySchema) {\n    return findSchemaAtPath(\n      propertySchema,\n      remainingPath,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n  }\n\n  if (isRecord(resolvedSchema.additionalProperties)) {\n    return findSchemaAtPath(\n      resolvedSchema.additionalProperties as JSONSchema,\n      remainingPath,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n  }\n\n  return undefined;\n}\n\nfunction getSchemaDescription(\n  schema: JSONSchema | undefined,\n  rootSchema: JSONSchema,\n  visitedSchemas: Set<JSONSchema> = new Set()\n): string | undefined {\n  const resolvedSchema = dereferenceSchema(schema, rootSchema, new Set());\n  if (!resolvedSchema || visitedSchemas.has(resolvedSchema)) return undefined;\n\n  const description = resolvedSchema.description ?? resolvedSchema.title;\n  if (typeof description === \"string\" && description.trim()) return description;\n\n  const nextVisitedSchemas = new Set(visitedSchemas);\n  nextVisitedSchemas.add(resolvedSchema);\n  const compositeSchemas = [\n    ...(resolvedSchema.allOf ?? []),\n    ...(resolvedSchema.oneOf ?? []),\n    ...(resolvedSchema.anyOf ?? []),\n  ];\n  for (const compositeSchema of compositeSchemas) {\n    const compositeDescription = getSchemaDescription(\n      compositeSchema,\n      rootSchema,\n      nextVisitedSchemas\n    );\n    if (compositeDescription) return compositeDescription;\n  }\n\n  return undefined;\n}\n\nfunction collectObjectFieldPaths(\n  value: unknown,\n  parentPath: JsonFieldPath = [],\n  paths: JsonFieldPath[] = []\n): JsonFieldPath[] {\n  if (Array.isArray(value)) {\n    value.forEach((item, index) => {\n      collectObjectFieldPaths(item, [...parentPath, index], paths);\n    });\n    return paths;\n  }\n\n  if (!isRecord(value)) return paths;\n\n  Object.entries(value).forEach(([key, item]) => {\n    const path = [...parentPath, key];\n    paths.push(path);\n    collectObjectFieldPaths(item, path, paths);\n  });\n  return paths;\n}\n\nexport function normalizeInlineDescription(\n  description: string,\n  maxLength = DEFAULT_INLINE_DESCRIPTION_LENGTH\n): string {\n  const normalized = description.replace(/\\s+/g, \" \").trim();\n  if (normalized.length <= maxLength) return normalized;\n  return `${normalized.slice(0, Math.max(0, maxLength - 1)).trimEnd()}…`;\n}\n\n/**\n * 把实际 JSON 字段映射到响应 Schema，并返回可供 Monaco decoration 使用的行号和说明。\n * 无效 JSON、缺失 Schema 或没有描述时安全降级为空数组。\n */\nexport function getJsonFieldDescriptions(\n  jsonCode: string,\n  schema?: JSONSchema\n): JsonFieldDescription[] {\n  if (!jsonCode.trim() || !schema) return [];\n\n  try {\n    const parsed = parseWithPointers(jsonCode);\n    if (!parsed.ast || parsed.diagnostics.length > 0) return [];\n\n    const descriptionsByLine = new Map<number, JsonFieldDescription>();\n    for (const path of collectObjectFieldPaths(parsed.data)) {\n      const fieldSchema = findSchemaAtPath(schema, path, schema);\n      const rawDescription = getSchemaDescription(fieldSchema, schema);\n      if (!rawDescription) continue;\n\n      const location = getLocationForJsonPath(parsed, path);\n      if (!location?.range) continue;\n\n      const lineNumber = location.range.start.line + 1;\n      if (descriptionsByLine.has(lineNumber)) continue;\n\n      const description = rawDescription.trim();\n      descriptionsByLine.set(lineNumber, {\n        path,\n        lineNumber,\n        description,\n        inlineDescription: normalizeInlineDescription(description),\n      });\n    }\n\n    return [...descriptionsByLine.values()];\n  } catch {\n    return [];\n  }\n}\n","import { useEffect, useRef } from \"react\";\nimport type { Monaco, OnMount } from \"@monaco-editor/react\";\nimport type { JsonFieldDescription } from \"@/lib/schema-descriptions\";\n\ntype MonacoEditor = Parameters<OnMount>[0];\n\nexport interface MonacoFieldDescriptionContext {\n  editor: MonacoEditor;\n  monaco: Monaco;\n}\n\n/** 在字段右侧展示浅色斜体短说明，并为整行提供完整说明悬浮提示。 */\nexport function useMonacoFieldDescriptions(\n  context: MonacoFieldDescriptionContext | null,\n  descriptions: JsonFieldDescription[]\n): void {\n  const collectionRef = useRef<ReturnType<MonacoEditor[\"createDecorationsCollection\"]> | null>(null);\n\n  useEffect(() => {\n    collectionRef.current?.clear();\n    collectionRef.current = null;\n\n    const model = context?.editor.getModel();\n    if (!context || !model || descriptions.length === 0) return;\n\n    const decorations = descriptions.flatMap((item) => {\n      if (item.lineNumber < 1 || item.lineNumber > model.getLineCount()) return [];\n\n      const maxColumn = model.getLineMaxColumn(item.lineNumber);\n      return [{\n        range: new context.monaco.Range(item.lineNumber, 1, item.lineNumber, maxColumn),\n        options: {\n          hoverMessage: { value: item.description },\n          stickiness: context.monaco.editor.TrackedRangeStickiness.NeverGrowsWhenTypingAtEdges,\n          after: {\n            content: `  ${item.inlineDescription}`,\n            inlineClassName: \"pontx-monaco-field-description\",\n            cursorStops: context.monaco.editor.InjectedTextCursorStops.None,\n          },\n        },\n      }];\n    });\n\n    collectionRef.current = context.editor.createDecorationsCollection(decorations);\n\n    return () => {\n      collectionRef.current?.clear();\n      collectionRef.current = null;\n    };\n  }, [context, descriptions]);\n}\n","/**\n * Results Display Component\n * Displays API execution results with status, headers, and response body\n */\n\nimport React, { useState, useCallback, useMemo } from 'react';\nimport type { OnMount } from '@monaco-editor/react';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { MonacoEditorWrapper } from '@/components/ui/monaco-editor-wrapper';\nimport type { PlaygroundExecutionResult } from '@/types/playground';\nimport type { JSONSchema } from '@/lib/schema';\nimport { getJsonFieldDescriptions } from '@/lib/schema-descriptions';\nimport {\n  useMonacoFieldDescriptions,\n  type MonacoFieldDescriptionContext,\n} from '@/hooks/useMonacoFieldDescriptions';\nimport { useI18n } from '@/contexts/I18nContext';\n\nexport interface ResultsDisplayProps {\n  /** Execution result to display */\n  result?: PlaygroundExecutionResult;\n\n  /** Whether to use dark theme */\n  isDark?: boolean;\n\n  /** JSON Schema matching the actual response status */\n  responseSchema?: JSONSchema;\n}\n\n/**\n * Results Display Component\n */\nexport const ResultsDisplay: React.FC<ResultsDisplayProps> = ({\n  result,\n  isDark = false,\n  responseSchema,\n}) => {\n  const { t } = useI18n();\n  const [headersExpanded, setHeadersExpanded] = useState(false);\n  const [copyStatus, setCopyStatus] = useState<'idle' | 'success' | 'error'>('idle');\n  const [editorContext, setEditorContext] = useState<MonacoFieldDescriptionContext | null>(null);\n\n  const { status = 0, statusText = '', headers = {}, body, duration } = result ?? {};\n\n  const isSuccess = status >= 200 && status < 300;\n  const isError = status >= 400;\n\n  const formattedBody = useMemo(() => {\n    if (body === null || body === undefined) {\n      return '';\n    }\n\n    if (typeof body === 'string') {\n      try {\n        const parsed = JSON.parse(body);\n        return JSON.stringify(parsed, null, 2);\n      } catch {\n        return body;\n      }\n    }\n\n    return JSON.stringify(body, null, 2);\n  }, [body]);\n\n  const fieldDescriptions = useMemo(\n    () => getJsonFieldDescriptions(formattedBody, responseSchema),\n    [formattedBody, responseSchema]\n  );\n  useMonacoFieldDescriptions(editorContext, fieldDescriptions);\n\n  const handleEditorMount: OnMount = useCallback((editor, monaco) => {\n    setEditorContext({ editor, monaco });\n  }, []);\n\n  const handleCopy = useCallback(async () => {\n    try {\n      await navigator.clipboard.writeText(formattedBody);\n      setCopyStatus('success');\n\n      setTimeout(() => {\n        setCopyStatus('idle');\n      }, 3000);\n    } catch (error) {\n      console.error('Failed to copy to clipboard:', error);\n      setCopyStatus('error');\n\n      setTimeout(() => {\n        setCopyStatus('idle');\n      }, 3000);\n    }\n  }, [formattedBody]);\n\n  if (!result) {\n    return null;\n  }\n\n  return (\n    <div className=\"mt-6\" data-testid=\"results-display\">\n      <Card>\n        <CardHeader>\n          <div className=\"flex items-center justify-between\">\n            <CardTitle className=\"text-lg\">{t('responseResult')}</CardTitle>\n            <div className=\"flex items-center gap-2\">\n              {duration !== undefined && (\n                <span className=\"text-sm text-muted-foreground\">\n                  {duration} ms\n                </span>\n              )}\n              <Badge\n                data-testid=\"status-badge\"\n                className={\n                  isSuccess\n                    ? 'bg-green-500 hover:bg-green-600'\n                    : isError\n                    ? 'bg-red-500 hover:bg-red-600'\n                    : 'bg-gray-500 hover:bg-gray-600'\n                }\n              >\n                {status}\n              </Badge>\n              <span className=\"text-sm font-medium\">{statusText}</span>\n            </div>\n          </div>\n        </CardHeader>\n\n        <CardContent className=\"space-y-4\">\n          {/* Response Headers */}\n          <div>\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              onClick={() => setHeadersExpanded(!headersExpanded)}\n              className=\"mb-2 p-0 h-auto font-semibold hover:bg-transparent\"\n            >\n              {t('responseHeaders')} ({Object.keys(headers).length})\n              <span className=\"ml-2\">{headersExpanded ? '▼' : '▶'}</span>\n            </Button>\n\n            {headersExpanded && (\n              <div className=\"rounded-md border border-gray-200 dark:border-gray-700\">\n                <table className=\"w-full text-sm\">\n                  <tbody>\n                    {Object.entries(headers).map(([key, value]) => (\n                      <tr\n                        key={key}\n                        className=\"border-b border-gray-200 last:border-0 dark:border-gray-700\"\n                      >\n                        <td className=\"p-2 font-mono text-xs font-medium text-gray-600 dark:text-gray-400\">\n                          {key}\n                        </td>\n                        <td className=\"p-2 font-mono text-xs\">{value}</td>\n                      </tr>\n                    ))}\n                    {Object.keys(headers).length === 0 && (\n                      <tr>\n                        <td className=\"p-2 text-center text-gray-500\" colSpan={2}>\n                          {t('noResponseHeaders')}\n                        </td>\n                      </tr>\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            )}\n          </div>\n\n          {/* Response Body */}\n          <div>\n            <div className=\"mb-2 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between\">\n              <div className=\"min-w-0\">\n                <h4 className=\"font-semibold\">{t('responseBody')}</h4>\n                {fieldDescriptions.length > 0 && (\n                  <p className=\"mt-1 text-xs leading-5 text-muted-foreground\">\n                    <span className=\"font-medium text-foreground/75\">\n                      {t('responseFieldDescriptions', { count: fieldDescriptions.length })}\n                    </span>\n                    <span aria-hidden=\"true\"> · </span>\n                    {t('responseFieldDescriptionsHint')}\n                  </p>\n                )}\n              </div>\n              <div className=\"flex items-center gap-2\">\n                {copyStatus === 'success' && (\n                  <span className=\"text-sm text-green-600 dark:text-green-400\">\n                    {t('copied')}\n                  </span>\n                )}\n                {copyStatus === 'error' && (\n                  <span className=\"text-sm text-red-600 dark:text-red-400\">\n                    {t('copyFailed')}\n                  </span>\n                )}\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={handleCopy}\n                  disabled={!formattedBody}\n                >\n                  {t('copyResponse')}\n                </Button>\n              </div>\n            </div>\n\n            <div className=\"rounded-md border border-gray-200 dark:border-gray-700\">\n              <MonacoEditorWrapper\n                value={formattedBody}\n                onChange={() => {}}\n                isDark={isDark}\n                height={300}\n                readOnly={true}\n                onMount={handleEditorMount}\n                options={{\n                  readOnly: true,\n                  domReadOnly: true,\n                  minimap: { enabled: false },\n                  ariaLabel: fieldDescriptions.length > 0\n                    ? `${t('responseBody')}，${t('responseFieldDescriptions', { count: fieldDescriptions.length })}`\n                    : t('responseBody'),\n                }}\n              />\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  );\n};\n\nResultsDisplay.displayName = 'ResultsDisplay';\n","/**\n * CodeSnippets 组件\n * 展示 CLI/SDK 等代码片段，支持场景切换和实时生成\n */\n\nimport React, {\n  Fragment,\n  useState,\n  useEffect,\n  useCallback,\n  useRef,\n  useMemo,\n  type ReactNode,\n} from 'react';\nimport { Button } from '@/components/ui/button';\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from '@/components/ui/select';\nimport { MonacoEditorWrapper } from '@/components/ui/monaco-editor-wrapper';\nimport type { CodeGenScenario, CodeGenRequest, PlaygroundRequest } from '@/types/playground';\nimport { useI18n } from '@/contexts/I18nContext';\n\nexport interface CodeSnippetsProps {\n  /** 可用的代码生成场景列表 */\n  scenarios: CodeGenScenario[];\n  /** 当前请求参数快照 */\n  request: PlaygroundRequest;\n  /** 生成代码的回调 */\n  onGenerateCode: (req: CodeGenRequest) => string | Promise<string>;\n  /** 是否使用暗色主题 */\n  isDark?: boolean;\n  /** 是否显示代码场景选择器；场景由外层导航时可关闭 */\n  showScenarioSelector?: boolean;\n}\n\ntype ShellTokenKind =\n  | 'plain'\n  | 'command'\n  | 'keyword'\n  | 'option'\n  | 'string'\n  | 'comment'\n  | 'literal';\n\nconst shellKeywords = new Set([\n  'add',\n  'call',\n  'exec',\n  'install',\n  'preview',\n  'run',\n  'search',\n  'show',\n  'skill',\n]);\n\nconst shellTokenClasses: Record<Exclude<ShellTokenKind, 'plain'>, string> = {\n  command: 'font-semibold text-blue-700 dark:text-blue-300',\n  keyword: 'text-purple-700 dark:text-purple-300',\n  option: 'text-amber-700 dark:text-amber-300',\n  string: 'text-green-700 dark:text-green-300',\n  comment: 'text-gray-500 dark:text-gray-400',\n  literal: 'text-rose-700 dark:text-rose-300',\n};\n\nfunction shellToken(kind: ShellTokenKind, value: string, key: number): ReactNode {\n  return kind === 'plain' ? (\n    value\n  ) : (\n    <span className={shellTokenClasses[kind]} data-shell-token={kind} key={key}>\n      {value}\n    </span>\n  );\n}\n\nfunction highlightShellLine(line: string): ReactNode[] {\n  const parts =\n    line.match(/\\s+|'[^']*'|\"(?:\\\\.|[^\"\\\\])*\"|#[^\\n]*|--?[A-Za-z0-9][\\w-]*|[^\\s]+/g) ?? [];\n  let sawCommand = false;\n\n  return parts.map((part, index) => {\n    if (/^\\s+$/.test(part)) return shellToken('plain', part, index);\n    if (part.startsWith('#')) return shellToken('comment', part, index);\n    if (part.startsWith(\"'\") || part.startsWith('\"')) {\n      return shellToken('string', part, index);\n    }\n    if (part.startsWith('-')) return shellToken('option', part, index);\n    if (!sawCommand) {\n      sawCommand = true;\n      return shellToken('command', part, index);\n    }\n    if (shellKeywords.has(part)) return shellToken('keyword', part, index);\n    if (/^(true|false|null|\\d+(?:\\.\\d+)?)$/.test(part)) {\n      return shellToken('literal', part, index);\n    }\n    return shellToken('plain', part, index);\n  });\n}\n\nfunction isShellLanguage(language: string | undefined): boolean {\n  return language === 'shell' || language === 'bash' || language === 'sh';\n}\n\nexport interface HighlightedShellCodeProps {\n  code: string;\n  label: string;\n  height: number;\n}\n\nexport function HighlightedShellCode({\n  code,\n  label,\n  height,\n}: HighlightedShellCodeProps) {\n  const lines = code.split('\\n');\n\n  return (\n    <pre\n      aria-label={label}\n      className=\"max-h-[320px] overflow-auto whitespace-pre-wrap break-words py-4 font-mono text-sm leading-5 text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-inset\"\n      data-testid=\"code-snippets-shell\"\n      style={{ minHeight: height }}\n      tabIndex={0}\n    >\n      <code>\n        {lines.map((line, index) => (\n          <Fragment key={`${index}-${line}`}>\n            {highlightShellLine(line)}\n            {index < lines.length - 1 ? '\\n' : null}\n          </Fragment>\n        ))}\n      </code>\n    </pre>\n  );\n}\n\n/**\n * CodeSnippets - 代码片段展示组件\n */\nexport const CodeSnippets: React.FC<CodeSnippetsProps> = ({\n  scenarios,\n  request,\n  onGenerateCode,\n  isDark = false,\n  showScenarioSelector = true,\n}) => {\n  const { t } = useI18n();\n  const [selectedScenarioId, setSelectedScenarioId] = useState<string>(\n    scenarios[0]?.id ?? ''\n  );\n  const [generatedCode, setGeneratedCode] = useState<string>('');\n  const [isGenerating, setIsGenerating] = useState<boolean>(false);\n  const [copyStatus, setCopyStatus] = useState<'idle' | 'success' | 'error'>('idle');\n\n  // 用于处理异步竞态\n  const generationIdRef = useRef(0);\n\n  const selectedScenario = useMemo(\n    () => scenarios.find((s) => s.id === selectedScenarioId) ?? scenarios[0],\n    [scenarios, selectedScenarioId]\n  );\n\n  // 序列化 request 用于 useEffect 依赖比较\n  const requestKey = useMemo(() => {\n    try {\n      return JSON.stringify(request);\n    } catch {\n      return '';\n    }\n  }, [request]);\n\n  // 实时生成代码\n  useEffect(() => {\n    if (!selectedScenario || !onGenerateCode) {\n      setGeneratedCode('');\n      return;\n    }\n\n    const currentId = ++generationIdRef.current;\n    setIsGenerating(true);\n\n    const codeGenRequest: CodeGenRequest = {\n      scenarioId: selectedScenario.id,\n      request,\n    };\n\n    try {\n      const result = onGenerateCode(codeGenRequest);\n\n      if (result instanceof Promise) {\n        result\n          .then((code) => {\n            if (generationIdRef.current === currentId) {\n              setGeneratedCode(code);\n              setIsGenerating(false);\n            }\n          })\n          .catch((error) => {\n            if (generationIdRef.current === currentId) {\n              console.error('代码生成失败:', error);\n              setGeneratedCode('// 代码生成失败');\n              setIsGenerating(false);\n            }\n          });\n      } else {\n        if (generationIdRef.current === currentId) {\n          setGeneratedCode(result);\n          setIsGenerating(false);\n        }\n      }\n    } catch (error) {\n      if (generationIdRef.current === currentId) {\n        console.error('代码生成失败:', error);\n        setGeneratedCode('// 代码生成失败');\n        setIsGenerating(false);\n      }\n    }\n  }, [selectedScenario, requestKey, onGenerateCode]);\n\n  // 场景变化时同步选中状态\n  useEffect(() => {\n    if (scenarios.length > 0 && !scenarios.find((s) => s.id === selectedScenarioId)) {\n      setSelectedScenarioId(scenarios[0].id);\n    }\n  }, [scenarios, selectedScenarioId]);\n\n  const handleCopy = useCallback(async () => {\n    try {\n      await navigator.clipboard.writeText(generatedCode);\n      setCopyStatus('success');\n      setTimeout(() => setCopyStatus('idle'), 3000);\n    } catch {\n      setCopyStatus('error');\n      setTimeout(() => setCopyStatus('idle'), 3000);\n    }\n  }, [generatedCode]);\n\n  if (scenarios.length === 0) {\n    return (\n      <div\n        className=\"text-sm text-muted-foreground text-center py-8\"\n        role=\"status\"\n      >\n        {t('noCodeScenarios')}\n      </div>\n    );\n  }\n\n  const lineCount = Math.max(1, generatedCode.split('\\n').length);\n  const editorHeight = Math.min(320, Math.max(112, lineCount * 20 + 36));\n\n  return (\n    <div data-testid=\"code-snippets\" aria-label={t('codeSnippets')}>\n      {/* 顶部工具栏 */}\n      <div\n        className={`mb-2 flex items-center ${\n          showScenarioSelector ? 'justify-between' : 'justify-end'\n        }`}\n      >\n        {showScenarioSelector && (\n          <Select\n            value={selectedScenarioId}\n            onValueChange={setSelectedScenarioId}\n          >\n            <SelectTrigger\n              className=\"w-[180px]\"\n              aria-label={t('selectCodeScenario')}\n            >\n              <SelectValue placeholder=\"选择场景\" />\n            </SelectTrigger>\n            <SelectContent>\n              {scenarios.map((scenario) => (\n                <SelectItem key={scenario.id} value={scenario.id}>\n                  {scenario.label}\n                </SelectItem>\n              ))}\n            </SelectContent>\n          </Select>\n        )}\n\n        <div className=\"flex items-center gap-2\">\n          {copyStatus === 'success' && (\n            <span className=\"text-sm text-green-600 dark:text-green-400\">\n              {t('copied')}\n            </span>\n          )}\n          {copyStatus === 'error' && (\n            <span className=\"text-sm text-red-600 dark:text-red-400\">\n              {t('copyFailed')}\n            </span>\n          )}\n          <Button\n            variant=\"outline\"\n            size=\"sm\"\n            onClick={handleCopy}\n            disabled={!generatedCode || isGenerating}\n            aria-label={t('copyCode')}\n          >\n            {t('copyCode')}\n          </Button>\n        </div>\n      </div>\n\n      {/* 代码展示区 */}\n      {isGenerating ? (\n        <div\n          className=\"flex items-center justify-center py-8 rounded-md border border-gray-200 dark:border-gray-700\"\n          role=\"status\"\n          aria-live=\"polite\"\n        >\n          <span className=\"text-sm text-muted-foreground\">{t('generatingCode')}</span>\n        </div>\n      ) : (\n        <div className=\"overflow-hidden rounded-md border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-950\">\n          <div\n            className={isDark ? 'bg-[#1e1e1e] px-4' : 'bg-white px-4'}\n            data-testid=\"code-snippets-editor-padding\"\n          >\n            {isShellLanguage(selectedScenario?.language) ? (\n              <HighlightedShellCode\n                code={generatedCode}\n                height={editorHeight}\n                label={`${selectedScenario.label} ${t('codeSnippets')}`}\n              />\n            ) : (\n              <MonacoEditorWrapper\n                value={generatedCode}\n                onChange={() => {}}\n                isDark={isDark}\n                height={editorHeight}\n                readOnly={true}\n                language={selectedScenario?.language ?? 'plaintext'}\n                options={{\n                  readOnly: true,\n                  domReadOnly: true,\n                  minimap: { enabled: false },\n                  lineNumbers: 'off',\n                  lineDecorationsWidth: 0,\n                  lineNumbersMinChars: 0,\n                  folding: false,\n                  glyphMargin: false,\n                  renderLineHighlight: 'none',\n                  overviewRulerLanes: 0,\n                  hideCursorInOverviewRuler: true,\n                  contextmenu: false,\n                  wordWrap: 'on',\n                  padding: { top: 16, bottom: 16 },\n                  scrollbar: {\n                    vertical: 'auto',\n                    horizontal: 'auto',\n                    alwaysConsumeMouseWheel: false,\n                    useShadows: false,\n                  },\n                }}\n              />\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nCodeSnippets.displayName = 'CodeSnippets';\n"],"names":["buttonVariants","cva","Button","React","className","variant","size","asChild","props","ref","jsx","Slot","cn","Checkbox","CheckboxPrimitive","Check","labelVariants","Label","LabelPrimitive","defaultCodeFontFamily","getMonacoTheme","isDark","defaultMonacoOptions","readOnlyMonacoOptions","monacoLoaderConfig","loader","MonacoEditorWrapper","value","onChange","height","readOnly","language","options","onLoadError","onMount","loadFailed","setLoadFailed","useState","handleEditorChange","useCallback","newValue","handleMount","editor","monaco","error","jsxs","e","editorOptions","Editor","Select","SelectPrimitive","SelectGroup","SelectValue","SelectTrigger","children","ChevronDown","SelectContent","position","SelectLabel","SelectItem","SelectSeparator","Tabs","TabsPrimitive","TabsList","TabsTr