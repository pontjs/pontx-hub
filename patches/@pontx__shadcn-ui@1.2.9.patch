on validateParameter(\n  value: string,\n  schema: JSONSchema,\n  required: boolean\n): string | null {\n  // Check if required and empty\n  if (required && (!value || value.trim() === '')) {\n    return 'This field is required';\n  }\n\n  // If not required and empty, skip validation\n  if (!required && (!value || value.trim() === '')) {\n    return null;\n  }\n\n  // Type-specific validation\n  switch (schema.type) {\n    case 'string':\n      return validateString(value, schema);\n    case 'number':\n    case 'integer':\n      return validateNumber(value, schema);\n    case 'boolean':\n      return validateBoolean(value);\n    case 'array':\n      // Array is represented as comma-separated values in query params\n      // No special validation needed at this level\n      return null;\n    default:\n      return null;\n  }\n}\n\n// ==================== Type-Specific Validators ====================\n\n/**\n * Validate string parameter against schema constraints\n * @param value - String value to validate\n * @param schema - JSON Schema with string constraints\n * @returns Error message if invalid, null if valid\n */\nfunction validateString(value: string, schema: JSONSchema): string | null {\n  // Format validation\n  if (schema.format) {\n    switch (schema.format) {\n      case 'email':\n        if (!isValidEmail(value)) {\n          return 'Must be a valid email address';\n        }\n        break;\n      case 'uri':\n      case 'url':\n        if (!isValidUrl(value)) {\n          return 'Must be a valid URL';\n        }\n        break;\n    }\n  }\n\n  // Pattern validation\n  if (schema.pattern && !matchesPattern(value, schema.pattern)) {\n    return 'Does not match required format';\n  }\n\n  // Length validation\n  if (schema.minLength !== undefined && value.length < schema.minLength) {\n    return `Must be at least ${schema.minLength} characters`;\n  }\n\n  if (schema.maxLength !== undefined && value.length > schema.maxLength) {\n    return `Must be at most ${schema.maxLength} characters`;\n  }\n\n  return null;\n}\n\n/**\n * Validate number parameter against schema constraints\n * @param value - String representation of number\n * @param schema - JSON Schema with number constraints\n * @returns Error message if invalid, null if valid\n */\nfunction validateNumber(value: string, schema: JSONSchema): string | null {\n  const num = Number(value);\n\n  if (isNaN(num)) {\n    return 'Must be a valid number';\n  }\n\n  if (schema.type === 'integer' && !Number.isInteger(num)) {\n    return 'Must be a valid integer';\n  }\n\n  if (schema.minimum !== undefined && num < schema.minimum) {\n    return `Must be at least ${schema.minimum}`;\n  }\n\n  if (schema.maximum !== undefined && num > schema.maximum) {\n    return `Must be at most ${schema.maximum}`;\n  }\n\n  return null;\n}\n\n/**\n * Validate boolean parameter\n * @param value - String representation of boolean ('true' or 'false')\n * @returns Error message if invalid, null if valid\n */\nfunction validateBoolean(value: string): string | null {\n  const normalizedValue = value.toLowerCase();\n  if (normalizedValue !== 'true' && normalizedValue !== 'false') {\n    return 'Must be true or false';\n  }\n  return null;\n}\n\n/**\n * Validate all required parameters and return structured errors\n *\n * This function validates an entire set of parameters against their schemas.\n * It's typically used before submitting an API request to ensure all required\n * fields are filled and valid.\n *\n * @param values - Object containing parameter values (key: parameter name, value: parameter value)\n * @param parameters - Array of parameter definitions from API spec\n * @returns Array of validation errors (empty if all valid)\n *\n * @example\n * ```typescript\n * const errors = validateRequiredParameters(\n *   { id: '123', email: 'invalid' },\n *   [\n *     { name: 'id', in: 'path', required: true, schema: { type: 'string' } },\n *     { name: 'email', in: 'query', required: true, schema: { type: 'string', format: 'email' } }\n *   ]\n * );\n * // Returns: [{ field: 'email', message: 'Must be a valid email address', type: 'format' }]\n * ```\n */\nexport function validateRequiredParameters(\n  values: Record<string, string>,\n  parameters: Parameter[]\n): ValidationError[] {\n  const errors: ValidationError[] = [];\n\n  for (const param of parameters) {\n    const value = values[param.name] || '';\n    const isRequired = param.required ?? false;\n\n    // Check if required parameter is missing\n    if (isRequired && (!value || value.trim() === '')) {\n      errors.push({\n        field: param.name,\n        message: 'This field is required',\n        type: 'required',\n      });\n      continue;\n    }\n\n    // Skip validation for empty non-required parameters\n    if (!isRequired && (!value || value.trim() === '')) {\n      continue;\n    }\n\n    // Validate parameter value\n    const error = validateParameter(value, param.schema, isRequired);\n    if (error) {\n      errors.push({\n        field: param.name,\n        message: error,\n        type: getErrorType(error),\n      });\n    }\n  }\n\n  return errors;\n}\n\n/**\n * Determine error type from error message for UI categorization\n * @param message - Validation error message\n * @returns Error type category\n */\nfunction getErrorType(message: string): ValidationError['type'] {\n  if (message.includes('required')) return 'required';\n  if (message.includes('number') || message.includes('boolean')) return 'type';\n  if (message.includes('email') || message.includes('URL')) return 'format';\n  if (message.includes('format')) return 'pattern';\n  return 'custom';\n}\n\n/**\n * Validate JSON string syntax\n *\n * This function checks if a string contains valid JSON.\n * Used for validating request body input in Monaco Editor.\n *\n * @param json - The JSON string to validate\n * @returns Error message if invalid, null if valid\n *\n * @example\n * ```typescript\n * const error = validateJSON('{\"name\": \"test\"}');\n * // Returns: null (valid JSON)\n *\n * const error2 = validateJSON('{name: \"test\"}');\n * // Returns: \"Invalid JSON: ...\" (missing quotes)\n * ```\n */\nexport function validateJSON(json: string): string | null {\n  // Check for empty or whitespace-only string\n  if (!json || json.trim() === '') {\n    return 'Invalid JSON: empty string';\n  }\n\n  try {\n    JSON.parse(json);\n    return null;\n  } catch (error) {\n    if (error instanceof SyntaxError) {\n      return `Invalid JSON: ${error.message}`;\n    }\n    return 'Invalid JSON syntax';\n  }\n}\n","type CalendarPart = \"year\" | \"month\" | \"day\" | \"hour\" | \"minute\" | \"second\";\ntype TemplatePart = CalendarPart | \"hour12\" | \"fraction\" | \"meridiem\" | \"timezone\";\ntype TimezoneStyle = \"flexible\" | \"hour\" | \"compact\" | \"colon\";\n\ninterface DateFormatToken {\n  value: string;\n  part: TemplatePart;\n  minDigits?: number;\n  maxDigits?: number;\n  timezoneStyle?: TimezoneStyle;\n}\n\ninterface DateFormatSegment {\n  literal?: string;\n  token?: DateFormatToken;\n}\n\ninterface ParsedTemplateFormat {\n  kind: \"template\";\n  segments: DateFormatSegment[];\n  matcher: RegExp;\n  captureParts: TemplatePart[];\n  inputType: TemporalInputType;\n  fractionDigits: number;\n}\n\ntype TimestampUnit = \"seconds\" | \"milliseconds\" | \"microseconds\" | \"nanoseconds\";\n\ninterface ParsedTimestampFormat {\n  kind: \"timestamp\";\n  unit: TimestampUnit | \"auto\";\n}\n\ninterface ParsedIsoFormat {\n  kind: \"iso\";\n  inputType: \"time\" | \"datetime-local\";\n  timezone: \"required\" | \"optional\" | \"none\";\n  strictSeconds: boolean;\n}\n\ntype ParsedTemporalFormat = ParsedTemplateFormat | ParsedTimestampFormat | ParsedIsoFormat;\n\ninterface CalendarDateTime {\n  year: number;\n  month: number;\n  day: number;\n  hour: number;\n  minute: number;\n  second: number;\n  /** 小数秒，最多保留纳秒精度。 */\n  fraction: string;\n  timezone?: string;\n  dateTimeSeparator?: string;\n}\n\ninterface ParsedTimestampValue {\n  date: CalendarDateTime;\n  epochNanoseconds: bigint;\n  unit: TimestampUnit;\n}\n\nexport type TemporalInputType = \"date\" | \"month\" | \"time\" | \"datetime-local\";\n\nconst DATE_FORMAT_TOKENS: DateFormatToken[] = [\n  { value: \"yyyy\", part: \"year\", minDigits: 4, maxDigits: 4 },\n  { value: \"YYYY\", part: \"year\", minDigits: 4, maxDigits: 4 },\n  { value: \"uuuu\", part: \"year\", minDigits: 4, maxDigits: 4 },\n  { value: \"MM\", part: \"month\", minDigits: 2, maxDigits: 2 },\n  { value: \"dd\", part: \"day\", minDigits: 2, maxDigits: 2 },\n  { value: \"DD\", part: \"day\", minDigits: 2, maxDigits: 2 },\n  { value: \"HH\", part: \"hour\", minDigits: 2, maxDigits: 2 },\n  { value: \"hh\", part: \"hour12\", minDigits: 2, maxDigits: 2 },\n  { value: \"mm\", part: \"minute\", minDigits: 2, maxDigits: 2 },\n  { value: \"ss\", part: \"second\", minDigits: 2, maxDigits: 2 },\n  { value: \"M\", part: \"month\", minDigits: 1, maxDigits: 2 },\n  { value: \"d\", part: \"day\", minDigits: 1, maxDigits: 2 },\n  { value: \"D\", part: \"day\", minDigits: 1, maxDigits: 2 },\n  { value: \"H\", part: \"hour\", minDigits: 1, maxDigits: 2 },\n  { value: \"h\", part: \"hour12\", minDigits: 1, maxDigits: 2 },\n  { value: \"m\", part: \"minute\", minDigits: 1, maxDigits: 2 },\n  { value: \"s\", part: \"second\", minDigits: 1, maxDigits: 2 },\n  { value: \"A\", part: \"meridiem\" },\n  { value: \"a\", part: \"meridiem\" },\n];\n\nconst TIMEZONE_FORMAT_TOKENS: DateFormatToken[] = [\n  { value: \"XXX\", part: \"timezone\", timezoneStyle: \"colon\" },\n  { value: \"xxx\", part: \"timezone\", timezoneStyle: \"colon\" },\n  { value: \"XX\", part: \"timezone\", timezoneStyle: \"compact\" },\n  { value: \"xx\", part: \"timezone\", timezoneStyle: \"compact\" },\n  { value: \"ZZ\", part: \"timezone\", timezoneStyle: \"compact\" },\n  { value: \"X\", part: \"timezone\", timezoneStyle: \"hour\" },\n  { value: \"x\", part: \"timezone\", timezoneSt