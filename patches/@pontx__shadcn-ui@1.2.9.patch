+{"version":3,"file":"ApiDocumentation-MYMgFrkM.js","sources":["../src/api-documentation/ApiDocumentation.tsx"],"sourcesContent":["/* eslint-disable @typescript-eslint/no-explicit-any */\nimport React, { useEffect, useState, useCallback } from \"react\";\nimport { SchemaViewer } from \"@/schema-viewer/SchemaViewer\";\nimport { Card, CardContent, CardHeader, CardTitle } from \"@/components/ui/card\";\nimport { Badge } from \"@/components/ui/badge\";\nimport { Button } from \"@/components/ui/button\";\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from \"@/components/ui/tabs\";\nimport { injectStyles } from \"@stoplight/mosaic\";\nimport { SchemaProvider } from \"@/contexts/SchemaContext\";\nimport { PlaygroundPanel } from \"@/playground/PlaygroundPanel\";\nimport type { ApiDocumentationProps } from \"@/types/playground\";\nimport { I18nProvider, useI18n } from \"@/contexts/I18nContext\";\n\nconst getMethodColor = (method: string) => {\n  switch (method.toLowerCase()) {\n    case \"get\":\n      return \"bg-green-100 text-green-800 border-green-200\";\n    case \"post\":\n      return \"bg-blue-100 text-blue-800 border-blue-200\";\n    case \"put\":\n      return \"bg-yellow-100 text-yellow-800 border-yellow-200\";\n    case \"delete\":\n      return \"bg-red-100 text-red-800 border-red-200\";\n    case \"patch\":\n      return \"bg-purple-100 text-purple-800 border-purple-200\";\n    case \"options\":\n      return \"bg-gray-100 text-gray-800 border-gray-200\";\n    case \"head\":\n      return \"bg-gray-100 text-gray-800 border-gray-200\";\n    default:\n      return \"bg-gray-100 text-gray-800 border-gray-200\";\n  }\n};\n\nconst LocalizedApiDocumentation: React.FC<ApiDocumentationProps> = ({\n  api,\n  className = \"\",\n  enablePlayground = false,\n  defaultPlaygroundVisible = false,\n  specName,\n  servers,\n  onExecute,\n  onOAuthAuthorize,\n  onOAuthClear,\n  oauthState,\n  oauthAccessToken,\n  oauthRequiredScopes,\n  executionResult,\n  isExecuting = false,\n  onValidationError,\n  onPlaygroundStateChange,\n  getCodeGenScenarios,\n  onGenerateCode,\n}) => {\n  const { t } = useI18n();\n  // Panel visibility state\n  const [isPanelVisible, setIsPanelVisible] = useState(defaultPlaygroundVisible);\n\n  // 同步外部 defaultPlaygroundVisible 变化\n  useEffect(() => {\n    setIsPanelVisible(defaultPlaygroundVisible);\n  }, [defaultPlaygroundVisible]);\n\n  useEffect(() => {\n    injectStyles();\n  }, []);\n\n  // Warn if enablePlayground is true but onExecute is not provided\n  useEffect(() => {\n    if (enablePlayground && !onExecute) {\n      console.warn(\n        'ApiDocumentation: enablePlayground is true but onExecute callback is not provided. The \"Try\" button will be disabled.'\n      );\n    }\n  }, [enablePlayground, onExecute]);\n\n  // Call onPlaygroundStateChange when panel visibility changes\n  useEffect(() => {\n    if (onPlaygroundStateChange) {\n      onPlaygroundStateChange({ isOpen: isPanelVisible });\n    }\n  }, [isPanelVisible, onPlaygroundStateChange]);\n\n  // Determine if Try button should be enabled\n  const isTryButtonDisabled = !onExecute;\n\n  // Toggle panel visibility\n  const handleTogglePanel = useCallback(() => {\n    if (!isTryButtonDisabled) {\n      setIsPanelVisible(prev => !prev);\n    }\n  }, [isTryButtonDisabled]);\n\n  // Handle panel visibility change from PlaygroundPanel\n  const handlePanelVisibleChange = useCallback((visible: boolean) => {\n    setIsPanelVisible(visible);\n  }, []);\n\n  return (\n    <SchemaProvider components={api.components}>\n      <div\n        className={isPanelVisible ? `flex h-full ${className}` : `h-full overflow-y-auto ${className}`}\n        data-testid=\"api-documentation-layout\"\n      >\n        {/* Left side: API Documentation */}\n        <div className={isPanelVisible ? 'flex-1 overflow-y-auto space-y-4 pr-6' : 'space-y-4'}>\n        {/* API 头部信息 */}\n        <Card>\n          <CardHeader>\n            <CardTitle className=\"text-2xl\">\n              {api.title || api.name || t(\"apiDocumentation\")}\n            </CardTitle>\n            {api.description && (\n              <p className=\"text-muted-foreground mt-2\">{api.description}</p>\n            )}\n            {api.summary && (\n              <p className=\"text-muted-foreground text-sm mt-1\">\n                {api.summary}\n              </p>\n            )}\n          </CardHeader>\n        </Card>\n\n        {/* API 端点详情 */}\n        <Card>\n          <CardHeader>\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <Badge\n                  className={`font-mono text-xs ${getMethodColor(\n                    api.method || \"\"\n                  )}`}\n                >\n                  {api.method || \"\"}\n                </Badge>\n                <code className=\"text-sm bg-muted px-2 py-1 rounded\">\n                  {api.path}\n                </code>\n                {api.deprecated && (\n                  <Badge variant=\"destructive\" className=\"text-xs\">\n                    {t(\"deprecated\")}\n                  </Badge>\n                )}\n              </div>\n              {enablePlayground && (\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  disabled={isTryButtonDisabled}\n                  onClick={handleTogglePanel}\n                  title={!onExecute ? t(\"executeUnavailable\") : t(\"tryApi\")}\n                >\n                  {t(\"try\")}\n                </Button>\n              )}\n            </div>\n            {api.description && (\n              <p className=\"text-muted-foreground text-sm mt-2\">\n                {api.description}\n              </p>\n            )}\n            {api.tags && api.tags.length > 0 && (\n              <div className=\"flex gap-2 mt-2\">\n                {api.tags.map((tag, index) => (\n                  <Badge key={index} variant=\"secondary\" className=\"text-xs\">\n                    {tag}\n                  </Badge>\n                ))}\n              </div>\n            )}\n          </CardHeader>\n          <CardContent className=\"space-y-4\">\n            {/* 参数 */}\n            {api.parameters && api.parameters.length > 0 && (\n              <div>\n                <h4 className=\"font-semibold text-sm mb-2\">{t(\"parameters\")}</h4>\n                <div className=\"space-y-3\">\n                  {(() => {\n                    // 按参数位置分组\n                    const groupedParams = api.parameters.reduce(\n                      (acc, param) => {\n                        if (!acc[param.in]) {\n                          acc[param.in] = [];\n                        }\n                        acc[param.in].push(param);\n                        return acc;\n                      },\n                      {} as Record<string, typeof api.parameters>\n                    );\n\n                    return Object.entries(groupedParams).map(\n                      ([paramType, params]) => {\n                        if (paramType === \"body\" && params.length === 1) {\n                          const bodyParam = params[0];\n                          const fieldCount = Object.keys(\n                            bodyParam.schema?.properties ?? {}\n                          ).length;\n\n                          return (\n                            <div key={paramType} className=\"border rounded p-3\">\n                              <div className=\"flex items-start justify-between gap-3 mb-3\">\n                                <div>\n                                  <div className=\"flex items-center gap-2\">\n                                    <h5 className=\"text-sm font-semibold\">\n                                      {t(\"bodyParameters\")}\n                                    </h5>\n                                    {bodyParam.required && (\n                                      <Badge\n                                        variant=\"destructive\"\n                                        className=\"text-xs\"\n                                      >\n                                        {t(\"required\")}\n                                      </Badge>\n                                    )}\n                                  </div>\n                                  {fieldCount > 0 && (\n                                    <p className=\"mt-1 text-xs text-muted-foreground\">\n                                      {fieldCount} {t(\"fields\")}\n                                    </p>\n                                  )}\n                                </div>\n                              </div>\n                              <SchemaViewer\n                                schema={bodyParam.schema}\n                                expanded={false}\n                                hideHeader\n                                hideTopBar\n                                defaultExpandedDepth={1}\n                                className=\"border-0 rounded-none shadow-none\"\n                                contentClassName=\"p-0\"\n                              />\n                            </div>\n                          );\n                        }\n\n                        // 对于 query 和 path 参数，如果都是同类型，合并成一个 Schema\n                        if (\n                          (paramType === \"query\" || paramType === \"path\") &&\n                          params.length >= 1\n                        ) {\n                          const mergedSchema = {\n                            type: \"object\",\n                            properties: params.reduce((acc, param) => {\n                              acc[param.name] = {\n                                ...param.schema,\n                                description:\n                                  param.schema.description ||\n                                  `${param.name} ${t(\"parameter\")}`,\n                              };\n                              return acc;\n                            }, {} as Record<string, any>),\n                            required: params\n                              .filter((p) => p.required || p.schema?.required)\n                              .map((p) => p.name),\n                          };\n\n                          return (\n                            <SchemaViewer\n                              key={paramType}\n                              schema={mergedSchema}\n                              expanded={false}\n                              className=\"rounded shadow-none\"\n                              defaultExpandedDepth={1}\n                              name={`${paramType} ${t(\"parameters\")}`}\n                            />\n                          );\n                        }\n\n                        // 其他情况或单个参数，使用原来的显示方式\n                        return (\n                          <div key={paramType} className=\"border rounded p-3\">\n                            <div className=\"flex items-center gap-2 mb-3\">\n                              <Badge variant=\"outline\" className=\"text-xs\">\n                                {paramType}\n                              </Badge>\n                              <span className=\"text-sm font-medium\">\n                                {params.length} {t(\"parameters\")}\n                              </span>\n                            </div>\n                            <div className=\"space-y-2\">\n                              {params.map((param, index) => (\n                                <div\n                                  key={index}\n                                  className=\"border-l-2 border-muted pl-3\"\n                                >\n                                  <div className=\"flex items-center gap-2 mb-1\">\n                                    <code className=\"text-sm font-mono\">\n                                      {param.name}\n                                    </code>\n                                    {param.required && (\n                                      <Badge\n                                        variant=\"destructive\"\n                                        className=\"text-xs\"\n                                      >\n                                        {t(\"required\")}\n                                      </Badge>\n                                    )}\n                                  </div>\n                                  <SchemaViewer\n                                    name={`${param.name} ${t(\"parameter\")}`}\n                                    schema={param.schema}\n                                    expanded={false}\n                                    defaultExpandedDepth={1}\n                                    className=\"border-0 shadow-none\"\n                                  />\n                                </div>\n                              ))}\n                            </div>\n                          </div>\n                        );\n                      }\n                    );\n                  })()}\n                </div>\n              </div>\n            )}\n\n            {/* 响应 */}\n            {api.responses && Object.keys(api.responses).length > 0 && (\n              <div>\n                <h4 className=\"font-semibold text-sm mb-2\">{t(\"responses\")}</h4>\n                <Tabs\n                  defaultValue={Object.keys(api.responses)[0]}\n                  className=\"w-full\"\n                >\n                  <TabsList className=\"inline-flex h-auto w-auto justify-start\">\n                    {Object.entries(api.responses).map(([statusCode]) => (\n                      <TabsTrigger\n                        key={statusCode}\n                        value={statusCode}\n                        className=\"flex items-center gap-2\"\n                      >\n                        <Badge\n                          variant={\n                            statusCode === \"default\"\n                              ? \"secondary\"\n                              : statusCode.startsWith(\"2\")\n                              ? \"outline\"\n                              : statusCode.startsWith(\"3\")\n                              ? \"secondary\"\n                              : statusCode.startsWith(\"4\")\n                              ? \"destructive\"\n                              : statusCode.startsWith(\"5\")\n                              ? \"destructive\"\n                              : \"secondary\"\n                          }\n                          className={`text-xs h-5 px-1.5 ${\n                            statusCode.startsWith(\"2\")\n                              ? \"bg-green-100 text-green-800 border-green-200\"\n                              : \"\"\n                          }`}\n                        >\n                          {statusCode}\n                        </Badge>\n                      </TabsTrigger>\n                    ))}\n                  </TabsList>\n                  {Object.entries(api.responses).map(\n                    ([statusCode, response]) => (\n                      <TabsContent\n                        key={statusCode}\n                        value={statusCode}\n                        className=\"mt-3\"\n                      >\n                        <div className=\"border rounded p-3\">\n                          <div className=\"flex items-center gap-2 mb-3\">\n                            <Badge\n                              variant={\n                                statusCode === \"default\"\n                                  ? \"secondary\"\n                                  : statusCode.startsWith(\"2\")\n                                  ? \"outline\"\n                                  : statusCode.startsWith(\"3\")\n                                  ? \"secondary\"\n             