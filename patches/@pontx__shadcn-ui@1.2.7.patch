+{"version":3,"file":"PlaygroundPanel-B-8aUZVz.js","sources":["../src/lib/storage.ts","../src/playground/UrlConfiguration.tsx","../src/playground/AuthConfiguration.tsx","../src/playground/ParametersForm.tsx","../src/playground/PlaygroundPanel.tsx"],"sourcesContent":["/**\n * Storage utilities for API Playground\n * Provides localStorage-based persistence with error handling and memory fallback\n */\n\n// Type definitions\nexport interface PlaygroundConfig {\n  url: string;\n  auth?: AuthData;\n  pathParams: Record<string, string>;\n  queryParams: Record<string, string>;\n  headerParams: Record<string, string>;\n  requestBody?: string;\n  timestamp: number;\n}\n\nexport type AuthData =\n  | { type: 'apiKey'; name: string; value: string; in: string }\n  | { type: 'bearer'; token: string }\n  | { type: 'basic'; username: string; password: string }\n  | { type: 'oauth2'; token: string };\n\n// Memory fallback storage when localStorage is unavailable\nconst memoryStorage = new Map<string, string>();\n\n// Track if localStorage is available\nlet isLocalStorageAvailable: boolean | null = null;\n\n// Debounce timers\nconst debounceTimers = new Map<string, ReturnType<typeof setTimeout>>();\n\n/**\n * Check if localStorage is available\n */\nfunction checkLocalStorageAvailability(): boolean {\n  if (isLocalStorageAvailable !== null) {\n    return isLocalStorageAvailable;\n  }\n\n  try {\n    const testKey = '__storage_test__';\n    localStorage.setItem(testKey, 'test');\n    localStorage.removeItem(testKey);\n    isLocalStorageAvailable = true;\n    return true;\n  } catch (error) {\n    console.warn('localStorage is not available, using memory fallback');\n    isLocalStorageAvailable = false;\n    return false;\n  }\n}\n\n/**\n * Safe JSON stringify that handles circular references\n */\nfunction safeStringify(obj: unknown): string | null {\n  try {\n    return JSON.stringify(obj);\n  } catch (error) {\n    if (error instanceof TypeError && error.message.includes('circular')) {\n      console.warn('Cannot stringify object with circular references');\n      return null;\n    }\n    console.warn('Failed to stringify object:', error);\n    return null;\n  }\n}\n\n/**\n * Safe JSON parse with error handling\n */\nfunction safeParse<T>(json: string): T | null {\n  try {\n    return JSON.parse(json) as T;\n  } catch (error) {\n    console.warn('Failed to parse JSON from storage:', error);\n    return null;\n  }\n}\n\n/**\n * Get item from storage (localStorage or memory fallback)\n */\nfunction getItem(key: string): string | null {\n  if (checkLocalStorageAvailability()) {\n    try {\n      return localStorage.getItem(key);\n    } catch (error) {\n      console.warn('Failed to read from localStorage:', error);\n      return memoryStorage.get(key) || null;\n    }\n  }\n  return memoryStorage.get(key) || null;\n}\n\n/**\n * Set item in storage (localStorage or memory fallback)\n */\nfunction setItem(key: string, value: string): void {\n  if (checkLocalStorageAvailability()) {\n    try {\n      localStorage.setItem(key, value);\n      return;\n    } catch (error) {\n      // Handle QuotaExceededError\n      if (error instanceof DOMException && error.name === 'QuotaExceededError') {\n        console.warn('localStorage quota exceeded, falling back to memory storage');\n      } else {\n        console.warn('Failed to write to localStorage:', error);\n      }\n    }\n  }\n  // Fallback to memory storage\n  memoryStorage.set(key, value);\n}\n\n/**\n * Remove item from storage\n */\nfunction removeItem(key: string): void {\n  if (checkLocalStorageAvailability()) {\n    try {\n      localStorage.removeItem(key);\n    } catch (error) {\n      console.warn('Failed to remove from localStorage:', error);\n    }\n  }\n  memoryStorage.delete(key);\n}\n\n/**\n * Simple base64 encoding for auth data\n * Note: This is NOT secure encryption, just obfuscation\n */\nfunction encodeAuthData(data: string): string {\n  return btoa(data);\n}\n\n/**\n * Simple base64 decoding for auth data\n */\nfunction decodeAuthData(encoded: string): string {\n  try {\n    return atob(encoded);\n  } catch (error) {\n    console.warn('Failed to decode auth data:', error);\n    return '';\n  }\n}\n\n/**\n * Generate storage key for playground config\n */\nfunction getConfigKey(apiPath: string, apiMethod: string): string {\n  return `playground:${apiMethod}:${apiPath}:params`;\n}\n\n/**\n * Generate storage key for custom URL\n */\nfunction getCustomUrlKey(apiPath: string): string {\n  return `playground:${apiPath}:customUrl`;\n}\n\n/**\n * Generate storage key for spec base URL\n */\nfunction getSpecBaseUrlKey(specName: string): string {\n  return `playground:spec:${specName}:baseUrl`;\n}\n\n/**\n * Generate storage key for auth config\n */\nfunction getAuthKey(schemeName: string): string {\n  return `playground:auth:${schemeName}`;\n}\n\n/**\n * Debounced save function\n */\nfunction debouncedSave(key: string, value: string, delay: number = 500): void {\n  // Clear existing timer\n  const existingTimer = debounceTimers.get(key);\n  if (existingTimer) {\n    clearTimeout(existingTimer);\n  }\n\n  // Set new timer\n  const timer = setTimeout(() => {\n    setItem(key, value);\n    debounceTimers.delete(key);\n  }, delay);\n\n  debounceTimers.set(key, timer);\n}\n\n/**\n * Immediate save function (for non-debounced operations)\n */\nfunction immediateSave(key: string, value: string): void {\n  setItem(key, value);\n}\n\n/**\n * Save playground configuration\n */\nexport function savePlaygroundConfig(\n  apiPath: string,\n  apiMethod: string,\n  config: PlaygroundConfig\n): void {\n  const key = getConfigKey(apiPath, apiMethod);\n  const json = safeStringify(config);\n\n  if (json === null) {\n    console.warn('Failed to save playground config: invalid data');\n    return;\n  }\n\n  debouncedSave(key, json);\n}\n\n/**\n * Load playground configuration\n */\nexport function loadPlaygroundConfig(\n  apiPath: string,\n  apiMethod: string\n): PlaygroundConfig | null {\n  const key = getConfigKey(apiPath, apiMethod);\n  const json = getItem(key);\n\n  if (!json) {\n    return null;\n  }\n\n  return safeParse<PlaygroundConfig>(json);\n}\n\n/**\n * Save custom URL\n */\nexport function saveCustomUrl(apiPath: string, url: string): void {\n  const key = getCustomUrlKey(apiPath);\n  immediateSave(key, url);\n}\n\n/**\n * Load custom URL\n */\nexport function loadCustomUrl(apiPath: string): string | null {\n  const key = getCustomUrlKey(apiPath);\n  return getItem(key);\n}\n\n/**\n * Save spec base URL (shared across all APIs in the same spec)\n */\nexport function saveSpecBaseUrl(specName: string, url: string): void {\n  const key = getSpecBaseUrlKey(specName);\n  immediateSave(key, url);\n}\n\n/**\n * Load spec base URL\n */\nexport function loadSpecBaseUrl(specName: string): string | null {\n  const key = getSpecBaseUrlKey(specName);\n  return getItem(key);\n}\n\n/**\n * Save auth configuration\n */\nexport function saveAuthConfig(schemeName: string, auth: AuthData): void {\n  const key = getAuthKey(schemeName);\n  const json = safeStringify(auth);\n\n  if (json === null) {\n    console.warn('Failed to save auth config: invalid data');\n    return;\n  }\n\n  // Encode the auth data for basic obfuscation\n  const encoded = encodeAuthData(json);\n  immediateSave(key, encoded);\n}\n\n/**\n * Load auth configuration\n */\nexport function loadAuthConfig(schemeName: string): AuthData | null {\n  const key = getAuthKey(schemeName);\n  const encoded = getItem(key);\n\n  if (!encoded) {\n    return null;\n  }\n\n  const json = decodeAuthData(encoded);\n  if (!json) {\n    return null;\n  }\n\n  return safeParse<AuthData>(json);\n}\n\n/**\n * Clear playground configuration for a specific API\n */\nexport function clearPlaygroundConfig(apiPath: string, apiMethod: string): void {\n  const key = getConfigKey(apiPath, apiMethod);\n  removeItem(key);\n}\n","import React, { useEffect, useMemo, useState } from 'react';\nimport { Input } from '@/components/ui/input';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { Label } from '@/components/ui/label';\nimport { loadSpecBaseUrl, saveSpecBaseUrl } from '@/lib/storage';\nimport { useI18n } from '@/contexts/I18nContext';\n\n/**\n * Server definition from API specification\n */\nexport interface Server {\n  url: string;\n  description?: string;\n  variables?: Record<string, {\n    default: string;\n    enum?: string[];\n  }>;\n}\n\n/**\n * Props for UrlConfiguration component\n */\nexport interface UrlConfigurationProps {\n  /** Spec name for localStorage key (shared across all APIs in the same spec) */\n  specName: string;\n\n  /** API servers from specification */\n  servers?: Server[];\n\n  /** Current URL value */\n  value: string;\n\n  /** Callback when URL changes */\n  onChange: (url: string) => void;\n\n  /** API path (for display) */\n  apiPath: string;\n}\n\nconst CUSTOM_URL_VALUE = '__custom__';\n\n/**\n * Replace server URL variables with their default values\n */\nfunction replaceServerVariables(url: string, variables?: Record<string, { default: string }>): string {\n  if (!variables) {\n    return url;\n  }\n\n  let processedUrl = url;\n\n  for (const [key, config] of Object.entries(variables)) {\n    const placeholder = `{${key}}`;\n    processedUrl = processedUrl.replace(placeholder, config.default);\n  }\n\n  return processedUrl;\n}\n\n/**\n * UrlConfiguration component for environment URL selection and custom input\n */\nexport const UrlConfiguration: React.FC<UrlConfigurationProps> = ({\n  specName,\n  servers,\n  value,\n  onChange,\n  apiPath,\n}) => {\n  const { locale, t } = useI18n();\n  // Track whether user is using custom URL\n  const [isCustom, setIsCustom] = useState(false);\n  const [customUrl, setCustomUrl] = useState('');\n\n  // Process servers to replace variables with defaults\n  const processedServers = useMemo(() => {\n    return servers?.map(server => ({\n      ...server,\n      url: replaceServerVariables(server.url, server.variables),\n    })) || [];\n  }, [servers]);\n\n  // Load saved URL from localStorage on mount\n  useEffect(() => {\n    const savedUrl = loadSpecBaseUrl(specName);\n\n    if (savedUrl) {\n      // Check if saved URL matches any server\n      const matchingServer = processedServers.find(s => s.url === savedUrl);\n      if (matchingServer) {\n        setIsCustom(false);\n        onChange(savedUrl);\n      } else {\n        // It's a custom URL\n        setIsCustom(true);\n        setCustomUrl(savedUrl);\n        onChange(savedUrl);\n      }\n    } else if (processedServers.length > 0) {\n      // Default to first server\n      onChange(processedServers[0].url);\n      saveSpecBaseUrl(specName, processedServers[0].url);\n    }\n  }, [specName, processedServers]);\n\n  // Handle server selection change\n  const handleServerChange = (selectedValue: string) => {\n    if (selectedValue === CUSTOM_URL_VALUE) {\n      setIsCustom(true);\n      // Keep the current custom URL or use empty\n      const urlToUse = customUrl || '';\n      onChange(urlToUse);\n      if (urlToUse) {\n        saveSpecBaseUrl(specName, urlToUse);\n      }\n    } else {\n      setIsCustom(false);\n      onChange(selectedValue);\n      saveSpecBaseUrl(specName, selectedValue);\n    }\n  };\n\n  // Handle custom URL input change\n  const handleCustomUrlChange = (newUrl: string) => {\n    setCustomUrl(newUrl);\n    onChange(newUrl);\n    saveSpecBaseUrl(specName, newUrl);\n  };\n\n  // Get current select value\n  const selectValue = isCustom ? CUSTOM_URL_VALUE : value;\n\n  return (\n    <div className=\"space-y-3\">\n      <div className=\"space-y-2\">\n        <Label htmlFor=\"server-select\">Base URL</Label>\n        <Select value={selectValue} onValueChange={handleServerChange}>\n          <SelectTrigger id=\"server-select\">\n            <SelectValue placeholder={t('selectServer')} />\n          </SelectTrigger>\n          <SelectContent>\n            {processedServers.map((server) => (\n              <SelectItem key={server.url} value={server.url}>\n                <span className=\"flex items-center gap-2\">\n                  <span>{server.description || server.url}</span>\n                  {server.description && (\n                    <span className=\"text-xs text-muted-foreground\">\n                      {server.url}\n                    </span>\n                  )}\n                </span>\n              </SelectItem>\n            ))}\n            <SelectItem value={CUSTOM_URL_VALUE}>\n              <span className=\"text-muted-foreground\">{locale === 'zh-CN' ? '自定义 URL...' : 'Custom URL...'}</span>\n            </SelectItem>\n          </SelectContent>\n        </Select>\n      </div>\n\n      {/* Custom URL input (only when custom is selected) */}\n      {isCustom && (\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"custom-url-input\">{locale === 'zh-CN' ? '自定义 URL' : 'Custom URL'}</Label>\n          <Input\n            id=\"custom-url-input\"\n            type=\"text\"\n            placeholder=\"https://api.example.com\"\n            value={customUrl}\n            onChange={(e) => handleCustomUrlChange(e.target.value)}\n          />\n        </div>\n      )}\n\n      {/* Show full URL preview */}\n      <p className=\"text-xs text-muted-foreground font-mono truncate\" title={`${value}${apiPath}`}>\n        {value}{apiPath}\n      </p>\n    </div>\n  );\n};\n","import React, { useEffect, useMemo, useState } from 'react';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Button } from '@/components/ui/button';\nimport type {\n  AuthData,\n  OAuthAuthorizeInput,\n  OAuthAuthorizationState,\n  OAuthFlowName,\n} from '@/types/playground';\n\n/**\n * Security scheme type definitions based on OpenAPI Specification\n */\nexport type SecurityScheme =\n  | ApiKeySecurityScheme\n  | HttpSecurityScheme\n