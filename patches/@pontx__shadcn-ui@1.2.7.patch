alue}\n          onChange={(e) => {\n            onChange({\n              type: 'bearer',\n              token: e.target.value,\n            });\n          }}\n        />\n      </div>\n    );\n  };\n\n  const renderBasicAuthForm = () => {\n    const currentUsername =\n      value?.type === 'basic' ? value.username : '';\n    const currentPassword =\n      value?.type === 'basic' ? value.password : '';\n\n    return (\n      <div className=\"space-y-4\">\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"auth-basic-username\">Username</Label>\n          <Input\n            id=\"auth-basic-username\"\n            type=\"text\"\n            placeholder=\"Enter username\"\n            value={currentUsername}\n            onChange={(e) => {\n              onChange({\n                type: 'basic',\n                username: e.target.value,\n                password: currentPassword,\n              });\n            }}\n          />\n        </div>\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"auth-basic-password\">Password</Label>\n          <Input\n            id=\"auth-basic-password\"\n            type=\"password\"\n            placeholder=\"Enter password\"\n            value={currentPassword}\n            onChange={(e) => {\n              onChange({\n                type: 'basic',\n                username: currentUsername,\n                password: e.target.value,\n              });\n            }}\n          />\n        </div>\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      <h3 className=\"text-sm font-medium\">Authentication</h3>\n      {renderAuthForm()}\n    </div>\n  );\n};\n\ninterface OAuth2FormProps {\n  scheme: OAuth2SecurityScheme;\n  schemeName: string;\n  value?: AuthData;\n  onChange: (auth: AuthData | undefined) => void;\n  requiredScopes: string[];\n  onAuthorize?: (input: OAuthAuthorizeInput) => void | Promise<void>;\n  onClear?: () => void;\n  state: OAuthAuthorizationState;\n}\n\nconst OAuth2Form: React.FC<OAuth2FormProps> = ({\n  scheme, schemeName, value, onChange, requiredScopes, onAuthorize, onClear, state,\n}) => {\n  const flows = useMemo(() => Object.keys(scheme.flows).filter(\n    (flow): flow is OAuthFlowName => flow === 'authorizationCode' || flow === 'clientCredentials'\n  ), [scheme.flows]);\n  const [flow, setFlow] = useState<OAuthFlowName>(flows[0] ?? 'authorizationCode');\n  const [clientId, setClientId] = useState('');\n  const [clientSecret, setClientSecret] = useState('');\n  const availableScopes = Object.keys(scheme.flows[flow]?.scopes ?? {});\n  const [scopes, setScopes] = useState<string[]>(requiredScopes);\n  const [manualOpen, setManualOpen] = useState(flows.length === 0 || !onAuthorize);\n\n  useEffect(() => {\n    setScopes((current) => [...new Set([...current.filter((scope) => availableScopes.includes(scope)), ...requiredScopes])]);\n  }, [flow, requiredScopes.join('|'), availableScopes.join('|')]);\n\n  const busy = state.status === 'authorizing' || state.status === 'refreshing';\n  const authorized = state.status === 'authorized' || state.status === 'refreshing';\n\n  return <div className=\"space-y-3 rounded-md border border-border/70 bg-muted/20 p-3\">\n    {flows.length > 0 && onAuthorize ? <>\n      <div className=\"flex items-center justify-between gap-3\">\n        <div>\n          <p className=\"text-sm font-medium\">OAuth 2.0</p>\n          <p className=\"text-xs text-muted-foreground\">Credentials remain in this browser session.</p>\n        </div>\n        <span className={`text-xs font-medium ${authorized ? 'text-green-700' : state.status === 'error' ? 'text-red-700' : 'text-muted-foreground'}`} role=\"status\">\n          {state.status === 'authorized' ? 'Authorized' : state.status === 'refreshing' ? 'Refreshing…' : state.status === 'authorizing' ? 'Authorizing…' : state.status === 'error' ? 'Authorization failed' : 'Not authorized'}\n        </span>\n      </div>\n      {flows.length > 1 && <div className=\"space-y-1\">\n        <Label htmlFor=\"oauth-flow\">Grant type</Label>\n        <select id=\"oauth-flow\" className=\"flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm\" value={flow} onChange={(event) => setFlow(event.target.value as OAuthFlowName)}>\n          {flows.map((item) => <option key={item} value={item}>{item === 'authorizationCode' ? 'Authorization Code' : 'Client Credentials'}</option>)}\n        </select>\n      </div>}\n      <div className=\"space-y-1\"><Label htmlFor=\"oauth-client-id\">Client ID</Label><Input id=\"oauth-client-id\" autoComplete=\"off\" value={clientId} onChange={(event) => setClientId(event.target.value)} /></div>\n      <div className=\"space-y-1\"><Label htmlFor=\"oauth-client-secret\">Client Secret <span className=\"text-xs text-muted-foreground\">(optional)</span></Label><Input id=\"oauth-client-secret\" type=\"password\" autoComplete=\"off\" value={clientSecret} onChange={(event) => setClientSecret(event.target.value)} /></div>\n      {availableScopes.length > 0 && <fieldset className=\"space-y-1.5\"><legend className=\"text-sm font-medium\">Scopes</legend>{availableScopes.map((scope) => <label key={scope} className=\"flex items-start gap-2 text-xs\"><input type=\"checkbox\" className=\"mt-0.5\" checked={scopes.includes(scope)} disabled={requiredScopes.includes(scope)} onChange={(event) => setScopes(event.target.checked ? [...scopes, scope] : scopes.filter((item) => item !== scope))} /><span><code>{scope}</code>{requiredScopes.includes(scope) && <span className=\"ml-1 text-muted-foreground\">required</span>}<span className=\"block text-muted-foreground\">{scheme.flows[flow]?.scopes[scope]}</span></span></label>)}</fieldset>}\n      {state.error && <p className=\"text-xs text-red-700\" role=\"alert\">{state.error}</p>}\n      <div className=\"flex flex-wrap gap-2\">\n        <Button type=\"button\" size=\"sm\" disabled={busy || !clientId} onClick={() => void onAuthorize({ schemeName, flow, clientId, clientSecret: clientSecret || undefined, scopes })}>{authorized ? 'Reauthorize' : 'Authorize'}</Button>\n        {authorized && <Button type=\"button\" size=\"sm\" variant=\"outline\" onClick={() => { onClear?.(); onChange(undefined); }}>Clear</Button>}\n        <Button type=\"button\" size=\"sm\" variant=\"ghost\" onClick={() => setManualOpen((open) => !open)} aria-expanded={manualOpen}>Use access token</Button>\n      </div>\n    </> : <p className=\"text-xs text-muted-foreground\">This API does not publish a supported OAuth authorization flow. Enter an existing access token.</p>}\n    {manualOpen && <div className=\"space-y-1 border-t border-border/70 pt-3\"><Label htmlFor=\"auth-oauth2\">Access Token</Label><Input id=\"auth-oauth2\" type=\"password\" placeholder=\"Enter OAuth2 access token\" value={value?.type === 'oauth2' ? value.token : ''} onChange={(event) => onChange({ type: 'oauth2', token: event.target.value })} /></div>}\n  </div>;\n};\n","import React, { useMemo, useState } from 'react';\nimport type { Parameter } from '@/types/playground';\nimport { Input } from '@/components/ui/input';\nimport { Badge } from '@/components/ui/badge';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { Checkbox } from '@/components/ui/checkbox';\nimport { validateParameter } from '@/lib/validation';\nimport { getSchemaInputValue } from '@/lib/schema';\nimport { useI18n } from '@/contexts/I18nContext';\n\ntype Translate = (key: string, variables?: Record<string, string | number>) => string;\n\n/**\n * Props for ParametersForm component\n */\nexport interface ParametersFormProps {\n  /** API parameters definition */\n  parameters: Parameter[];\n\n  /** Current parameter values */\n  values: Record<string, string>;\n\n  /** Callback when parameter values change */\n  onChange: (values: Record<string, string>) => void;\n\n  /** Validation errors for parameters */\n  errors?: Record<string, string>;\n\n  /** Filter parameters by type (optional) */\n  parameterType?: 'path' | 'query' | 'header';\n}\n\n/**\n * Generate validation hint text for a parameter schema\n */\nfunction getValidationHint(schema: Parameter['schema'], t: Translate): string | null {\n  const hints: string[] = [];\n\n  if (schema.format) {\n    hints.push(`${t('format')}: ${schema.format}`);\n  }\n\n  if (schema.pattern) {\n    hints.push(`${t('pattern')}: ${schema.pattern}`);\n  }\n\n  if (schema.type === 'string') {\n    if (schema.minLength !== undefined && schema.maxLength !== undefined) {\n      hints.push(`${t('length')}: ${schema.minLength}-${schema.maxLength} ${t('characters')}`);\n    } else if (schema.minLength !== undefined) {\n      hints.push(`${t('minLength')}: ${schema.minLength} ${t('characters')}`);\n    } else if (schema.maxLength !== undefined) {\n      hints.push(`${t('maxLength')}: ${schema.maxLength} ${t('characters')}`);\n    }\n  }\n\n  if (schema.type === 'number') {\n    if (schema.minimum !== undefined && schema.maximum !== undefined) {\n      hints.push(`${t('range')}: ${schema.minimum}-${schema.maximum}`);\n    } else if (schema.minimum !== undefined) {\n      hints.push(`${t('minimum')}: ${schema.minimum}`);\n    } else if (schema.maximum !== undefined) {\n      hints.push(`${t('maximum')}: ${schema.maximum}`);\n    }\n  }\n\n  return hints.length > 0 ? hints.join(', ') : null;\n}\n\n/**\n * ParametersForm component\n * Renders dynamic parameter input forms grouped by type (path, query, header)\n */\nexport const ParametersForm: React.FC<ParametersFormProps> = ({\n  parameters,\n  values,\n  onChange,\n  errors = {},\n  parameterType,\n}) => {\n  const { t } = useI18n();\n  const [blurErrors, setBlurErrors] = useState<Record<string, string>>({});\n\n  const groupedParameters = useMemo(() => {\n    const filtered = parameterType\n      ? parameters.filter((p) => p.in === parameterType)\n      : parameters;\n\n    return {\n      path: filtered.filter((p) => p.in === 'path'),\n      query: filtered.filter((p) => p.in === 'query'),\n      header: filtered.filter((p) => p.in === 'header'),\n    };\n  }, [parameters, parameterType]);\n\n  const handleChange = (paramName: string, value: string) => {\n    onChange({\n      ...values,\n      [paramName]: value,\n    });\n\n    if (blurErrors[paramName] || errors[paramName]) {\n      setBlurErrors((prev) => {\n        const newErrors = { ...prev };\n        delete newErrors[paramName];\n        return newErrors;\n      });\n    }\n  };\n\n  const handleBlur = (parameter: Parameter) => {\n    const value = values[parameter.name] || '';\n    const error = validateParameter(value, parameter.schema, parameter.required ?? false);\n\n    if (error) {\n      setBlurErrors((prev) => ({\n        ...prev,\n        [parameter.name]: error,\n      }));\n    } else {\n      setBlurErrors((prev) => {\n        const newErrors = { ...prev };\n        delete newErrors[parameter.name];\n        return newErrors;\n      });\n    }\n  };\n\n  const allErrors = { ...blurErrors, ...errors };\n\n  const renderParameterInput = (param: Parameter) => {\n    const value = values[param.name] || '';\n    const error = allErrors[param.name];\n    const isRequired = param.required || false;\n    const validationHint = getValidationHint(param.schema, t);\n\n    const renderInput = () => {\n      if (param.schema.enum && param.schema.enum.length > 0) {\n        return (\n          <Select value={value} onValueChange={(val) => handleChange(param.name, val)}>\n            <SelectTrigger>\n              <SelectValue placeholder={t('selectValue')} />\n            </SelectTrigger>\n            <SelectContent>\n              {param.schema.enum.map((option) => (\n                <SelectItem key={option} value={option}>\n                  {option}\n                </SelectItem>\n              ))}\n            </SelectContent>\n          </Select>\n        );\n      }\n\n      if (param.schema.type === 'boolean') {\n        return (\n          <div className=\"flex items-center space-x-2\">\n            <Checkbox\n              id={param.name}\n              checked={value === 'true'}\n              onCheckedChange={(checked) => handleChange(param.name, checked ? 'true' : 'false')}\n              onBlur={() => handleBlur(param)}\n            />\n            <label\n              htmlFor={param.name}\n              className=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n            >\n              {param.name}\n            </label>\n          </div>\n        );\n      }\n\n      if (param.schema.type === 'number') {\n        return (\n          <Input\n            id={param.name}\n            type=\"number\"\n            value={value}\n            onChange={(e) => handleChange(param.name, e.target.value)}\n            onBlur={() => handleBlur(param)}\n            placeholder={getSchemaInputValue(param.schema) || t('enterParameter', { name: param.name })}\n            aria-label={param.name}\n            aria-required={isRequired}\n            aria-invalid={!!error}\n            aria-describedby={error ? `${param.name}-error` : validationHint ? `${param.name}-hint` : undefined}\n          />\n        );\n      }\n\n      return (\n        <Input\n          id={param.name}\n          type=\"text\"\n          value={value}\n          onChange={(e) => handleChange(param.name, e.target.value)}\n          onBlur={() => handleBlur(param)}\n          placeholder={getSchemaInputValue(param.schema) || t('enterParameter', { name: param.name })}\n          aria-label={param.name}\n          aria-required={isRequired}\n          aria-invalid={!!error}\n          aria-describedby={error ? `${param.name}-error` : validationHint ? `${param.name}-hint` : undefined}\n        />\n      );\n    };\n\n    return (\n      <div key={param.name} className=\"space-y-2\">\n        <label\n          htmlFor={param.name}\n          className=\"block text-sm font-medium text-gray-700 dark:text-gray-300\"\n        >\n          {param.name}\n          {isRequired && (\n            <Badge variant=\"destructive\" className=\"ml-2 text-xs\">\n              {t('required')}\n            </Badge>\n          )}\n          <span className=\"ml-2 text-xs text-gray-500\">\n            ({param.schema.type})\n          </span>\n        </label>\n\n        {renderInput()}\n\n        {validationHint && !error && (\n          <p id={`${param.name}-hint`} className=\"text-xs text-muted-foreground\">\n            {validationHint}\n          </p>\n        )}\n\n        {param.description && !error && !validationHint && (\n          <p className=\"text-xs text-gray-500 dark:text-gray-400\">\n            {param.description}\n          </p>\n        )}\n\n        {error && (\n          <p\n            id={`${param.name}-error`}\n            className=\"text-xs text-red-600 dark:text-red-400\"\n            role=\"alert\"\n            aria-live=\"polite\"\n          >\n            {error}\n          </p>\n        )}\n      </div>\n    );\n  };\n\n  const renderSection = (\n    title: string,\n    params: Parameter[],\n    _collapsible = false\n  ) => {\n    if (params.length === 0) return null;\n\n    const content = (\n      <div className=\"space-y-4\">\n        {params.map((param) => renderParameterInput(param))}\n      </div>\n    );\n\n    return (\n      <Card key={title} className=\"mb-4\">\n        <CardHeader>\n          <CardTitle className=\"text-base\">{title}</CardTitle>\n        </CardHeader>\n        <CardContent>{content}</CardContent>\n      </Card>\n    );\n  };\n\n  if (parameters.length === 0) {\n    return null;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {renderSection(t('pathParameters'), groupedParameters.path)}\n      {renderSection(t('queryParameters'), groupedParameters.query)}\n      {renderSection(t('headers'), groupedParameters.header, true)}\n    </div>\n  );\n};\n","import React, { useState, useEffect, useCallback, useRef, useMemo } from 'react';\nimport type { PontxAPI } from '@pontx/spec';\nimport { CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Button } from '@/components/ui/button';\nimport { Badge } from '@/components/ui/badge';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport { X, AlertCircle, XCircle } from 'lucide-react';\nimport { UrlConfiguration, type Server } from './UrlConfiguration';\nimport { AuthConfiguration } from './AuthConfiguration';\nimport { ParametersForm } from './ParametersForm';\nimport { RequestBodyEditor } from './RequestBodyEditor';\nimport { ExecuteButton } from './ExecuteButton';\nimport { ResultsDisplay } from './ResultsDisplay';\nimport { CodeSnippets } from './CodeSnippets';\nimport {\n  loadPlaygroundConfig,\n  savePlaygroundConfig,\n  loadSpecBaseUrl,\n  type PlaygroundConfig,\n  type AuthData,\n} from '@/lib/storage';\nimport type {\n  PlaygroundRequest,\n  PlaygroundExecutionResult,\n  PlaygroundState,\n  ValidationError,\n  CodeGenScenario,\n  CodeGenRequest,\n  OAuthAuthorizeInput,\n  OAuthAuthorizationState,\n} from '@/types/playground';\nimport { useI18n } from '@/contexts/I18nContext';\nimport { getSchemaInputValue } from '@/lib/schema';\n\n/**\n * Props for PlaygroundPanel component\n */\nexport interface PlaygroundPanelProps {\n  /** Whether the panel is visible */\n  visible: boolean;\n\n  /** Callback to change panel visibility */\n  onVisibleChange: (visible: boolean) => void;\n\n  /** API specification data */\n  api: PontxAPI;\n\n  /** Spec name for localStorage (shared base URL) */\n  specName: string;\n\n  /** Available servers from spec */\n  servers?: Server[];\n\n  /** Callback for executing API requests */\n  onExecute: (request: PlaygroundRequest) => void;\n\n  onOAuthAuthorize?: (input: OAuthAuthorizeInput) => void | Promise<void>;\n  onOAuthClear?: () => void;\n  oauthState?: OAuthAuthorizationState;\n  oauthAccessToken?: string;\n  oauthRequiredScopes?: string[];\n\n  /** API execution result */\n  executionResult?: PlaygroundExecutionResult;\n\n  /** Whether request is currently executing */\n  isExecuting: boolean;\n\n  /** Callback for validation errors */\n  onValidationError?: (errors: ValidationError[]) => void;\n\n  /** Callback for state changes */\n  onStateChange?: (state: PlaygroundState) => void;\n\n  /** 获取代码生成场景列表，不传则不显示代码 Tab */\n  getCodeGenScenarios?: () => CodeGenScenario[];\n\n  /** 根据请求参数和场景生成代码，不传则不显示代码 Tab */\n  onGenerateCode?: (req: CodeGenRequest) => string | Promise<string>;\n}\n\n/**\n * Validate API specification structure\n */\nfunction validateApiSpec(api: PontxAPI | null | undefined): string | null {\n  if (!api) {\n    return 'No API provided. Please select a valid API endpoint.';\n  }\n\n  if (!api.method) {\n    return 'Invalid API specification: method is required.';\n  }\n\n  if (!api.path) {\n    return 'Invalid API specification: path is required.';\n  }\n\n  return null;\n}\n\n/**\n * Validate execution result structure\n */\nfunction validateExecutionResult(result: unknown): boolean {\n  if (!result || typeof result !== 'object') return false;\n\n  const r = result as Record<string, unknown>;\n  const hasValidStructure =\n    r.status !== undefined ||\n    r.data !== undefined ||\n    r.error !== undefined ||\n    r.headers !== undefined;\n\n  return hasValidStructure;\n}\n\n/**\n * Detect circular references in schema\n */\nfunction hasCircularReference(obj: unknown, seen = new WeakSet()): boolean {\n  if (obj === null || typeof obj !== 'object') {\n    return false;\n  }\n\n  if (seen.has(obj as object)) {\n    return true;\n  }\n\n  seen.add(obj as object);\n\n  try {\n    for (const key in obj as Record<string, unknown>) {\n      if (Object.prototype.hasOwnProperty.call(obj, key)) {\n        if (hasCircularReference((obj as Record<string, unknown>)[key], seen)) {\n          return true;\n        }\n      }\n    }\n  } catch (e) {\n    return true;\n  }\n\n  return false;\n}\n\n/**\n * PlaygroundPanel - Main container for API testing interface\n */\nexport const PlaygroundPanel: React.FC<PlaygroundPanelProps> = ({\n  visible,\n  onVisibleChange,\n  api,\n  specName,\n  servers,\n  onExecute,\n  onOAuthAuthorize,\n  onOAuthClear,\n  oauthState,\n  oauthAccessToken,\n  oauthRequiredScopes,\n  executionResult,\n  isExecuting,\n  // eslint-disable-next-line @typescript-eslint/no-unused-vars\n  onValidationError: _onValidationError,\n  onStateChange,\n  getCodeGenScenarios,\n  onGenerateCode,\n}) => {\n  const { t } = useI18n();\n  // State management\n  const [url, setUrl] = useState<string>('');\n  const [auth, setAuth] = useState<AuthData | undefined>();\n\n  useEffect(() => {\n    if (oauthAccessToken) setAuth({ type: 'oauth2', token: oauthAccessToken });\n  }, [oauthAccessToken]);\n  const [pathParams, setPathParams] = useState<Record<string, string>>({});\n  const [queryParams, setQueryParams] = useState<Record<string, string>>({});\n  const [headerParams, setHeaderParams] = useState<Record<string, string>>({});\n  const [requestBody, setRequestBody] = useState<string>('');\n  const [localExecutionResult, setLocalExecutionResult] = useState<\n    PlaygroundExecutionResult | undefined\n  >(executionResult);\n\n  // Error state management\n  const [apiError, setApiError] = useState<string | null>(null);\n  const [storageError, setStorageError] = useState<string | null>(null);\n  const [resultError, setResultError] = useState<string | null>(null);\n\n  // Track previous API to detect changes\n  const prevApiRef = useRef<{ method: string; path: string } | null>(null);\n\n  // Track if this is initial load to prevent clearing on mount\n  const isInitialLoadRef = useRef(true);\n\n  // Ref for focus management\n  const closeButtonRef = useRef<HTMLButtonElement>(null);\n  const panelRef = useRef<HTMLDivElement>(null);\n\n  /**\n   * Validate A