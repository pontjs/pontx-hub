+{"version":3,"file":"CodeSnippets-BZv8VyOQ.js","sources":["../src/components/ui/button.tsx","../src/components/ui/checkbox.tsx","../src/components/ui/label.tsx","../src/lib/monaco-config.ts","../src/components/ui/monaco-editor-wrapper.tsx","../src/components/ui/select.tsx","../src/components/ui/tabs.tsx","../src/lib/validation.ts","../src/lib/schema.ts","../src/playground/RequestBodyEditor.tsx","../src/playground/ExecuteButton.tsx","../src/lib/schema-descriptions.ts","../src/hooks/useMonacoFieldDescriptions.ts","../src/playground/ResultsDisplay.tsx","../src/playground/CodeSnippets.tsx"],"sourcesContent":["import * as React from \"react\";\nimport { Slot } from \"@radix-ui/react-slot\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\nimport { cn } from \"@/utils\";\n\nconst buttonVariants = cva(\n  \"inline-flex items-center justify-center whitespace-nowrap rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50\",\n  {\n    variants: {\n      variant: {\n        default: \"bg-primary text-primary-foreground hover:bg-primary/90\",\n        destructive: \"bg-destructive text-destructive-foreground hover:bg-destructive/90\",\n        outline: \"border border-input bg-background hover:bg-accent hover:text-accent-foreground\",\n        secondary: \"bg-secondary text-secondary-foreground hover:bg-secondary/80\",\n        ghost: \"hover:bg-accent hover:text-accent-foreground\",\n        link: \"text-primary underline-offset-4 hover:underline\",\n      },\n      size: {\n        default: \"h-10 px-4 py-2\",\n        sm: \"h-9 rounded-md px-3\",\n        lg: \"h-11 rounded-md px-8\",\n        icon: \"h-10 w-10\",\n      },\n    },\n    defaultVariants: {\n      variant: \"default\",\n      size: \"default\",\n    },\n  }\n);\n\nexport interface ButtonProps\n  extends React.ButtonHTMLAttributes<HTMLButtonElement>,\n    VariantProps<typeof buttonVariants> {\n  asChild?: boolean;\n}\n\nconst Button = React.forwardRef<HTMLButtonElement, ButtonProps>(\n  ({ className, variant, size, asChild = false, ...props }, ref) => {\n    const Comp = asChild ? Slot : \"button\";\n    return <Comp className={cn(buttonVariants({ variant, size, className }))} ref={ref} {...props} />;\n  }\n);\nButton.displayName = \"Button\";\n\nexport { Button, buttonVariants };\n","import * as React from \"react\"\nimport * as CheckboxPrimitive from \"@radix-ui/react-checkbox\"\nimport { Check } from \"lucide-react\"\n\nimport { cn } from \"@/utils/cn\"\n\nconst Checkbox = React.forwardRef<\n  React.ElementRef<typeof CheckboxPrimitive.Root>,\n  React.ComponentPropsWithoutRef<typeof CheckboxPrimitive.Root>\n>(({ className, ...props }, ref) => (\n  <CheckboxPrimitive.Root\n    ref={ref}\n    className={cn(\n      \"peer h-4 w-4 shrink-0 rounded-sm border border-primary shadow focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-ring disabled:cursor-not-allowed disabled:opacity-50 data-[state=checked]:bg-primary data-[state=checked]:text-primary-foreground\",\n      className\n    )}\n    {...props}\n  >\n    <CheckboxPrimitive.Indicator\n      className={cn(\"flex items-center justify-center text-current\")}\n    >\n      <Check className=\"h-4 w-4\" />\n    </CheckboxPrimitive.Indicator>\n  </CheckboxPrimitive.Root>\n))\nCheckbox.displayName = CheckboxPrimitive.Root.displayName\n\nexport { Checkbox }\n","import * as React from \"react\"\nimport * as LabelPrimitive from \"@radix-ui/react-label\"\nimport { cva, type VariantProps } from \"class-variance-authority\"\n\nimport { cn } from \"@/utils/cn\"\n\nconst labelVariants = cva(\n  \"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n)\n\nconst Label = React.forwardRef<\n  React.ElementRef<typeof LabelPrimitive.Root>,\n  React.ComponentPropsWithoutRef<typeof LabelPrimitive.Root> &\n    VariantProps<typeof labelVariants>\n>(({ className, ...props }, ref) => (\n  <LabelPrimitive.Root\n    ref={ref}\n    className={cn(labelVariants(), className)}\n    {...props}\n  />\n))\nLabel.displayName = LabelPrimitive.Root.displayName\n\nexport { Label }\n","/**\n * Monaco Editor configuration for API Playground\n * Provides theme configuration and editor options\n */\n\nimport type { EditorProps } from \"@monaco-editor/react\";\n\nexport const defaultCodeFontFamily =\n  '\"IBM Plex Mono\", \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace';\n\n/**\n * Get Monaco Editor theme based on application theme\n * @param isDark - Whether the application is in dark mode\n * @returns Monaco theme name\n */\nexport function getMonacoTheme(isDark: boolean): string {\n  return isDark ? \"vs-dark\" : \"vs-light\";\n}\n\n/**\n * Default Monaco Editor options for JSON editing\n * These options provide a good balance between functionality and performance\n */\nexport const defaultMonacoOptions: EditorProps[\"options\"] = {\n  language: \"json\",\n  fontFamily: defaultCodeFontFamily,\n  fontLigatures: false,\n  minimap: { enabled: false },\n  lineNumbers: \"on\",\n  scrollBeyondLastLine: false,\n  automaticLayout: true,\n  formatOnPaste: true,\n  formatOnType: true,\n  tabSize: 2,\n  insertSpaces: true,\n  folding: true,\n  bracketPairColorization: { enabled: true },\n  readOnly: false,\n  renderLineHighlight: \"line\",\n  suggestOnTriggerCharacters: true,\n  quickSuggestions: true,\n  wordWrap: \"off\",\n};\n\n/**\n * Monaco Editor options for read-only display (e.g., response viewer)\n */\nexport const readOnlyMonacoOptions: EditorProps[\"options\"] = {\n  ...defaultMonacoOptions,\n  readOnly: true,\n  contextmenu: false,\n  lineNumbers: \"off\",\n  folding: true,\n};\n\n/**\n * Monaco Editor loader configuration\n * This ensures Monaco Editor is loaded from CDN with proper configuration\n */\nexport const monacoLoaderConfig = {\n  paths: {\n    vs: \"https://cdn.jsdelivr.net/npm/monaco-editor@0.50.0/min/vs\",\n  },\n};\n","/**\n * Monaco Editor Wrapper Component\n * Provides a configured Monaco Editor with theme support and fallback handling\n */\n\nimport React, { useState, useCallback } from \"react\";\nimport Editor, { type EditorProps, type OnMount, loader } from \"@monaco-editor/react\";\nimport {\n  getMonacoTheme,\n  defaultMonacoOptions,\n  monacoLoaderConfig,\n} from \"@/lib/monaco-config\";\n\n// Configure Monaco loader\nloader.config(monacoLoaderConfig);\n\nexport interface MonacoEditorWrapperProps {\n  /** Current JSON value */\n  value: string;\n\n  /** Callback when value changes */\n  onChange?: (value: string) => void;\n\n  /** Whether the editor is in dark mode */\n  isDark?: boolean;\n\n  /** Height of the editor in pixels */\n  height?: number | string;\n\n  /** Whether the editor is read-only */\n  readOnly?: boolean;\n\n  /** Editor language, defaults to \"json\" */\n  language?: string;\n\n  /** Additional editor options to override defaults */\n  options?: EditorProps[\"options\"];\n\n  /** Callback when editor loading fails */\n  onLoadError?: (error: Error) => void;\n\n  /** Callback after Monaco editor and API instances are ready */\n  onMount?: OnMount;\n}\n\n/**\n * Monaco Editor Wrapper with configuration and error handling\n */\nexport const MonacoEditorWrapper: React.FC<MonacoEditorWrapperProps> = ({\n  value,\n  onChange,\n  isDark = false,\n  height = 300,\n  readOnly = false,\n  language = \"json\",\n  options = {},\n  onLoadError,\n  onMount,\n}) => {\n  const [loadFailed, setLoadFailed] = useState(false);\n\n  const handleEditorChange = useCallback(\n    (newValue: string | undefined) => {\n      if (onChange && newValue !== undefined) {\n        onChange(newValue);\n      }\n    },\n    [onChange]\n  );\n\n  const handleMount: OnMount = useCallback((editor, monaco) => {\n    // Editor mounted successfully\n    setLoadFailed(false);\n    onMount?.(editor, monaco);\n  }, [onMount]);\n\n  // eslint-disable-next-line @typescript-eslint/no-unused-vars\n  const _handleLoadError = useCallback(\n    (error: Error) => {\n      console.error(\"Monaco Editor failed to load:\", error);\n      setLoadFailed(true);\n      if (onLoadError) {\n        onLoadError(error);\n      }\n    },\n    [onLoadError]\n  );\n\n  // Fallback to textarea if Monaco Editor fails to load\n  if (loadFailed) {\n    return (\n      <div className=\"relative\">\n        <div className=\"mb-2 rounded-md bg-yellow-50 p-2 text-sm text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-200\">\n          JSON 编辑器加载失败,使用基本编辑器\n        </div>\n        <textarea\n          value={value}\n          onChange={(e) => onChange?.(e.target.value)}\n          readOnly={readOnly}\n          className=\"w-full rounded-md border border-gray-300 p-2 font-mono text-sm dark:border-gray-700 dark:bg-gray-900\"\n          style={{ height: typeof height === \"number\" ? `${height}px` : height }}\n        />\n      </div>\n    );\n  }\n\n  const editorOptions = {\n    ...defaultMonacoOptions,\n    ...options,\n    readOnly,\n  };\n\n  return (\n    <div className=\"monaco-editor-container\" data-readonly={readOnly ? 'true' : 'false'}>\n      <Editor\n        height={height}\n        language={language}\n        value={value}\n        onChange={handleEditorChange}\n        onMount={handleMount}\n        theme={getMonacoTheme(isDark)}\n        options={editorOptions}\n        loading={\n          <div className=\"flex h-full items-center justify-center\">\n            <div className=\"text-sm text-gray-500\">加载编辑器...</div>\n          </div>\n        }\n      />\n    </div>\n  );\n};\n\n// Add display name for debugging\nMonacoEditorWrapper.displayName = \"MonacoEditorWrapper\";\n","import * as React from \"react\"\nimport * as SelectPrimitive from \"@radix-ui/react-select\"\nimport { Check, ChevronDown } from \"lucide-react\"\n\nimport { cn } from \"@/utils/cn\"\n\nconst Select = SelectPrimitive.Root\n\nconst SelectGroup = SelectPrimitive.Group\n\nconst SelectValue = SelectPrimitive.Value\n\nconst SelectTrigger = React.forwardRef<\n  React.ElementRef<typeof SelectPrimitive.Trigger>,\n  React.ComponentPropsWithoutRef<typeof SelectPrimitive.Trigger>\n>(({ className, children, ...props }, ref) => (\n  <SelectPrimitive.Trigger\n    ref={ref}\n    className={cn(\n      \"flex h-9 w-full items-center justify-between rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm ring-offset-background placeholder:text-muted-foreground focus:outline-none focus:ring-1 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-50\",\n      className\n    )}\n    {...props}\n  >\n    {children}\n    <SelectPrimitive.Icon asChild>\n      <ChevronDown className=\"h-4 w-4 opacity-50\" />\n    </SelectPrimitive.Icon>\n  </SelectPrimitive.Trigger>\n))\nSelectTrigger.displayName = SelectPrimitive.Trigger.displayName\n\nconst SelectContent = React.forwardRef<\n  React.ElementRef<typeof SelectPrimitive.Content>,\n  React.ComponentPropsWithoutRef<typeof SelectPrimitive.Content>\n>(({ className, children, position = \"popper\", ...props }, ref) => (\n  <SelectPrimitive.Portal>\n    <SelectPrimitive.Content\n      ref={ref}\n      className={cn(\n        \"relative z-50 min-w-[8rem] overflow-hidden rounded-md border bg-background text-foreground shadow-md data-[state=open]:animate-in data-[state=closed]:animate-out data-[state=closed]:fade-out-0 data-[state=open]:fade-in-0 data-[state=closed]:zoom-out-95 data-[state=open]:zoom-in-95 data-[side=bottom]:slide-in-from-top-2 data-[side=left]:slide-in-from-right-2 data-[side=right]:slide-in-from-left-2 data-[side=top]:slide-in-from-bottom-2\",\n        position === \"popper\" &&\n          \"data-[side=bottom]:translate-y-1 data-[side=left]:-translate-x-1 data-[side=right]:translate-x-1 data-[side=top]:-translate-y-1\",\n        className\n      )}\n      position={position}\n      {...props}\n    >\n      <SelectPrimitive.Viewport\n        className={cn(\n          \"p-1\",\n          position === \"popper\" &&\n            \"h-[var(--radix-select-trigger-height)] w-full min-w-[var(--radix-select-trigger-width)]\"\n        )}\n      >\n        {children}\n      </SelectPrimitive.Viewport>\n    </SelectPrimitive.Content>\n  </SelectPrimitive.Portal>\n))\nSelectContent.displayName = SelectPrimitive.Content.displayName\n\nconst SelectLabel = React.forwardRef<\n  React.ElementRef<typeof SelectPrimitive.Label>,\n  React.ComponentPropsWithoutRef<typeof SelectPrimitive.Label>\n>(({ className, ...props }, ref) => (\n  <SelectPrimitive.Label\n    ref={ref}\n    className={cn(\"px-2 py-1.5 text-sm font-semibold\", className)}\n    {...props}\n  />\n))\nSelectLabel.displayName = SelectPrimitive.Label.displayName\n\nconst SelectItem = React.forwardRef<\n  React.ElementRef<typeof SelectPrimitive.Item>,\n  React.ComponentPropsWithoutRef<typeof SelectPrimitive.Item>\n>(({ className, children, ...props }, ref) => (\n  <SelectPrimitive.Item\n    ref={ref}\n    className={cn(\n      \"relative flex w-full cursor-default select-none items-center rounded-sm py-1.5 pl-2 pr-8 text-sm outline-none focus:bg-accent focus:text-accent-foreground data-[disabled]:pointer-events-none data-[disabled]:opacity-50\",\n      className\n    )}\n    {...props}\n  >\n    <span className=\"absolute right-2 flex h-3.5 w-3.5 items-center justify-center\">\n      <SelectPrimitive.ItemIndicator>\n        <Check className=\"h-4 w-4\" />\n      </SelectPrimitive.ItemIndicator>\n    </span>\n    <SelectPrimitive.ItemText>{children}</SelectPrimitive.ItemText>\n  </SelectPrimitive.Item>\n))\nSelectItem.displayName = SelectPrimitive.Item.displayName\n\nconst SelectSeparator = React.forwardRef<\n  React.ElementRef<typeof SelectPrimitive.Separator>,\n  React.ComponentPropsWithoutRef<typeof SelectPrimitive.Separator>\n>(({ className, ...props }, ref) => (\n  <SelectPrimitive.Separator\n    ref={ref}\n    className={cn(\"-mx-1 my-1 h-px bg-muted\", className)}\n    {...props}\n  />\n))\nSelectSeparator.displayName = SelectPrimitive.Separator.displayName\n\nexport {\n  Select,\n  SelectGroup,\n  SelectValue,\n  SelectTrigger,\n  SelectContent,\n  SelectLabel,\n  SelectItem,\n  SelectSeparator,\n}\n","import * as React from \"react\"\nimport * as TabsPrimitive from \"@radix-ui/react-tabs\"\n\nimport { cn } from \"@/utils/cn\"\n\nconst Tabs = TabsPrimitive.Root\n\nconst TabsList = React.forwardRef<\n  React.ElementRef<typeof TabsPrimitive.List>,\n  React.ComponentPropsWithoutRef<typeof TabsPrimitive.List>\n>(({ className, ...props }, ref) => (\n  <TabsPrimitive.List\n    ref={ref}\n    className={cn(\n      \"inline-flex h-9 items-center justify-center rounded-lg bg-muted p-1 text-muted-foreground\",\n      className\n    )}\n    {...props}\n  />\n))\nTabsList.displayName = TabsPrimitive.List.displayName\n\nconst TabsTrigger = React.forwardRef<\n  React.ElementRef<typeof TabsPrimitive.Trigger>,\n  React.ComponentPropsWithoutRef<typeof TabsPrimitive.Trigger>\n>(({ className, ...props }, ref) => (\n  <TabsPrimitive.Trigger\n    ref={ref}\n    className={cn(\n      \"inline-flex items-center justify-center whitespace-nowrap rounded-md px-3 py-1 text-sm font-medium ring-offset-background transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 data-[state=active]:bg-background data-[state=active]:text-foreground data-[state=active]:shadow\",\n      className\n    )}\n    {...props}\n  />\n))\nTabsTrigger.displayName = TabsPrimitive.Trigger.displayName\n\nconst TabsContent = React.forwardRef<\n  React.ElementRef<typeof TabsPrimitive.Content>,\n  React.ComponentPropsWithoutRef<typeof TabsPrimitive.Content>\n>(({ className, ...props }, ref) => (\n  <TabsPrimitive.Content\n    ref={ref}\n    className={cn(\n      \"mt-2 ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2\",\n      className\n    )}\n    {...props}\n  />\n))\nTabsContent.displayName = TabsPrimitive.Content.displayName\n\nexport { Tabs, TabsList, TabsTrigger, TabsContent }\n","/**\n * Validation utilities for API Playground\n * Provides parameter validation based on JSON Schema\n *\n * This module implements validation logic for:\n * - Parameter type validation (string, number, boolean, array)\n * - Format validation (email, URL, pattern matching)\n * - Range validation (min/max length, min/max value)\n * - Required field validation\n * - JSON syntax validation\n *\n * @module validation\n */\n\n// ==================== Type Definitions ====================\n\n/**\n * JSON Schema definition for parameter validation\n * Supports common JSON Schema validation keywords\n */\nexport interface JSONSchema {\n  /** The data type of the parameter */\n  type: 'string' | 'number' | 'boolean' | 'array' | 'object';\n\n  /** Allowed enum values */\n  enum?: string[];\n\n  /** Default value for the parameter */\n  default?: unknown;\n\n  /** Format constraint (email, uri, etc.) */\n  format?: string;\n\n  /** Regular expression pattern for validation */\n  pattern?: string;\n\n  /** Minimum string length */\n  minLength?: number;\n\n  /** Maximum string length */\n  maxLength?: number;\n\n  /** Minimum numeric value */\n  minimum?: number;\n\n  /** Maximum numeric value */\n  maximum?: number;\n}\n\n/**\n * API parameter definition\n * Matches OpenAPI/Pontx parameter specification\n */\nexport interface Parameter {\n  /** Parameter name */\n  name: string;\n\n  /** Parameter location */\n  in: 'path' | 'query' | 'header';\n\n  /** Whether the parameter is required */\n  required?: boolean;\n\n  /** JSON Schema for validation */\n  schema: JSONSchema;\n\n  /** Human-readable description */\n  description?: string;\n}\n\n/**\n * Validation error structure\n */\nexport interface ValidationError {\n  /** Field name that failed validation */\n  field: string;\n\n  /** Error message to display to user */\n  message: string;\n\n  /** Error category for UI handling */\n  type: 'required' | 'type' | 'format' | 'pattern' | 'custom';\n}\n\n// ==================== Format Validators ====================\n\n/**\n * Validate email format using RFC 5322 simplified regex\n * @param email - Email address to validate\n * @returns true if valid email format\n */\nfunction isValidEmail(email: string): boolean {\n  const emailRegex = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/;\n  return emailRegex.test(email);\n}\n\n/**\n * Validate URL format using native URL constructor\n * @param url - URL string to validate\n * @returns true if valid URL format\n */\nfunction isValidUrl(url: string): boolean {\n  try {\n    new URL(url);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\n/**\n * Validate string against regex pattern\n * @param value - String value to validate\n * @param pattern - Regular expression pattern\n * @returns true if value matches pattern\n */\nfunction matchesPattern(value: string, pattern: string): boolean {\n  try {\n    const regex = new RegExp(pattern);\n    return regex.test(value);\n  } catch {\n    // Invalid regex pattern\n    return false;\n  }\n}\n\n// ==================== Public API ====================\n\n/**\n * Validate a single parameter based on its JSON Schema\n *\n * This is the main validation function for individual parameters.\n * It checks required status, type, format, and constraints.\n *\n * @param value - The parameter value to validate (as string from form input)\n * @param schema - The JSON Schema definition for the parameter\n * @param required - Whether the parameter is required\n * @returns Error message if validation fails, null if valid\n *\n * @example\n * ```typescript\n * const error = validateParameter('test@example.com', {\n *   type: 'string',\n *   format: 'email'\n * }, true);\n * // Returns: null (valid email)\n * ```\n */\nexport function validateParameter(\n  value: string,\n  schema: JSONSchema,\n  required: boolean\n): string | null {\n  // Check if required and empty\n  if (required && (!value || value.trim() === '')) {\n    return 'This field is required';\n  }\n\n  // If not required and empty, skip validation\n  if (!required && (!value || value.trim() === '')) {\n    return null;\n  }\n\n  // Type-specific validation\n  switch (schema.type) {\n    case 'string':\n      return validateString(value, schema);\n    case 'number':\n      return validateNumber(value, schema);\n    case 'boolean':\n      return validateBoolean(value);\n    case 'array':\n      // Array is represented as comma-separated values in query params\n      // No special validation needed at this level\n      return null;\n    default:\n      return null;\n  }\n}\n\n// ==================== Type-Specific Validators ====================\n\n/**\n * Validate string parameter against schema constraints\n * @param value - String value to validate\n * @param schema - JSON Schema with string constraints\n * @returns Error message if invalid, null if valid\n */\nfunction validateString(value: string, schema: JSONSchema): string | null {\n  // Format validation\n  if (schema.format) {\n    switch (schema.format) {\n      case 'email':\n        if (!isValidEmail(value)) {\n          return 'Must be a valid email address';\n        }\n        break;\n      case 'uri':\n      case 'url':\n        if (!isValidUrl(value)) {\n          return 'Must be a valid URL';\n        }\n        break;\n    }\n  }\n\n  // Pattern validation\n  if (schema.pattern && !matchesPattern(value, schema.pattern)) {\n    return 'Does not match required format';\n  }\n\n  // Length validation\n  if (schema.minLength !== undefined && value.length < schema.minLength) {\n    return `Must be at least ${schema.minLength} characters`;\n  }\n\n  if (schema.maxLength !== undefined && value.length > schema.maxLength) {\n    return `Must be at most ${schema.maxLength} characters`;\n  }\n\n  return null;\n}\n\n/**\n * Validate number parameter against schema constraints\n * @param value - String representation of number\n * @param schema - JSON Schema with number constraints\n * @returns Error message if invalid, null if valid\n */\nfunction validateNumber(value: string, schema: JSONSchema): string | null {\n  const num = Number(value);\n\n  if (isNaN(num)) {\n    return 'Must be a valid number';\n  }\n\n  if (schema.minimum !== undefined && num < schema.minimum) {\n    return `Must be at least ${schema.minimum}`;\n  }\n\n  if (schema.maximum !== undefined && num > schema.maximum) {\n    return `Must be at most ${schema.maximum}`;\n  }\n\n  return null;\n}\n\n/**\n * Validate boolean parameter\n * @param value - String representation of boolean ('true' or 'false')\n * @returns Error message if invalid, null if valid\n */\nfunction validateBoolean(value: string): string | null {\n  const normalizedValue = value.toLowerCase();\n  if (normalizedValue !== 'true' && normalizedValue !== 'false') {\n    return 'Must be true or false';\n  }\n  return null;\n}\n\n/**\n * Validate all required parameters and return structured errors\n *\n * This function validates an entire set of parameters against their schemas.\n * It's typically used before submitting an API request to ensure all required\n * fields are filled and valid.\n *\n * @param values - Object containing parameter values (key: parameter name, value: parameter value)\n * @param parameters - Array of parameter definitions from API spec\n * @returns Array of validation errors (empty if all valid)\n *\n * @example\n * ```typescript\n * const errors = validateRequiredParameters(\n *   { id: '123', email: 'invalid' },\n *   [\n *     { name: 'id', in: 'path', required: true, schema: { type: 'string' } },\n *     { name: 'email', in: 'query', required: true, schema: { type: 'string', format: 'email' } }\n *   ]\n * );\n * // Returns: [{ field: 'email', message: 'Must be a valid email address', type: 'format' }]\n * ```\n */\nexport function validateRequiredParameters(\n  values: Record<string, string>,\n  parameters: Parameter[]\n): ValidationError[] {\n  const errors: ValidationError[] = [];\n\n  for (const param of parameters) {\n    const value = values[param.name] || '';\n    const isRequired = param.required ?? false;\n\n    // Check if required parameter is missing\n    if (isRequired && (!value || value.trim() === '')) {\n      errors.push({\n        field: param.name,\n        message: 'This field is required',\n        type: 'required',\n      });\n      continue;\n    }\n\n    // Skip validation for empty non-required parameters\n    if (!isRequired && (!value || value.trim() === '')) {\n      continue;\n    }\n\n    // Validate parameter value\n    const error = validateParameter(value, param.schema, isRequired);\n    if (error) {\n      errors.push({\n        field: param.name,\n        message: error,\n        type: getErrorType(error),\n      });\n    }\n  }\n\n  return errors;\n}\n\n/**\n * Determine error type from error message for UI categorization\n * @param message - Validation error message\n * @returns Error type category\n */\nfunction getErrorType(message: string): ValidationError['type'] {\n  if (message.includes('required')) return 'required';\n  if (message.includes('number') || message.includes('boolean')) return 'type';\n  if (message.includes('email') || message.includes('URL')) return 'format';\n  if (message.includes('format')) return 'pattern';\n  return 'custom';\n}\n\n/**\n * Validate JSON string syntax\n *\n * This function checks if a string contains valid JSON.\n * Used for validating request body input in Monaco Editor.\n *\n * @param json - The JSON string to validate\n * @returns Error message if invalid, null if valid\n *\n * @example\n * ```typescript\n * const error = validateJSON('{\"name\": \"test\"}');\n * // Returns: null (valid JSON)\n *\n * const error2 = validateJSON('{name: \"test\"}');\n * // Returns: \"Invalid JSON: ...\" (missing quotes)\n * ```\n */\nexport function validateJSON(json: string): string | null {\n  // Check for empty or whitespace-only string\n  if (!json || json.trim() === '') {\n    return 'Invalid JSON: empty string';\n  }\n\n  try {\n    JSON.parse(json);\n    return null;\n  } catch (error) {\n    if (error instanceof SyntaxError) {\n      return `Invalid JSON: ${error.message}`;\n    }\n    return 'Invalid JSON syntax';\n  }\n}\n","/* eslint-disable @typescript-eslint/no-explicit-any */\n\n/**\n * JSON Schema type definition\n * Represents a subset of JSON Schema specification used for API documentation\n * @see https://json-schema.org/\n */\nexport interface JSONSchema {\n  /** The JSON Schema type */\n  type?:\n    | \"string\"\n    | \"number\"\n    | \"integer\"\n    | \"boolean\"\n    | \"array\"\n    | \"object\"\n    | \"null\";\n  /** Object properties (for object type) */\n  properties?: Record<string, JSONSchema>;\n  /** Array items schema (for array type) */\n  items?: JSONSchema;\n  /** Required property names (for object type) */\n  required?: string[];\n  /** Enumeration of allowed values */\n  enum?: any[];\n  /** Default value */\n  default?: any;\n  /** Single example value */\n  example?: any;\n  /** Array of example values */\n  examples?: any[];\n  /** Format hint for string values (email, uri, date-time, etc.) */\n  format?: string;\n  /** Reference to another schema */\n  $ref?: string;\n  /** Schema must match all of these schemas */\n  allOf?: JSONSchema[];\n  /** Schema must match at least one of these schemas */\n  anyOf?: JSONSchema[];\n  /** Schema must match exactly one of these schemas */\n  oneOf?: JSONSchema[];\n  /** Human-readable description */\n  description?: string;\n  /** Additional properties allowed */\n  [key: string]: any;\n}\n\n/** Use a real default when present, otherwise fall back to an explicit example. */\nexport function getSchemaInputValue(schema?: Pick<JSONSchema, \"default\" | \"example\" | \"examples\">): string {\n  if (!schema) return \"\";\n  const value = schema.default !== undefined\n    ? schema.default\n    : schema.example !== undefined\n      ? schema.example\n      : schema.examples?.[0];\n  return value === undefined || value === null ? \"\" : String(value);\n}\n\n/**\n * Generate example data from a JSON Schema\n *\n * Priority order for example generation:\n * 1. Explicit `example` field\n * 2. First item from `examples` array\n * 3. `default` value\n * 4. First value from `enum`\n * 5. Generated value based on type and format\n *\n * Handles circular references to prevent infinite recursion.\n *\n * @param schema - The JSON Schema to generate example from\n * @param visited - Set of visited schema references to detect circular references\n * @returns Generated example data matching the schema\n * @example\n * ```typescript\n * const schema = { type: 'string', format: 'email' };\n * const example = generateExampleFromSchema(schema);\n * // Returns: \"user@example.com\"\n * ```\n */\nexport function generateExampleFromSchema(\n  schema: JSONSchema,\n  visited: Set<string> = new Set()\n): any {\n  // Handle circular references\n  const schemaKey = JSON.stringify(schema);\n  if (visited.has(schemaKey)) {\n    return null; // Return null for circular references\n  }\n  visited.add(schemaKey);\n\n  // Priority 1: Use explicit example if provided\n  if (schema.example !== undefined) {\n    return schema.example;\n  }\n\n  // Priority 2: Use first example from examples array\n  if (schema.examples && schema.examples.length > 0) {\n    return schema.examples[0];\n  }\n\n  // Priority 3: Use default value if provided\n  if (schema.default !== undefined) {\n    return schema.default;\n  }\n\n  // Priority 4: Use enum value if provided\n  if (schema.enum && schema.enum.length > 0) {\n    return schema.enum[0];\n  }\n\n  // Handle allOf by merging schemas\n  if (schema.allOf && schema.allOf.length > 0) {\n    const merged: any = {};\n    for (const subSchema of schema.allOf) {\n      const example = generateExampleFromSchema(subSchema, visited);\n      if (typeof example === \"object\" && !Array.isArray(example)) {\n        Object.assign(merged, example);\n      }\n    }\n    return merged;\n  }\n\n  // Handle anyOf and oneOf by using first schema\n  if (schema.anyOf && schema.anyOf.length > 0) {\n    return generateExampleFromSchema(schema.anyOf[0], visited);\n  }\n\n  if (schema.oneOf && schema.oneOf.length > 0) {\n    return generateExampleFromSchema(schema.oneOf[0], visited);\n  }\n\n  // Generate based on type\n  switch (schema.type) {\n    case \"string\":\n      return generateStringExample(schema);\n\n    case \"number\":\n      return 42;\n\n    case \"integer\":\n      return 42;\n\n    case \"boolean\":\n      return true;\n\n    case \"null\":\n      return null;\n\n    case \"array\":\n      if (schema.items) {\n        const itemExample = generateExampleFromSchema(schema.items, visited);\n        return [itemExample];\n      }\n      return [];\n\n    case \"object\":\n      return generateObjectExample(schema, visited);\n\n    default:\n      // If no type specified, try to infer from properties\n      if (schema.properties) {\n        return generateObjectExample(schema, visited);\n      }\n      return null;\n  }\n}\n\n/**\n * Generate string example based on format\n * Supports common string formats defined in JSON Schema specification\n *\n * @param schema - The JSON Schema with string type\n * @returns A string example matching the format, or generic \"string\" if no format specified\n * @internal\n */\nfunction generateStringExample(schema: JSONSchema): string {\n  switch (schema.format) {\n    case \"email\":\n      return \"user@example.com\";\n\n    case \"date-time\":\n      return new Date().toISOString();\n\n    case \"uri\":\n    case \"url\":\n      return \"https://example.com\";\n\n    case \"uuid\":\n      return \"123e4567-e89b-12d3-a456-426614174000\";\n\n    case \"date\":\n      return new Date().toISOString().split(\"T\")[0];\n\n    case \"time\":\n      return new Date().toISOString().split(\"T\")[1];\n\n    default:\n      return \"string\";\n  }\n}\n\n/**\n * Generate object example from schema properties\n * Recursively generates examples for all defined properties\n *\n * @param schema - The JSON Schema with object type\n * @param visited - Set of visited schemas for circular reference detection\n * @returns An object with example values for each property\n * @internal\n */\nfunction generateObjectExample(\n  schema: JSONSchema,\n  visited: Set<string>\n): Record<string, any> {\n  const result: Record<string, any> = {};\n\n  if (schema.properties) {\n    for (const [key, propSchema] of Object.entries(schema.properties)) {\n      result[key] = generateExampleFromSchema(propSchema, visited);\n    }\n  }\n\n  return result;\n}\n\n/**\n * Generate empty template from a JSON Schema\n *\n * Creates a template object with empty/zero values for each type:\n * - string: \"\"\n * - number/integer: 0\n * - boolean: false\n * - array: []\n * - object: {} with empty properties\n * - null: null\n *\n * Uses `default` values from schema if provided.\n * Handles circular references to prevent infinite recursion.\n *\n * @param schema - The JSON Schema to generate template from\n * @param visited - Set of visited schema references to detect circular references\n * @returns Generated template with empty/default values\n * @example\n * ```typescript\n * const schema = {\n *   type: 'object',\n *   properties: {\n *     name: { type: 'string' },\n *     age: { type: 'number' }\n *   }\n * };\n * const template = generateTemplateFromSchema(schema);\n * // Returns: { name: \"\", age: 0 }\n * ```\n */\nexport function generateTemplateFromSchema(\n  schema: JSONSchema,\n  visited: Set<string> = new Set()\n): any {\n  // Handle circular references\n  const schemaKey = JSON.stringify(schema);\n  if (visited.has(schemaKey)) {\n    return null; // Return null for circular references\n  }\n  visited.add(schemaKey);\n\n  // Priority 1: Use default value if provided\n  if (schema.default !== undefined) {\n    return schema.default;\n  }\n\n  // Generate based on type\n  switch (schema.type) {\n    case \"string\":\n      return \"\";\n\n    case \"number\":\n    case \"integer\":\n      return 0;\n\n    case \"boolean\":\n      return false;\n\n    case \"null\":\n      return null;\n\n    case \"array\":\n      return []; // Empty array for template\n\n    case \"object\":\n      return generateObjectTemplate(schema, visited);\n\n    default:\n      // If no type specified, try to infer from properties\n      if (schema.properties) {\n        return generateObjectTemplate(schema, visited);\n      }\n      return null;\n  }\n}\n\n/**\n * Generate object template from schema properties\n * Creates an object with empty/default values for all properties\n *\n * @param schema - The JSON Schema with object type\n * @param visited - Set of visited schemas for circular reference detection\n * @returns An object with empty/default values for each property\n * @internal\n */\nfunction generateObjectTemplate(\n  schema: JSONSchema,\n  visited: Set<string>\n): Record<string, any> {\n  const result: Record<string, any> = {};\n\n  if (schema.properties) {\n    for (const [key, propSchema] of Object.entries(schema.properties)) {\n      // Include all properties in template (both required and optional)\n      result[key] = generateTemplateFromSchema(propSchema, visited);\n    }\n  }\n\n  return result;\n}\n\n/**\n * Resolve $ref references in a JSON Schema\n *\n * Recursively resolves JSON Schema $ref references by looking up referenced schemas\n * in the components object. Supports references in the format:\n * - `#/components/schemas/SchemaName`\n *\n * Handles circular references by detecting and preventing infinite recursion.\n * When a circular reference is detected, returns a placeholder object.\n *\n * @param schema - The JSON Schema to resolve references in\n * @param components - The components/schemas object containing referenced schemas\n * @param visited - Set of visited references to detect circular references\n * @returns Schema with all $ref references resolved\n * @example\n * ```typescript\n * const schema = { $ref: '#/components/schemas/User' };\n * const components = {\n *   User: { type: 'object', properties: { name: { type: 'string' } } }\n * };\n * const resolved = resolveSchemaRefs(schema, components);\n * // Returns: { type: 'object', properties: { name: { type: 'string' } } }\n * ```\n */\nexport function resolveSchemaRefs(\n  schema: JSONSchema,\n  components?: Record<string, JSONSchema>,\n  visited: Set<string> = new Set()\n): JSONSchema {\n  // If schema is null or undefined, return as-is\n  if (!schema || typeof schema !== \"object\") {\n    return schema;\n  }\n\n  // Handle $ref\n  if (schema.$ref) {\n    // Check for circular reference\n    if (visited.has(schema.$ref)) {\n      // Return a placeholder to prevent infinite recursion\n      return { type: \"object\", description: \"Circular reference detected\" };\n    }\n\n    visited.add(schema.$ref);\n\n    // Parse the $ref path\n    const refPath = schema.$ref;\n    let resolvedSchema: JSONSchema | undefined;\n\n    // Handle #/components/schemas/Name format\n    if (refPath.startsWith(\"#/components/schemas/\")) {\n      const schemaName = refPath.split(\"/\").pop();\n      if (schemaName && components && components[schemaName]) {\n        resolvedSchema = components[schemaName];\n      }\n    }\n\n    // If we found the referenced schema, resolve it recursively\n    if (resolvedSchema) {\n      return resolveSchemaRefs(resolvedSchema, components, visited);\n    }\n\n    // If we couldn't resolve the reference, return the original schema\n    return schema;\n  }\n\n  // Clone the schema to avoid mutating the original\n  const resolved: JSONSchema = { ...schema };\n\n  // Resolve $refs in properties\n  if (schema.properties) {\n    resolved.properties = {};\n    for (const [key, propSchema] of Object.entries(schema.properties)) {\n      resolved.properties[key] = resolveSchemaRefs(\n        propSchema,\n        components,\n        new Set(visited) // Create new visited set for each property to allow multiple paths\n      );\n    }\n  }\n\n  // Resolve $refs in items\n  if (schema.items) {\n    resolved.items = resolveSchemaRefs(\n      schema.items,\n      components,\n      new Set(visited)\n    );\n  }\n\n  // Resolve $refs in allOf\n  if (schema.allOf) {\n    resolved.allOf = schema.allOf.map((s) =>\n      resolveSchemaRefs(s, components, new Set(visited))\n    );\n  }\n\n  // Resolve $refs in anyOf\n  if (schema.anyOf) {\n    resolved.anyOf = schema.anyOf.map((s) =>\n      resolveSchemaRefs(s, components, new Set(visited))\n    );\n  }\n\n  // Resolve $refs in oneOf\n  if (schema.oneOf) {\n    resolved.oneOf = schema.oneOf.map((s) =>\n      resolveSchemaRefs(s, components, new Set(visited))\n    );\n  }\n\n  return resolved;\n}\n","/**\n * Request Body Editor Component\n * Provides Monaco Editor for editing API request bodies with JSON validation\n */\n\nimport React, { useEffect, useState, useCallback, useMemo } from \"react\";\nimport { MonacoEditorWrapper } from \"@/components/ui/monaco-editor-wrapper\";\nimport { generateExampleFromSchema, generateTemplateFromSchema, type JSONSchema } from \"@/lib/schema\";\nimport { validateJSON } from \"@/lib/validation\";\n\nexport interface RequestBodyEditorProps {\n  /** Request body schema definition */\n  schema?: JSONSchema;\n\n  /** Current JSON content */\n  value: string;\n\n  /** Content change callback */\n  onChange: (value: string) => void;\n\n  /** JSON validation error */\n  error?: string;\n\n  /** Editor height in pixels */\n  height?: number;\n\n  /** Theme (light/dark) */\n  theme?: \"vs-light\" | \"vs-dark\";\n\n  /** Force fallback to textarea (for testing) */\n  useFallback?: boolean;\n}\n\n/**\n * Request Body Editor with Monaco Editor integration\n */\nexport const RequestBodyEditor: React.FC<RequestBodyEditorProps> = ({\n  schema,\n  value,\n  onChange,\n  error,\n  height = 300,\n  theme = \"vs-light\",\n  useFallback = false,\n}) => {\n  const [initialized, setInitialized] = useState(false);\n  const [localError, setLocalError] = useState<string | null>(null);\n\n  // Generate initial value from schema if value is empty\n  const initialValue = useMemo(() => {\n    if (value && value.trim() !== \"\") {\n      return value;\n    }\n\n    if (!schema) {\n      return \"{}\";\n    }\n\n    if (schema.example !== undefined) {\n      return JSON.stringify(schema.example, null, 2);\n    }\n\n    if (schema.examples && schema.examples.length > 0) {\n      return JSON.stringify(schema.examples[0], null, 2);\n    }\n\n    if (schema.default !== undefined) {\n      return JSON.stringify(schema.default, null, 2);\n    }\n\n    try {\n      const example = generateExampleFromSchema(schema);\n      if (example !== null && example !== undefined) {\n        return JSON.stringify(example, null, 2);\n      }\n    } catch (err) {\n      console.warn(\"Failed to generate example from schema:\", err);\n    }\n\n    try {\n      const template = generateTemplateFromSchema(schema);\n      return JSON.stringify(template, null, 2);\n    } catch (err) {\n      console.warn(\"Failed to generate template from schema:\", err);\n    }\n\n    return \"{}\";\n  }, [schema, value]);\n\n  useEffect(() => {\n    if (!initialized) {\n      setInitialized(true);\n      if (!value || value.trim() === \"\") {\n        onChange(initialValue);\n      } else {\n        const validationError = validateJSON(value);\n        setLocalError(validationError);\n      }\n    }\n  }, [initialized, value, initialValue, onChange]);\n\n  const handleChange = useCallback(\n    (newValue: string) => {\n      onChange(newValue);\n      const validationError = validateJSON(newValue);\n      setLocalError(validationError);\n    },\n    [onChange]\n  );\n\n  const isDark = theme === \"vs-dark\";\n  const displayError = error || localError;\n\n  if (useFallback) {\n    return (\n      <div className=\"relative\">\n        <div className=\"mb-2 rounded-md bg-yellow-50 p-2 text-sm text-yellow-800 dark:bg-yellow-900/20 dark:text-yellow-200\">\n          JSON 编辑器加载失败，使用基本编辑器\n        </div>\n        <textarea\n          value={value}\n          onChange={(e) => {\n            const newValue = e.target.value;\n            handleChange(newValue);\n          }}\n          className=\"w-full rounded-md border border-gray-300 p-2 font-mono text-sm dark:border-gray-700 dark:bg-gray-900\"\n          style={{ height: `${height}px` }}\n          data-testid=\"fallback-textarea\"\n        />\n        {displayError && (\n          <div className=\"mt-2 text-sm text-red-600 dark:text-red-400\" role=\"alert\">\n            {displayError}\n          </div>\n        )}\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"relative\">\n      <div className=\"rounded-md border border-gray-200 dark:border-gray-700\" data-testid=\"request-body-editor\">\n        <MonacoEditorWrapper\n          value={value}\n          onChange={handleChange}\n          isDark={isDark}\n          height={height}\n          readOnly={false}\n        />\n      </div>\n      {displayError && (\n        <div className=\"mt-2 text-sm text-red-600 dark:text-red-400\" role=\"alert\">\n          {displayError}\n        </div>\n      )}\n    </div>\n  );\n};\n\nRequestBodyEditor.displayName = \"RequestBodyEditor\";\n","/**\n * Execute Button Component\n * Renders the execute/send request button with loading state and validation\n */\n\nimport React, { useCallback } from 'react';\nimport { Button } from '@/components/ui/button';\nimport { useI18n } from '@/contexts/I18nContext';\n\nexport interface ExecuteButtonProps {\n  /** Callback when execute button is clicked */\n  onExecute: () => void;\n\n  /** Whether the request is currently executing */\n  isExecuting: boolean;\n\n  /** Whether the button should be disabled */\n  disabled: boolean;\n\n  /** Reason why the button is disabled (for tooltip) */\n  disabledReason?: string;\n\n  /** Optional validation callback before executing */\n  onValidate?: () => boolean;\n\n  /** Error handler callback */\n  onError?: (error: Error) => void;\n}\n\n/**\n * Execute Button Component\n */\nexport const ExecuteButton: React.FC<ExecuteButtonProps> = ({\n  onExecute,\n  isExecuting,\n  disabled,\n  disabledReason,\n  onValidate,\n  onError,\n}) => {\n  const { t } = useI18n();\n  const handleClick = useCallback(async () => {\n    try {\n      if (onValidate) {\n        const isValid = onValidate();\n        if (!isValid) {\n          return;\n        }\n      }\n\n      onExecute();\n    } catch (error) {\n      console.error('Error executing request:', error);\n      if (onError && error instanceof Error) {\n        onError(error);\n      }\n    }\n  }, [onExecute, onValidate, onError]);\n\n  const isDisabled = disabled || isExecuting;\n\n  return (\n    <div className=\"flex justify-end border-t border-gray-200 pt-4 dark:border-gray-700\">\n      <Button\n        onClick={handleClick}\n        disabled={isDisabled}\n        title={disabled ? disabledReason : undefined}\n        aria-busy={isExecuting}\n        className=\"min-w-[120px]\"\n      >\n        {isExecuting ? (\n          <>\n            <span className=\"mr-2 inline-block h-4 w-4 animate-spin rounded-full border-2 border-current border-t-transparent\" data-testid=\"loading-spinner\" />\n            {t('executing')}\n          </>\n        ) : (\n          t('executeRequest')\n        )}\n      </Button>\n    </div>\n  );\n};\n\nExecuteButton.displayName = 'ExecuteButton';\n","import { getLocationForJsonPath, parseWithPointers } from \"@stoplight/json\";\nimport type { JSONSchema } from \"@/lib/schema\";\n\nexport type JsonFieldPath = Array<string | number>;\n\nexport interface JsonFieldDescription {\n  /** JSON 数据路径。 */\n  path: JsonFieldPath;\n  /** Monaco 使用的一基行号。 */\n  lineNumber: number;\n  /** Schema 中未经截断的完整说明。 */\n  description: string;\n  /** 适合在代码行尾展示的单行短说明。 */\n  inlineDescription: string;\n}\n\nconst DEFAULT_INLINE_DESCRIPTION_LENGTH = 72;\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return Boolean(value) && typeof value === \"object\" && !Array.isArray(value);\n}\n\nfunction decodeJsonPointerSegment(segment: string): string {\n  return decodeURIComponent(segment).replace(/~1/g, \"/\").replace(/~0/g, \"~\");\n}\n\nfunction resolveLocalRef(rootSchema: JSONSchema, ref: string): JSONSchema | undefined {\n  if (!ref.startsWith(\"#/\")) return undefined;\n\n  let current: unknown = rootSchema;\n  for (const segment of ref.slice(2).split(\"/\").map(decodeJsonPointerSegment)) {\n    if (!isRecord(current) || !(segment in current)) return undefined;\n    current = current[segment];\n  }\n\n  return isRecord(current) ? (current as JSONSchema) : undefined;\n}\n\nfunction dereferenceSchema(\n  schema: JSONSchema | undefined,\n  rootSchema: JSONSchema,\n  visitedRefs: Set<string>\n): JSONSchema | undefined {\n  if (!schema?.$ref || visitedRefs.has(schema.$ref)) return schema;\n\n  const resolved = resolveLocalRef(rootSchema, schema.$ref);\n  if (!resolved) return schema;\n\n  const nextVisitedRefs = new Set(visitedRefs);\n  nextVisitedRefs.add(schema.$ref);\n  return dereferenceSchema(resolved, rootSchema, nextVisitedRefs);\n}\n\nfunction findSchemaAtPath(\n  schema: JSONSchema | undefined,\n  path: JsonFieldPath,\n  rootSchema: JSONSchema,\n  visitedRefs: Set<string> = new Set()\n): JSONSchema | undefined {\n  const resolvedSchema = dereferenceSchema(schema, rootSchema, visitedRefs);\n  if (!resolvedSchema) return undefined;\n  if (path.length === 0) return resolvedSchema;\n\n  const compositeSchemas = [\n    ...(resolvedSchema.allOf ?? []),\n    ...(resolvedSchema.oneOf ?? []),\n    ...(resolvedSchema.anyOf ?? []),\n  ];\n  for (const compositeSchema of compositeSchemas) {\n    const match = findSchemaAtPath(\n      compositeSchema,\n      path,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n    if (match) return match;\n  }\n\n  const [segment, ...remainingPath] = path;\n  if (typeof segment === \"number\" && resolvedSchema.items) {\n    return findSchemaAtPath(\n      resolvedSchema.items,\n      remainingPath,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n  }\n\n  const propertySchema = resolvedSchema.properties?.[String(segment)];\n  if (propertySchema) {\n    return findSchemaAtPath(\n      propertySchema,\n      remainingPath,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n  }\n\n  if (isRecord(resolvedSchema.additionalProperties)) {\n    return findSchemaAtPath(\n      resolvedSchema.additionalProperties as JSONSchema,\n      remainingPath,\n      rootSchema,\n      new Set(visitedRefs)\n    );\n  }\n\n  return undefined;\n}\n\nfunction getSchemaDescription(\n  schema: JSONSchema | undefined,\n  rootSchema: JSONSchema,\n  visitedSchemas: Set<JSONSchema> = new Set()\n): string | undefined {\n  const resolvedSchema = dereferenceSchema(schema, rootSchema, new Set());\n  if (!resolvedSchema || visitedSchemas.has(resolvedSchema)) return undefined;\n\n  const description = resolvedSchema.description ?? resolvedSchema.title;\n  if (typeof description === \"string\" && description.trim()) return description;\n\n  const nextVisitedSchemas = new Set(visitedSchemas);\n  nextVisitedSchemas.add(resolvedSchema);\n  const compositeSchemas = [\n    ...(resolvedSchema.allOf ?? []),\n    ...(resolvedSchema.oneOf ?? []),\n    ...(resolvedSchema.anyOf ?? []),\n  ];\n  for (const compositeSchema of compositeSchemas) {\n    const compositeDescription = getSchemaDescription(\n      compositeSchema,\n      rootSchema,\n      nextVisitedSchemas\n    );\n    if (compositeDescription) return compositeDescription;\n  }\n\n  return undefined;\n}\n\nfunction collectObjectFieldPaths(\n  value: unknown,\n  parentPath: JsonFieldPath = [],\n  paths: JsonFieldPath[] = []\n): JsonFieldPath[] {\n  if (Array.isArray(value)) {\n    value.forEach((item, index) => {\n      collectObjectFieldPaths(item, [...parentPath, index], paths);\n    });\n    return paths;\n  }\n\n  if (!isRecord(value)) return paths;\n\n  Object.entries(value).forEach(([key, item]) => {\n    const path = [...parentPath, key];\n    paths.push(path);\n    collectObjectFieldPaths(item, path, paths);\n  });\n  return paths;\n}\n\nexport function normalizeInlineDescription(\n  description: string,\n  maxLength = DEFAULT_INLINE_DESCRIPTION_LENGTH\n): string {\n  const normalized = description.replace(/\\s+/g, \" \").trim();\n  if (normalized.length <= maxLength) return normalized;\n  return `${normalized.slice(0, Math.max(0, maxLength - 1)).trimEnd()}…`;\n}\n\n/**\n * 把实际 JSON 字段映射到响应 Schema，并返回可供 Monaco decoration 使用的行号和说明。\n * 无效 JSON、缺失 Schema 或没有描述时安全降级为空数组。\n */\nexport function getJsonFieldDescriptions(\n  jsonCode: string,\n  schema?: JSONSchema\n): JsonFieldDescription[] {\n  if (!jsonCode.trim() || !schema) return [];\n\n  try {\n    const parsed = parseWithPointers(jsonCode);\n    if (!parsed.ast || parsed.diagnostics.length > 0) return [];\n\n    const descriptionsByLine = new Map<number, JsonFieldDescription>();\n    for (const path of collectObjectFieldPaths(parsed.data)) {\n      const fieldSchema = findSchemaAtPath(schema, path, schema);\n      const rawDescription = getSchemaDescription(fieldSchema, schema);\n      if (!rawDescription) continue;\n\n      const location = getLocationForJsonPath(parsed, path);\n      if (!location?.range) continue;\n\n      const lineNumber = location.range.start.line + 1;\n      if (descriptionsByLine.has(lineNumber)) continue;\n\n      const description = rawDescription.trim();\n      descriptionsByLine.set(lineNumber, {\n        path,\n        lineNumber,\n        description,\n        inlineDescription: normalizeInlineDescription(description),\n      });\n    }\n\n    return [...descriptionsByLine.values()];\n  } catch {\n    return [];\n  }\n}\n","import { useEffect, useRef } from \"react\";\nimport type { Monaco, OnMount } from \"@monaco-editor/react\";\nimport type { JsonFieldDescription } from \"@/lib/schema-descriptions\";\n\ntype MonacoEditor = Parameters<OnMount>[0];\n\nexport interface MonacoFieldDescriptionContext {\n  editor: MonacoEditor;\n  monaco: Monaco;\n}\n\n/** 在 Monaco 行尾注入字段短说明，并为整行提供完整说明悬浮提示。 */\nexport function useMonacoFieldDescriptions(\n  context: MonacoFieldDescriptionContext | null,\n  descriptions: JsonFieldDescription[]\n): void {\n  const collectionRef = useRef<ReturnType<MonacoEditor[\"createDecorationsCollection\"]> | null>(null);\n\n  useEffect(() => {\n    collectionRef.current?.clear();\n    collectionRef.current = null;\n\n    const model = context?.editor.getModel();\n    if (!context || !model || descriptions.length === 0) return;\n\n    const decorations = descriptions.flatMap((item) => {\n      if (item.lineNumber < 1 || item.lineNumber > model.getLineCount()) return [];\n\n      const maxColumn = model.getLineMaxColumn(item.lineNumber);\n      return [{\n        range: new context.monaco.Range(item.lineNumber, 1, item.lineNumber, maxColumn),\n        options: {\n          hoverMessage: { value: item.description },\n          stickiness: context.monaco.editor.TrackedRangeStickiness.NeverGrowsWhenTypingAtEdges,\n          after: {\n            content: `  — ${item.inlineDescription}`,\n            inlineClassName: \"pontx-monaco-field-description\",\n            cursorStops: context.monaco.editor.InjectedTextCursorStops.None,\n          },\n        },\n      }];\n    });\n\n    collectionRef.current = context.editor.createDecorationsCollection(decorations);\n\n    return () => {\n      collectionRef.current?.clear();\n      collectionRef.current = null;\n    };\n  }, [context, descriptions]);\n}\n","/**\n * Results Display Component\n * Displays API execution results with status, headers, and response body\n */\n\nimport React, { useState, useCallback, useMemo } from 'react';\nimport type { OnMount } from '@monaco-editor/react';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Badge } from '@/components/ui/badge';\nimport { Button } from '@/components/ui/button';\nimport { MonacoEditorWrapper } from '@/components/ui/monaco-editor-wrapper';\nimport type { PlaygroundExecutionResult } from '@/types/playground';\nimport type { JSONSchema } from '@/lib/schema';\nimport { getJsonFieldDescriptions } from '@/lib/schema-descriptions';\nimport {\n  useMonacoFieldDescriptions,\n  type MonacoFieldDescriptionContext,\n} from '@/hooks/useMonacoFieldDescriptions';\nimport { useI18n } from '@/contexts/I18nContext';\n\nexport interface ResultsDisplayProps {\n  /** Execution result to display */\n  result?: PlaygroundExecutionResult;\n\n  /** Whether to use dark theme */\n  isDark?: boolean;\n\n  /** JSON Schema matching the actual response status */\n  responseSchema?: JSONSchema;\n}\n\n/**\n * Results Display Component\n */\nexport const ResultsDisplay: React.FC<ResultsDisplayProps> = ({\n  result,\n  isDark = false,\n  responseSchema,\n}) => {\n  const { t } = useI18n();\n  const [headersExpanded, setHeadersExpanded] = useState(false);\n  const [copyStatus, setCopyStatus] = useState<'idle' | 'success' | 'error'>('idle');\n  const [editorContext, setEditorContext] = useState<MonacoFieldDescriptionContext | null>(null);\n\n  const { status = 0, statusText = '', headers = {}, body, duration } = result ?? {};\n\n  const isSuccess = status >= 200 && status < 300;\n  const isError = status >= 400;\n\n  const formattedBody = useMemo(() => {\n    if (body === null || body === undefined) {\n      return '';\n    }\n\n    if (typeof body === 'string') {\n      try {\n        const parsed = JSON.parse(body);\n        return JSON.stringify(parsed, null, 2);\n      } catch {\n        return body;\n      }\n    }\n\n    return JSON.stringify(body, null, 2);\n  }, [body]);\n\n  const fieldDescriptions = useMemo(\n    () => getJsonFieldDescriptions(formattedBody, responseSchema),\n    [formattedBody, responseSchema]\n  );\n  useMonacoFieldDescriptions(editorContext, fieldDescriptions);\n\n  const handleEditorMount: OnMount = useCallback((editor, monaco) => {\n    setEditorContext({ editor, monaco });\n  }, []);\n\n  const handleCopy = useCallback(async () => {\n    try {\n      await navigator.clipboard.writeText(formattedBody);\n      setCopyStatus('success');\n\n      setTimeout(() => {\n        setCopyStatus('idle');\n      }, 3000);\n    } catch (error) {\n      console.error('Failed to copy to clipboard:', error);\n      setCopyStatus('error');\n\n      setTimeout(() => {\n        setCopyStatus('idle');\n      }, 3000);\n    }\n  }, [formattedBody]);\n\n  if (!result) {\n    return null;\n  }\n\n  return (\n    <div className=\"mt-6\" data-testid=\"results-display\">\n      <Card>\n        <CardHeader>\n          <div className=\"flex items-center justify-between\">\n            <CardTitle className=\"text-lg\">{t('responseResult')}</CardTitle>\n            <div className=\"flex items-center gap-2\">\n              {duration !== undefined && (\n                <span className=\"text-sm text-muted-foreground\">\n                  {duration} ms\n                </span>\n              )}\n              <Badge\n                data-testid=\"status-badge\"\n                className={\n                  isSuccess\n                    ? 'bg-green-500 hover:bg-green-600'\n                    : isError\n                    ? 'bg-red-500 hover:bg-red-600'\n                    : 'bg-gray-500 hover:bg-gray-600'\n                }\n              >\n                {status}\n              </Badge>\n              <span className=\"text-sm font-medium\">{statusText}</span>\n            </div>\n          </div>\n        </CardHeader>\n\n        <CardContent className=\"space-y-4\">\n          {/* Response Headers */}\n          <div>\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              onClick={() => setHeadersExpanded(!headersExpanded)}\n              className=\"mb-2 p-0 h-auto font-semibold hover:bg-transparent\"\n            >\n              {t('responseHeaders')} ({Object.keys(headers).length})\n              <span className=\"ml-2\">{headersExpanded ? '▼' : '▶'}</span>\n            </Button>\n\n            {headersExpanded && (\n              <div className=\"rounded-md border border-gray-200 dark:border-gray-700\">\n                <table className=\"w-full text-sm\">\n                  <tbody>\n                    {Object.entries(headers).map(([key, value]) => (\n                      <tr\n                        key={key}\n                        className=\"border-b border-gray-200 last:border-0 dark:border-gray-700\"\n                      >\n                        <td className=\"p-2 font-mono text-xs font-medium text-gray-600 dark:text-gray-400\">\n                          {key}\n                        </td>\n                        <td className=\"p-2 font-mono text-xs\">{value}</td>\n                      </tr>\n                    ))}\n                    {Object.keys(headers).length === 0 && (\n                      <tr>\n                        <td className=\"p-2 text-center text-gray-500\" colSpan={2}>\n                          {t('noResponseHeaders')}\n                        </td>\n                      </tr>\n                    )}\n                  </tbody>\n                </table>\n              </div>\n            )}\n          </div>\n\n          {/* Response Body */}\n          <div>\n            <div className=\"mb-2 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between\">\n              <div className=\"min-w-0\">\n                <h4 className=\"font-semibold\">{t('responseBody')}</h4>\n                {fieldDescriptions.length > 0 && (\n                  <p className=\"mt-1 text-xs leading-5 text-muted-foreground\">\n                    <span className=\"font-medium text-foreground/75\">\n                      {t('responseFieldDescriptions', { count: fieldDescriptions.length })}\n                    </span>\n                    <span aria-hidden=\"true\"> · </span>\n                    {t('responseFieldDescriptionsHint')}\n                  </p>\n                )}\n              </div>\n              <div className=\"flex items-center gap-2\">\n                {copyStatus === 'success' && (\n                  <span className=\"text-sm text-green-600 dark:text-green-400\">\n                    {t('copied')}\n                  </span>\n                )}\n                {copyStatus === 'error' && (\n                  <span className=\"text-sm text-red-600 dark:text-red-400\">\n                    {t('copyFailed')}\n                  </span>\n                )}\n                <Button\n                  variant=\"outline\"\n                  size=\"sm\"\n                  onClick={handleCopy}\n                  disabled={!formattedBody}\n                >\n                  {t('copyResponse')}\n                </Button>\n              </div>\n            </div>\n\n            <div className=\"rounded-md border border-gray-200 dark:border-gray-700\">\n              <MonacoEditorWrapper\n                value={formattedBody}\n                onChange={() => {}}\n                isDark={isDark}\n                height={300}\n                readOnly={true}\n                onMount={handleEditorMount}\n                options={{\n                  readOnly: true,\n                  domReadOnly: true,\n                  minimap: { enabled: false },\n                  ariaLabel: fieldDescriptions.length > 0\n                    ? `${t('responseBody')}，${t('responseFieldDescriptions', { count: fieldDescriptions.length })}`\n                    : t('responseBody'),\n                }}\n              />\n            </div>\n          </div>\n        </CardContent>\n      </Card>\n    </div>\n  );\n};\n\nResultsDisplay.displayName = 'ResultsDisplay';\n","/**\n * CodeSnippets 组件\n * 展示 CLI/SDK 等代码片段，支持场景切换和实时生成\n */\n\nimport React, { useState, useEffect, useCallback, useRef, useMemo } from 'react';\nimport { Button } from '@/components/ui/button';\nimport {\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from '@/components/ui/select';\nimport { MonacoEditorWrapper } from '@/components/ui/monaco-editor-wrapper';\nimport type { CodeGenScenario, CodeGenRequest, PlaygroundRequest } from '@/types/playground';\nimport { useI18n } from '@/contexts/I18nContext';\n\nexport interface CodeSnippetsProps {\n  /** 可用的代码生成场景列表 */\n  scenarios: CodeGenScenario[];\n  /** 当前请求参数快照 */\n  request: PlaygroundRequest;\n  /** 生成代码的回调 */\n  onGenerateCode: (req: CodeGenRequest) => string | Promise<string>;\n  /** 是否使用暗色主题 */\n  isDark?: boolean;\n}\n\n/**\n * CodeSnippets - 代码片段展示组件\n */\nexport const CodeSnippets: React.FC<CodeSnippetsProps> = ({\n  scenarios,\n  request,\n  onGenerateCode,\n  isDark = false,\n}) => {\n  const { t } = useI18n();\n  const [selectedScenarioId, setSelectedScenarioId] = useState<string>(\n    scenarios[0]?.id ?? ''\n  );\n  const [generatedCode, setGeneratedCode] = useState<string>('');\n  const [isGenerating, setIsGenerating] = useState<boolean>(false);\n  const [copyStatus, setCopyStatus] = useState<'idle' | 'success' | 'error'>('idle');\n\n  // 用于处理异步竞态\n  const generationIdRef = useRef(0);\n\n  const selectedScenario = useMemo(\n    () => scenarios.find((s) => s.id === selectedScenarioId) ?? scenarios[0],\n    [scenarios, selectedScenarioId]\n  );\n\n  // 序列化 request 用于 useEffect 依赖比较\n  const requestKey = useMemo(() => {\n    try {\n      return JSON.stringify(request);\n    } catch {\n      return '';\n    }\n  }, [request]);\n\n  // 实时生成代码\n  useEffect(() => {\n    if (!selectedScenario || !onGenerateCode) {\n      setGeneratedCode('');\n      return;\n    }\n\n    const currentId = ++generationIdRef.current;\n    setIsGenerating(true);\n\n    const codeGenRequest: CodeGenRequest = {\n      scenarioId: selectedScenario.id,\n      request,\n    };\n\n    try {\n      const result = onGenerateCode(codeGenRequest);\n\n      if (result instanceof Promise) {\n        result\n          .then((code) => {\n            if (generationIdRef.current === currentId) {\n              setGeneratedCode(code);\n              setIsGenerating(false);\n            }\n          })\n          .catch((error) => {\n            if (generationIdRef.current === currentId) {\n              console.error('代码生成失败:', error);\n              setGeneratedCode('// 代码生成失败');\n              setIsGenerating(false);\n            }\n          });\n      } else {\n        if (generationIdRef.current === currentId) {\n          setGeneratedCode(result);\n          setIsGenerating(false);\n        }\n      }\n    } catch (error) {\n      if (generationIdRef.current === currentId) {\n        console.error('代码生成失败:', error);\n        setGeneratedCode('// 代码生成失败');\n        setIsGenerating(false);\n      }\n    }\n  }, [selectedScenario, requestKey, onGenerateCode]);\n\n  // 场景变化时同步选中状态\n  useEffect(() => {\n    if (scenarios.length > 0 && !scenarios.find((s) => s.id === selectedScenarioId)) {\n      setSelectedScenarioId(scenarios[0].id);\n    }\n  }, [scenarios, selectedScenarioId]);\n\n  const handleCopy = useCallback(async () => {\n    try {\n      await navigator.clipboard.writeText(generatedCode);\n      setCopyStatus('success');\n      setTimeout(() => setCopyStatus('idle'), 3000);\n    } catch {\n      setCopyStatus('error');\n      setTimeout(() => setCopyStatus('idle'), 3000);\n    }\n  }, [generatedCode]);\n\n  if (scenarios.length === 0) {\n    return (\n      <div\n        className=\"text-sm text-muted-foreground text-center py-8\"\n        role=\"status\"\n      >\n        {t('noCodeScenarios')}\n      </div>\n    );\n  }\n\n  const lineCount = Math.max(1, generatedCode.split('\\n').length);\n  const editorHeight = Math.min(320, Math.max(112, lineCount * 20 + 36));\n\n  return (\n    <div data-testid=\"code-snippets\" aria-label={t('codeSnippets')}>\n      {/* 顶部工具栏 */}\n      <div className=\"flex items-center justify-between mb-2\">\n        <Select\n          value={selectedScenarioId}\n          onValueChange={setSelectedScenarioId}\n        >\n          <SelectTrigger\n            className=\"w-[180px]\"\n            aria-label={t('selectCodeScenario')}\n          >\n            <SelectValue placeholder=\"选择场景\" />\n          </SelectTrigger>\n          <SelectContent>\n            {scenarios.map((scenario) => (\n              <SelectItem key={scenario.id} value={scenario.id}>\n                {scenario.label}\n              </SelectItem>\n            ))}\n          </SelectContent>\n        </Select>\n\n        <div className=\"flex items-center gap-2\">\n          {copyStatus === 'success' && (\n            <span className=\"text-sm text-green-600 dark:text-green-400\">\n              {t('copied')}\n            </span>\n          )}\n          {copyStatus === 'error' && (\n            <span className=\"text-sm text-red-600 dark:text-red-400\">\n              {t('copyFailed')}\n            </span>\n          )}\n          <Button\n            variant=\"outline\"\n            size=\"sm\"\n            onClick={handleCopy}\n            disabled={!generatedCode || isGenerating}\n            aria-label={t('copyCode')}\n          >\n            {t('copyCode')}\n          </Button>\n        </div>\n      </div>\n\n      {/* 代码展示区 */}\n      {isGenerating ? (\n        <div\n          className=\"flex items-center justify-center py-8 rounded-md border border-gray-200 dark:border-gray-700\"\n          role=\"status\"\n          aria-live=\"polite\"\n        >\n          <span className=\"text-sm text-muted-foreground\">{t('generatingCode')}</span>\n        </div>\n      ) : (\n        <div className=\"overflow-h