+{"version":3,"file":"PlaygroundPanel-Dv6Ok6Kj.js","sources":["../src/lib/storage.ts","../src/playground/UrlConfiguration.tsx","../src/playground/AuthConfiguration.tsx","../src/playground/ParametersForm.tsx","../src/playground/PlaygroundPanel.tsx"],"sourcesContent":["/**\n * Storage utilities for API Playground\n * Provides localStorage-based persistence with error handling and memory fallback\n */\n\n// Type definitions\nexport interface PlaygroundConfig {\n  url: string;\n  auth?: AuthData;\n  pathParams: Record<string, string>;\n  queryParams: Record<string, string>;\n  headerParams: Record<string, string>;\n  requestBody?: string;\n  timestamp: number;\n}\n\nexport type AuthData =\n  | { type: 'apiKey'; name: string; value: string; in: string }\n  | { type: 'bearer'; token: string }\n  | { type: 'basic'; username: string; password: string }\n  | { type: 'oauth2'; token: string };\n\n// Memory fallback storage when localStorage is unavailable\nconst memoryStorage = new Map<string, string>();\n\n// Track if localStorage is available\nlet isLocalStorageAvailable: boolean | null = null;\n\n// Debounce timers\nconst debounceTimers = new Map<string, ReturnType<typeof setTimeout>>();\n\n/**\n * Check if localStorage is available\n */\nfunction checkLocalStorageAvailability(): boolean {\n  if (isLocalStorageAvailable !== null) {\n    return isLocalStorageAvailable;\n  }\n\n  try {\n    const testKey = '__storage_test__';\n    localStorage.setItem(testKey, 'test');\n    localStorage.removeItem(testKey);\n    isLocalStorageAvailable = true;\n    return true;\n  } catch (error) {\n    console.warn('localStorage is not available, using memory fallback');\n    isLocalStorageAvailable = false;\n    return false;\n  }\n}\n\n/**\n * Safe JSON stringify that handles circular references\n */\nfunction safeStringify(obj: unknown): string | null {\n  try {\n    return JSON.stringify(obj);\n  } catch (error) {\n    if (error instanceof TypeError && error.message.includes('circular')) {\n      console.warn('Cannot stringify object with circular references');\n      return null;\n    }\n    console.warn('Failed to stringify object:', error);\n    return null;\n  }\n}\n\n/**\n * Safe JSON parse with error handling\n */\nfunction safeParse<T>(json: string): T | null {\n  try {\n    return JSON.parse(json) as T;\n  } catch (error) {\n    console.warn('Failed to parse JSON from storage:', error);\n    return null;\n  }\n}\n\n/**\n * Get item from storage (localStorage or memory fallback)\n */\nfunction getItem(key: string): string | null {\n  if (checkLocalStorageAvailability()) {\n    try {\n      return localStorage.getItem(key);\n    } catch (error) {\n      console.warn('Failed to read from localStorage:', error);\n      return memoryStorage.get(key) || null;\n    }\n  }\n  return memoryStorage.get(key) || null;\n}\n\n/**\n * Set item in storage (localStorage or memory fallback)\n */\nfunction setItem(key: string, value: string): void {\n  if (checkLocalStorageAvailability()) {\n    try {\n      localStorage.setItem(key, value);\n      return;\n    } catch (error) {\n      // Handle QuotaExceededError\n      if (error instanceof DOMException && error.name === 'QuotaExceededError') {\n        console.warn('localStorage quota exceeded, falling back to memory storage');\n      } else {\n        console.warn('Failed to write to localStorage:', error);\n      }\n    }\n  }\n  // Fallback to memory storage\n  memoryStorage.set(key, value);\n}\n\n/**\n * Remove item from storage\n */\nfunction removeItem(key: string): void {\n  if (checkLocalStorageAvailability()) {\n    try {\n      localStorage.removeItem(key);\n    } catch (error) {\n      console.warn('Failed to remove from localStorage:', error);\n    }\n  }\n  memoryStorage.delete(key);\n}\n\n/**\n * Simple base64 encoding for auth data\n * Note: This is NOT secure encryption, just obfuscation\n */\nfunction encodeAuthData(data: string): string {\n  return btoa(data);\n}\n\n/**\n * Simple base64 decoding for auth data\n */\nfunction decodeAuthData(encoded: string): string {\n  try {\n    return atob(encoded);\n  } catch (error) {\n    console.warn('Failed to decode auth data:', error);\n    return '';\n  }\n}\n\n/**\n * Generate storage key for playground config\n */\nfunction getConfigKey(apiPath: string, apiMethod: string): string {\n  return `playground:${apiMethod}:${apiPath}:params`;\n}\n\n/**\n * Generate storage key for custom URL\n */\nfunction getCustomUrlKey(apiPath: string): string {\n  return `playground:${apiPath}:customUrl`;\n}\n\n/**\n * Generate storage key for spec base URL\n */\nfunction getSpecBaseUrlKey(specName: string): string {\n  return `playground:spec:${specName}:baseUrl`;\n}\n\n/**\n * Generate storage key for auth config\n */\nfunction getAuthKey(schemeName: string): string {\n  return `playground:auth:${schemeName}`;\n}\n\n/**\n * Debounced save function\n */\nfunction debouncedSave(key: string, value: string, delay: number = 500): void {\n  // Clear existing timer\n  const existingTimer = debounceTimers.get(key);\n  if (existingTimer) {\n    clearTimeout(existingTimer);\n  }\n\n  // Set new timer\n  const timer = setTimeout(() => {\n    setItem(key, value);\n    debounceTimers.delete(key);\n  }, delay);\n\n  debounceTimers.set(key, timer);\n}\n\n/**\n * Immediate save function (for non-debounced operations)\n */\nfunction immediateSave(key: string, value: string): void {\n  setItem(key, value);\n}\n\n/**\n * Save playground configuration\n */\nexport function savePlaygroundConfig(\n  apiPath: string,\n  apiMethod: string,\n  config: PlaygroundConfig\n): void {\n  const key = getConfigKey(apiPath, apiMethod);\n  const json = safeStringify(config);\n\n  if (json === null) {\n    console.warn('Failed to save playground config: invalid data');\n    return;\n  }\n\n  debouncedSave(key, json);\n}\n\n/**\n * Load playground configuration\n */\nexport function loadPlaygroundConfig(\n  apiPath: string,\n  apiMethod: string\n): PlaygroundConfig | null {\n  const key = getConfigKey(apiPath, apiMethod);\n  const json = getItem(key);\n\n  if (!json) {\n    return null;\n  }\n\n  return safeParse<PlaygroundConfig>(json);\n}\n\n/**\n * Save custom URL\n */\nexport function saveCustomUrl(apiPath: string, url: string): void {\n  const key = getCustomUrlKey(apiPath);\n  immediateSave(key, url);\n}\n\n/**\n * Load custom URL\n */\nexport function loadCustomUrl(apiPath: string): string | null {\n  const key = getCustomUrlKey(apiPath);\n  return getItem(key);\n}\n\n/**\n * Save spec base URL (shared across all APIs in the same spec)\n */\nexport function saveSpecBaseUrl(specName: string, url: string): void {\n  const key = getSpecBaseUrlKey(specName);\n  immediateSave(key, url);\n}\n\n/**\n * Load spec base URL\n */\nexport function loadSpecBaseUrl(specName: string): string | null {\n  const key = getSpecBaseUrlKey(specName);\n  return getItem(key);\n}\n\n/**\n * Save auth configuration\n */\nexport function saveAuthConfig(schemeName: string, auth: AuthData): void {\n  const key = getAuthKey(schemeName);\n  const json = safeStringify(auth);\n\n  if (json === null) {\n    console.warn('Failed to save auth config: invalid data');\n    return;\n  }\n\n  // Encode the auth data for basic obfuscation\n  const encoded = encodeAuthData(json);\n  immediateSave(key, encoded);\n}\n\n/**\n * Load auth configuration\n */\nexport function loadAuthConfig(schemeName: string): AuthData | null {\n  const key = getAuthKey(schemeName);\n  const encoded = getItem(key);\n\n  if (!encoded) {\n    return null;\n  }\n\n  const json = decodeAuthData(encoded);\n  if (!json) {\n    return null;\n  }\n\n  return safeParse<AuthData>(json);\n}\n\n/**\n * Clear playground configuration for a specific API\n */\nexport function clearPlaygroundConfig(apiPath: string, apiMethod: string): void {\n  const key = getConfigKey(apiPath, apiMethod);\n  removeItem(key);\n}\n","import React, { useEffect, useMemo, useState } from 'react';\nimport { Input } from '@/components/ui/input';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { Label } from '@/components/ui/label';\nimport { loadSpecBaseUrl, saveSpecBaseUrl } from '@/lib/storage';\nimport { useI18n } from '@/contexts/I18nContext';\n\n/**\n * Server definition from API specification\n */\nexport interface Server {\n  url: string;\n  description?: string;\n  variables?: Record<string, {\n    default: string;\n    enum?: string[];\n  }>;\n}\n\n/**\n * Props for UrlConfiguration component\n */\nexport interface UrlConfigurationProps {\n  /** Spec name for localStorage key (shared across all APIs in the same spec) */\n  specName: string;\n\n  /** API servers from specification */\n  servers?: Server[];\n\n  /** Current URL value */\n  value: string;\n\n  /** Callback when URL changes */\n  onChange: (url: string) => void;\n\n  /** API path (for display) */\n  apiPath: string;\n}\n\nconst CUSTOM_URL_VALUE = '__custom__';\n\n/**\n * Replace server URL variables with their default values\n */\nfunction replaceServerVariables(url: string, variables?: Record<string, { default: string }>): string {\n  if (!variables) {\n    return url;\n  }\n\n  let processedUrl = url;\n\n  for (const [key, config] of Object.entries(variables)) {\n    const placeholder = `{${key}}`;\n    processedUrl = processedUrl.replace(placeholder, config.default);\n  }\n\n  return processedUrl;\n}\n\n/**\n * UrlConfiguration component for environment URL selection and custom input\n */\nexport const UrlConfiguration: React.FC<UrlConfigurationProps> = ({\n  specName,\n  servers,\n  value,\n  onChange,\n  apiPath,\n}) => {\n  const { locale, t } = useI18n();\n  // Track whether user is using custom URL\n  const [isCustom, setIsCustom] = useState(false);\n  const [customUrl, setCustomUrl] = useState('');\n\n  // Process servers to replace variables with defaults\n  const processedServers = useMemo(() => {\n    return servers?.map(server => ({\n      ...server,\n      url: replaceServerVariables(server.url, server.variables),\n    })) || [];\n  }, [servers]);\n\n  // Load saved URL from localStorage on mount\n  useEffect(() => {\n    const savedUrl = loadSpecBaseUrl(specName);\n\n    if (savedUrl) {\n      // Check if saved URL matches any server\n      const matchingServer = processedServers.find(s => s.url === savedUrl);\n      if (matchingServer) {\n        setIsCustom(false);\n        onChange(savedUrl);\n      } else {\n        // It's a custom URL\n        setIsCustom(true);\n        setCustomUrl(savedUrl);\n        onChange(savedUrl);\n      }\n    } else if (processedServers.length > 0) {\n      // Default to first server\n      onChange(processedServers[0].url);\n      saveSpecBaseUrl(specName, processedServers[0].url);\n    }\n  }, [specName, processedServers]);\n\n  // Handle server selection change\n  const handleServerChange = (selectedValue: string) => {\n    if (selectedValue === CUSTOM_URL_VALUE) {\n      setIsCustom(true);\n      // Keep the current custom URL or use empty\n      const urlToUse = customUrl || '';\n      onChange(urlToUse);\n      if (urlToUse) {\n        saveSpecBaseUrl(specName, urlToUse);\n      }\n    } else {\n      setIsCustom(false);\n      onChange(selectedValue);\n      saveSpecBaseUrl(specName, selectedValue);\n    }\n  };\n\n  // Handle custom URL input change\n  const handleCustomUrlChange = (newUrl: string) => {\n    setCustomUrl(newUrl);\n    onChange(newUrl);\n    saveSpecBaseUrl(specName, newUrl);\n  };\n\n  // Get current select value\n  const selectValue = isCustom ? CUSTOM_URL_VALUE : value;\n\n  return (\n    <div className=\"space-y-3\">\n      <div className=\"space-y-2\">\n        <Label htmlFor=\"server-select\">Base URL</Label>\n        <Select value={selectValue} onValueChange={handleServerChange}>\n          <SelectTrigger id=\"server-select\">\n            <SelectValue placeholder={t('selectServer')} />\n          </SelectTrigger>\n          <SelectContent>\n            {processedServers.map((server) => (\n              <SelectItem key={server.url} value={server.url}>\n                <span className=\"flex items-center gap-2\">\n                  <span>{server.description || server.url}</span>\n                  {server.description && (\n                    <span className=\"text-xs text-muted-foreground\">\n                      {server.url}\n                    </span>\n                  )}\n                </span>\n              </SelectItem>\n            ))}\n            <SelectItem value={CUSTOM_URL_VALUE}>\n              <span className=\"text-muted-foreground\">{locale === 'zh-CN' ? '自定义 URL...' : 'Custom URL...'}</span>\n            </SelectItem>\n          </SelectContent>\n        </Select>\n      </div>\n\n      {/* Custom URL input (only when custom is selected) */}\n      {isCustom && (\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"custom-url-input\">{locale === 'zh-CN' ? '自定义 URL' : 'Custom URL'}</Label>\n          <Input\n            id=\"custom-url-input\"\n            type=\"text\"\n            placeholder=\"https://api.example.com\"\n            value={customUrl}\n            onChange={(e) => handleCustomUrlChange(e.target.value)}\n          />\n        </div>\n      )}\n\n      {/* Show full URL preview */}\n      <p className=\"text-xs text-muted-foreground font-mono truncate\" title={`${value}${apiPath}`}>\n        {value}{apiPath}\n      </p>\n    </div>\n  );\n};\n","import React, { useEffect, useMemo, useState } from 'react';\nimport { Input } from '@/components/ui/input';\nimport { Label } from '@/components/ui/label';\nimport { Button } from '@/components/ui/button';\nimport type {\n  AuthData,\n  OAuthAuthorizeInput,\n  OAuthAuthorizationState,\n  OAuthFlowName,\n} from '@/types/playground';\n\n/**\n * Security scheme type definitions based on OpenAPI Specification\n */\nexport type SecurityScheme =\n  | ApiKeySecurityScheme\n  | HttpSecurityScheme\n  | OAuth2SecurityScheme;\n\nexport interface ApiKeySecurityScheme {\n  type: 'apiKey';\n  name: string;\n  in: 'header' | 'query' | 'cookie';\n  description?: string;\n}\n\nexport interface HttpSecurityScheme {\n  type: 'http';\n  scheme: 'basic' | 'bearer';\n  description?: string;\n}\n\nexport interface OAuth2SecurityScheme {\n  type: 'oauth2';\n  flows: Partial<Record<OAuthFlowName, {\n    authorizationUrl?: string;\n    tokenUrl: string;\n    scopes: Record<string, string>;\n  }>>;\n  description?: string;\n}\n\nexport interface AuthConfigurationProps {\n  /** API specification security schemes definition */\n  securitySchemes?: Record<string, SecurityScheme>;\n\n  /** Current authentication configuration */\n  value: AuthData | undefined;\n\n  /** Callback when authentication configuration changes */\n  onChange: (auth: AuthData | undefined) => void;\n\n  /** Security scheme name for localStorage key (optional) */\n  schemeName?: string;\n  requiredScopes?: string[];\n  onOAuthAuthorize?: (input: OAuthAuthorizeInput) => void | Promise<void>;\n  onOAuthClear?: () => void;\n  oauthState?: OAuthAuthorizationState;\n}\n\n/**\n * AuthConfiguration Component\n *\n * Renders authentication configuration forms based on API security schemes.\n * Supports API Key, Bearer Token, Basic Auth, and OAuth2 authentication types.\n */\nexport const AuthConfiguration: React.FC<AuthConfigurationProps> = ({\n  securitySchemes,\n  value,\n  onChange,\n  requiredScopes = [],\n  onOAuthAuthorize,\n  onOAuthClear,\n  oauthState = { status: 'idle' },\n}) => {\n  // Don't render if no security schemes are defined\n  if (!securitySchemes || Object.keys(securitySchemes).length === 0) {\n    return null;\n  }\n\n  // Get the first security scheme (for now, we only support single scheme)\n  const schemeName = Object.keys(securitySchemes)[0];\n  const scheme = securitySchemes[schemeName];\n\n  // Render different forms based on security scheme type\n  const renderAuthForm = () => {\n    switch (scheme.type) {\n      case 'apiKey':\n        return renderApiKeyForm(scheme);\n      case 'http':\n        if (scheme.scheme === 'bearer') {\n          return renderBearerTokenForm();\n        } else if (scheme.scheme === 'basic') {\n          return renderBasicAuthForm();\n        }\n        return null;\n      case 'oauth2':\n        return <OAuth2Form\n          scheme={scheme}\n          schemeName={schemeName}\n          value={value}\n          onChange={onChange}\n          requiredScopes={requiredScopes}\n          onAuthorize={onOAuthAuthorize}\n          onClear={onOAuthClear}\n          state={oauthState}\n        />;\n      default:\n        return null;\n    }\n  };\n\n  const renderApiKeyForm = (scheme: ApiKeySecurityScheme) => {\n    const currentValue = value?.type === 'apiKey' ? value.value : '';\n\n    return (\n      <div className=\"space-y-2\">\n        <Label htmlFor=\"auth-apikey\">\n          {scheme.name}\n          <span className=\"ml-2 text-xs text-muted-foreground\">\n            (in {scheme.in})\n          </span>\n        </Label>\n        <Input\n          id=\"auth-apikey\"\n          type=\"password\"\n          placeholder={`Enter ${scheme.name}`}\n          value={currentValue}\n          onChange={(e) => {\n            onChange({\n              type: 'apiKey',\n              name: scheme.name,\n              value: e.target.value,\n              in: scheme.in,\n            });\n          }}\n        />\n        {scheme.description && (\n          <p className=\"text-xs text-muted-foreground\">{scheme.description}</p>\n        )}\n      </div>\n    );\n  };\n\n  const renderBearerTokenForm = () => {\n    const currentValue = value?.type === 'bearer' ? value.token : '';\n\n    return (\n      <div className=\"space-y-2\">\n        <Label htmlFor=\"auth-bearer\">Bearer Token</Label>\n        <Input\n          id=\"auth-bearer\"\n          type=\"password\"\n          placeholder=\"Enter bearer token\"\n          value={currentValue}\n          onChange={(e) => {\n            onChange({\n              type: 'bearer',\n              token: e.target.value,\n            });\n          }}\n        />\n      </div>\n    );\n  };\n\n  const renderBasicAuthForm = () => {\n    const currentUsername =\n      value?.type === 'basic' ? value.username : '';\n    const currentPassword =\n      value?.type === 'basic' ? value.password : '';\n\n    return (\n      <div className=\"space-y-4\">\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"auth-basic-username\">Username</Label>\n          <Input\n            id=\"auth-basic-username\"\n            type=\"text\"\n            placeholder=\"Enter username\"\n            value={currentUsername}\n            onChange={(e) => {\n              onChange({\n                type: 'basic',\n                username: e.target.value,\n                password: currentPassword,\n              });\n            }}\n          />\n        </div>\n        <div className=\"space-y-2\">\n          <Label htmlFor=\"auth-basic-password\">Password</Label>\n          <Input\n            id=\"auth-basic-password\"\n            type=\"password\"\n            placeholder=\"Enter password\"\n            value={currentPassword}\n            onChange={(e) => {\n              onChange({\n                type: 'basic',\n                username: currentUsername,\n                password: e.target.value,\n              });\n            }}\n          />\n        </div>\n      </div>\n    );\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      <h3 className=\"text-sm font-medium\">Authentication</h3>\n      {renderAuthForm()}\n    </div>\n  );\n};\n\ninterface OAuth2FormProps {\n  scheme: OAuth2SecurityScheme;\n  schemeName: string;\n  value?: AuthData;\n  onChange: (auth: AuthData | undefined) => void;\n  requiredScopes: string[];\n  onAuthorize?: (input: OAuthAuthorizeInput) => void | Promise<void>;\n  onClear?: () => void;\n  state: OAuthAuthorizationState;\n}\n\nconst OAuth2Form: React.FC<OAuth2FormProps> = ({\n  scheme, schemeName, value, onChange, requiredScopes, onAuthorize, onClear, state,\n}) => {\n  const flows = useMemo(() => Object.keys(scheme.flows).filter(\n    (flow): flow is OAuthFlowName => flow === 'authorizationCode' || flow === 'clientCredentials'\n  ), [scheme.flows]);\n  const [flow, setFlow] = useState<OAuthFlowName>(flows[0] ?? 'authorizationCode');\n  const [clientId, setClientId] = useState('');\n  const [clientSecret, setClientSecret] = useState('');\n  const availableScopes = Object.keys(scheme.flows[flow]?.scopes ?? {});\n  const [scopes, setScopes] = useState<string[]>(requiredScopes);\n  const [manualOpen, setManualOpen] = useState(flows.length === 0 || !onAuthorize);\n\n  useEffect(() => {\n    setScopes((current) => [...new Set([...current.filter((scope) => availableScopes.includes(scope)), ...requiredScopes])]);\n  }, [flow, requiredScopes.join('|'), availableScopes.join('|')]);\n\n  const busy = state.status === 'authorizing' || state.status === 'refreshing';\n  const authorized = state.status === 'authorized' || state.status === 'refreshing';\n\n  return <div className=\"space-y-3 rounded-md border border-border/70 bg-muted/20 p-3\">\n    {flows.length > 0 && onAuthorize ? <>\n      <div className=\"flex items-center justify-between gap-3\">\n        <div>\n          <p className=\"text-sm font-medium\">OAuth 2.0</p>\n          <p className=\"text-xs text-muted-foreground\">Credentials remain in this browser session.</p>\n        </div>\n        <span className={`text-xs font-medium ${authorized ? 'text-green-700' : state.status === 'error' ? 'text-red-700' : 'text-muted-foreground'}`} role=\"status\">\n          {state.status === 'authorized' ? 'Authorized' : state.status === 'refreshing' ? 'Refreshing…' : state.status === 'authorizing' ? 'Authorizing…' : state.status === 'error' ? 'Authorization failed' : 'Not authorized'}\n        </span>\n      </div>\n      {flows.length > 1 && <div className=\"space-y-1\">\n        <Label htmlFor=\"oauth-flow\">Grant type</Label>\n        <select id=\"oauth-flow\" className=\"flex h-9 w-full rounded-md border border-input bg-background px-3 text-sm\" value={flow} onChange={(event) => setFlow(event.target.value as OAuthFlowName)}>\n          {flows.map((item) => <option key={item} value={item}>{item === 'authorizationCode' ? 'Authorization Code' : 'Client Credentials'}</option>)}\n        </select>\n      </div>}\n      <div className=\"space-y-1\"><Label htmlFor=\"oauth-client-id\">Client ID</Label><Input id=\"oauth-client-id\" autoComplete=\"off\" value={clientId} onChange={(event) => setClientId(event.target.value)} /></div>\n      <div className=\"space-y-1\"><Label htmlFor=\"oauth-client-secret\">Client Secret <span className=\"text-xs text-muted-foreground\">(optional)</span></Label><Input id=\"oauth-client-secret\" type=\"password\" autoComplete=\"off\" value={clientSecret} onChange={(event) => setClientSecret(event.target.value)} /></div>\n      {availableScopes.length > 0 && <fieldset className=\"space-y-1.5\"><legend className=\"text-sm font-medium\">Scopes</legend>{availableScopes.map((scope) => <label key={scope} className=\"flex items-start gap-2 text-xs\"><input type=\"checkbox\" className=\"mt-0.5\" checked={scopes.includes(scope)} disabled={requiredScopes.includes(scope)} onChange={(event) => setScopes(event.target.checked ? [...scopes, scope] : scopes.filter((item) => item !== scope))} /><span><code>{scope}</code>{requiredScopes.includes(scope) && <span className=\"ml-1 text-muted-foreground\">required</span>}<span className=\"block text-muted-foreground\">{scheme.flows[flow]?.scopes[scope]}</span></span></label>)}</fieldset>}\n      {state.error && <p className=\"text-xs text-red-700\" role=\"alert\">{state.error}</p>}\n      <div className=\"flex flex-wrap gap-2\">\n        <Button type=\"button\" size=\"sm\" disabled={busy || !clientId} onClick={() => void onAuthorize({ schemeName, flow, clientId, clientSecret: clientSecret || undefined, scopes })}>{authorized ? 'Reauthorize' : 'Authorize'}</Button>\n        {authorized && <Button type=\"button\" size=\"sm\" variant=\"outline\" onClick={() => { onClear?.(); onChange(undefined); }}>Clear</Button>}\n        <Button type=\"button\" size=\"sm\" variant=\"ghost\" onClick={() => setManualOpen((open) => !open)} aria-expanded={manualOpen}>Use access token</Button>\n      </div>\n    </> : <p className=\"text-xs text-muted-foreground\">This API does not publish a supported OAuth authorization flow. Enter an existing access token.</p>}\n    {manualOpen && <div className=\"space-y-1 border-t border-border/70 pt-3\"><Label htmlFor=\"auth-oauth2\">Access Token</Label><Input id=\"auth-oauth2\" type=\"password\" placeholder=\"Enter OAuth2 access token\" value={value?.type === 'oauth2' ? value.token : ''} onChange={(event) => onChange({ type: 'oauth2', token: event.target.value })} /></div>}\n  </div>;\n};\n","import React, { useMemo, useState } from 'react';\nimport type { Parameter } from '@/types/playground';\nimport { Input } from '@/components/ui/input';\nimport { Badge } from '@/components/ui/badge';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';\nimport { Checkbox } from '@/components/ui/checkbox';\nimport { validateParameter } from '@/lib/validation';\nimport { getSchemaInputValue } from '@/lib/schema';\nimport { useI18n } from '@/contexts/I18nContext';\n\ntype Translate = (key: string, variables?: Record<string, string | number>) => string;\n\n/**\n * Props for ParametersForm component\n */\nexport interface ParametersFormProps {\n  /** API parameters definition */\n  parameters: Parameter[];\n\n  /** Current parameter values */\n  values: Record<string, string>;\n\n  /** Callback when parameter values change */\n  onChange: (values: Record<string, string>) => void;\n\n  /** Validation errors for parameters */\n  errors?: Record<string, string>;\n\n  /** Filter parameters by type (optional) */\n  parameterType?: 'path' | 'query' | 'header';\n}\n\n/**\n * Generate validation hint text for a parameter schema\n */\nfunction getValidationHint(schema: Parameter['schema'], t: Translate): string | null {\n  const hints: string[] = [];\n\n  if (schema.format) {\n    hints.push(`${t('format')}: ${schema.format}`);\n  }\n\n  if (schema.pattern) {\n    hints.push(`${t('pattern')}: ${schema.pattern}`);\n  }\n\n  if (schema.type === 'string') {\n    if (schema.minLength !== undefined && schema.maxLength !== undefined) {\n      hints.push(`${t('length')}: ${schema.minLength}-${schema.maxLength} ${t('characters')}`);\n    } else if (schema.minLength !== undefined) {\n      hints.push(`${t('minLength')}: ${schema.minLength} ${t('characters')}`);\n    } else if (schema.maxLength !== undefined) {\n      hints.push(`${t('maxLength')}: ${schema.maxLength} ${t('characters')}`);\n    }\n  }\n\n  if (schema.type === 'number') {\n    if (schema.minimum !== undefined && schema.maximum !== undefined) {\n      hints.push(`${t('range')}: ${schema.minimum}-${schema.maximum}`);\n    } else if (schema.minimum !== undefined) {\n      hints.push(`${t('minimum')}: ${schema.minimum}`);\n    } else if (schema.maximum !== undefined) {\n      hints.push(`${t('maximum')}: ${schema.maximum}`);\n    }\n  }\n\n  return hints.length > 0 ? hints.join(', ') : null;\n}\n\n/**\n * ParametersForm component\n * Renders dynamic parameter input forms grouped by type (path, query, header)\n */\nexport const ParametersForm: React.FC<ParametersFormProps> = ({\n  parameters,\n  values,\n  onChange,\n  errors = {},\n  parameterType,\n}) => {\n  const { t } = useI18n();\n  const [blurErrors, setBlurErrors] = useState<Record<string, string>>({});\n\n  const groupedParameters = useMemo(() => {\n    const filtered = parameterType\n      ? parameters.filter((p) => p.in === parameterType)\n      : parameters;\n\n    return {\n      path: filtered.filter((p) => p.in === 'path'),\n      query: filtered.filter((p) => p.in === 'query'),\n      header: filtered.filter((p) => p.in === 'header'),\n    };\n  }, [parameters, parameterType]);\n\n  const handleChange = (paramName: string, value: string) => {\n    onChange({\n      ...values,\n      [paramName]: value,\n    });\n\n    if (blurErrors[paramName] || errors[paramName]) {\n      setBlurErrors((prev) => {\n        const newErrors = { ...prev };\n        delete newErrors[paramName];\n        return newErrors;\n      });\n    }\n  };\n\n  const handleBlur = (parameter: Parameter) => {\n    const value = values[parameter.name] || '';\n    const error = validateParameter(value, parameter.schema, parameter.required ?? false);\n\n    if (error) {\n      setBlurErrors((prev) => ({\n        ...prev,\n        [parameter.name]: error,\n      }));\n    } else {\n      setBlurErrors((prev) => {\n        const newErrors = { ...prev };\n        delete newErrors[parameter.name];\n        return newErrors;\n      });\n    }\n  };\n\n  const allErrors = { ...blurErrors, ...errors };\n\n  const renderParameterInput = (param: Parameter) => {\n    const value = values[param.name] || '';\n    const error = allErrors[param.name];\n    const isRequired = param.required || false;\n    const validationHint = getValidationHint(param.schema, t);\n    const descriptionId = `${param.name}-description`;\n    const validationHintId = `${param.name}-hint`;\n    const errorId = `${param.name}-error`;\n    const describedBy = [\n      param.description ? descriptionId : null,\n      validationHint && !error ? validationHintId : null,\n      error ? errorId : null,\n    ]\n      .filter(Boolean)\n      .join(' ') || undefined;\n\n    const renderInput = () => {\n      if (param.schema.enum && param.schema.enum.length > 0) {\n        return (\n          <Select value={value} onValueChange={(val) => handleChange(param.name, val)}>\n            <SelectTrigger\n              id={param.name}\n              aria-required={isRequired}\n              aria-invalid={!!error}\n              aria-describedby={describedBy}\n            >\n              <SelectValue placeholder={t('selectValue')} />\n            </SelectTrigger>\n            <SelectContent>\n              {param.schema.enum.map((option) => (\n                <SelectItem key={option} value={option}>\n                  {option}\n                </SelectItem>\n              ))}\n            </SelectContent>\n          </Select>\n        );\n      }\n\n      if (param.schema.type === 'boolean') {\n        return (\n          <div className=\"flex items-center space-x-2\">\n            <Checkbox\n              id={param.name}\n              checked={value === 'true'}\n              onCheckedChange={(checked) => handleChange(param.name, checked ? 'true' : 'false')}\n              onBlur={() => handleBlur(param)}\n              aria-required={isRequired}\n              aria-invalid={!!error}\n              aria-describedby={describedBy}\n            />\n            <label\n              htmlFor={param.name}\n              className=\"text-sm font-medium leading-none peer-disabled:cursor-not-allowed peer-disabled:opacity-70\"\n            >\n              {param.name}\n            </label>\n          </div>\n        );\n      }\n\n      if (param.schema.type === 'number') {\n        return (\n          <Input\n            id={param.name}\n            type=\"number\"\n            value={value}\n            onChange={(e) => handleChange(param.name, e.target.value)}\n            onBlur={() => handleBlur(param)}\n            placeholder={getSchemaInputValue(param.schema) || t('enterParameter', { name: param.name })}\n            aria-label={param.name}\n            aria-required={isRequired}\n            aria-invalid={!!error}\n            aria-describedby={describedBy}\n          />\n        );\n      }\n\n      return (\n        <Input\n          id={param.name}\n          type=\"text\"\n          value={value}\n          onChange={(e) => handleChange(param.name, e.target.value)}\n          onBlur={() => handleBlur(param)}\n          placeholder={getSchemaInputValue(param.schema) || t('enterParameter', { name: param.name })}\n          aria-label={param.name}\n          aria-required={isRequired}\n          aria-invalid={!!error}\n          aria-describedby={describedBy}\n        />\n      );\n    };\n\n    return (\n      <div key={param.name} className=\"space-y-2\">\n        <label\n          htmlFor={param.name}\n          className=\"block text-sm font-medium text-gray-700 dark:text-gray-300\"\n        >\n          {param.name}\n          {isRequired && (\n            <Badge variant=\"destructive\" className=\"ml-2 text-xs\">\n              {t('required')}\n            </Badge>\n          )}\n          <span className=\"ml-2 text-xs text-gray-500\">\n            ({param.schema.type})\n          </span>\n        </label>\n\n        {renderInput()}\n\n        {param.description && (\n          <p id={descriptionId} className=\"text-xs text-gray-500 dark:text-gray-400\">\n            {param.description}\n          </p>\n        )}\n\n        {validationHint && !error && (\n          <p id={validationHintId} className=\"text-xs text-muted-foreground\">\n            {validationHint}\n          </p>\n        )}\n\n        {error && (\n          <p\n            id={errorId}\n            className=\"text-xs text-red-600 dark:text-red-400\"\n            role=\"alert\"\n            aria-live=\"polite\"\n          >\n            {error}\n          </p>\n        )}\n      </div>\n    );\n  };\n\n  const renderSection = (\n    title: string,\n    params: Parameter[],\n    _collapsible = false\n  ) => {\n    if (params.length === 0) return null;\n\n    const content = (\n      <div className=\"space-y-4\">\n        {params.map((param) => renderParameterInput(param))}\n      </div>\n    );\n\n    return (\n      <Card key={title} className=\"mb-4\">\n        <CardHeader>\n          <CardTitle className=\"text-base\">{title}</CardTitle>\n        </CardHeader>\n        <CardContent>{content}</CardContent>\n      </Card>\n    );\n  };\n\n  if (parameters.length === 0) {\n    return null;\n  }\n\n  return (\n    <div className=\"space-y-4\">\n      {renderSection(t('pathParameters'), groupedParameters.path)}\n      {renderSection(t('queryParameters'), groupedParameters.query)}\n      {renderSection(t('headers'), groupedParameters.header, true)}\n    </div>\n  );\n};\n","import React, { useState, useEffect, useCallback, useRef, useMemo } from 'react';\nimport type { PontxAPI } from '@pontx/spec';\nimport { CardContent, CardHeader, CardTitle } from '@/components/ui/card';\nimport { Button } from '@/components/ui/button';\nimport { Badge } from '@/components/ui/badge';\nimport { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';\nimport { X, AlertCircle, XCircle } from 'lucide-react';\nimport { UrlConfiguration, type Server } from './UrlConfiguration';\nimport { AuthConfiguration } from './AuthConfiguration';\nimport { ParametersForm } from './ParametersForm';\nimport { RequestBodyEditor } from './RequestBodyEditor';\nimport { ExecuteButton } from './ExecuteButton';\nimport { ResultsDisplay } from './ResultsDisplay';\nimport { CodeSnippets } from './CodeSnippets';\nimport {\n  loadPlaygroundConfig,\n  savePlaygroundConfig,\n  loadSpecBaseUrl,\n  type PlaygroundConfig,\n  type AuthData,\n} from '@/lib/storage';\nimport type {\n  PlaygroundRequest,\n  PlaygroundExecutionResult,\n  PlaygroundState,\n  ValidationError,\n  CodeGenScenario,\n  CodeGenRequest,\n  OAuthAuthorizeInput,\n  OAuthAuthorizationState,\n} from '@/types/playground';\nimport { useI18n } from '@/contexts/I18nContext';\nimport { getSchemaInputValue } from '@/lib/schema';\nimport type { JSONSchema } from '@/lib/schema';\n\n/**\n * Props for PlaygroundPanel component\n */\nexport interface PlaygroundPanelProps {\n  /** Whether the panel is visible */\n  visible: boolean;\n\n  /** Callback to change panel visibility */\n  onVisibleChange: (visible: boolean) => void;\n\n  /** API specification data */\n  api: PontxAPI;\n\n  /** Spec name for localStorage (shared base URL) */\n  specName: string;\n\n  /** Available servers from spec */\n  servers?: Server[];\n\n  /** Callback for executing API requests */\n  onExecute: (request: PlaygroundRequest) => void;\n\n  onOAuthAuthorize?: (input: OAuthAuthorizeInput) => void | Promise<void>;\n  onOAuthClear?: () => void;\n  oauthState?: OAuthAuthorizationState;\n  oauthAccessToken?: string;\n  oauthRequiredScopes?: string[];\n\n  /** API execution result */\n  executionResult?: PlaygroundExecutionResult;\n\n  /** Whether request is currently executing */\n  isExecuting: boolean;\n\n  /** Callback for validation errors */\n  onValidationError?: (errors: ValidationError[]) => void;\n\n  /** Callback for state changes */\n  onStateChange?: (state: PlaygroundState) => void;\n\n  /** 获取代码生成场景列表，不传则不显示代码 Tab */\n  getCodeGenScenarios?: () => CodeGenScenario[];\n\n  /** 根据请求参数和场景生成代码，不传则不显示代码 Tab */\n  onGenerateCode?: (req: CodeGenRequest) => string | Promise<string>;\n}\n\n/**\n * Validate API specification structure\n */\nfunction validateApiSpec(api: PontxAPI | null | undefined): string | null {\n  if (!api) {\n    return 'No API provided. Please select a valid API endpoint.';\n  }\n\n  if (!api.method) {\n    return 'Invalid API specification: method is required.';\n  }\n\n  if (!api.path) {\n    return 'Invalid API specification: path is required.';\n  }\n\n  return null;\n}\n\n/**\n * Validate execution result structure\n */\nfunction validateExecutionResult(result: unknown): boolean {\n  if (!result || typeof result !== 'object') return false;\n\n  const r = result as Record<string, unknown>;\n  const hasValidStructure =\n    r.status !== undefined ||\n    r.data !== undefined ||\n    r.error !== undefined ||\n    r.headers !== undefined;\n\n  return hasValidStructure;\n}\n\nfunction responseStatusMatches(candidate: string, status: number): boolean {\n  if (candidate === String(status)) return true;\n  return new RegExp(`^${String(status)[0]}[xX]{2}$`).test(candidate);\n}\n\nfunction getResponseSchema(api: PontxAPI, status?: number): JSONSchema | undefined {\n  if (status === undefined) return undefined;\n\n  const responses = Object.entries(api.responses ?? {});\n  const matchedResponse =\n    responses.find(([candidate]) => responseStatusMatches(candidate, status))?.[1] ??\n    responses.find(([candidate]) => candidate === 'default')?.[1];\n  if (!matchedResponse) return undefined;\n\n  const response = matchedResponse as {\n    schema?: JSONSchema;\n    content?: Record<string, { schema?: JSONSchema }>;\n  };\n  const contentSchema = response.content?.['application/json']?.schema ??\n    Object.values(response.content ?? {}).find((item) => item.schema)?.schema;\n  const schema = response.schema ?? contentSchema;\n  if (!schema) return undefined;\n\n  const components = (api as PontxAPI & {\n    components?: { schemas?: Record<string, JSONSchema> };\n  }).components;\n  return components?.schemas\n    ? { ...schema, components }\n    : schema;\n}\n\n/**\n * Detect circular references in schema\n */\nfunction hasCircularReference(obj: unknown, seen = new WeakSet()): boolean {\n  if (obj === null || typeof obj !== 'object') {\n    return false;\n  }\n\n  if (seen.has(obj as object)) {\n    return true;\n  }\n\n  seen.add(obj as object);\n\n  try {\n    for (const key in obj as Record<string, unknown>) {\n      if (Object.prototype.hasOwnProperty.call(obj, key)) {\n        if (hasCircularReference((obj as Record<string, unknown>)[key], seen)) {\n          return true;\n        }\n      }\n    }\n  } catch (e) {\n    return true;\n  }\n\n  return false;\n}\n\n/**\n * PlaygroundPanel - Main container for API testing interface\n */\nexport const PlaygroundPanel: React.FC<PlaygroundPanelProps> = ({\n  visible,\n  onVisibleChange,\n  api,\n  specName,\n  servers,\n  onExecute,\n  onOAuthAuthorize,\n  onOAuthClear,\n  oauthState,\n  oauthAccessToken,\n  oauthRequiredScopes,\n  executionResult,\n  isExecuting,\n  // eslint-disable-next-line @typescript-eslint/no-unused-vars\n  onValidationError: _onValidationError,\n  onStateChange,\n  getCodeGenScenarios,\n  onGenerateCode,\n}) => {\n  const { t } = useI18n();\n  // State management\n  const [url, setUrl] = useState<string>('');\n  const [auth, setAuth] = useState<AuthData | undefined>();\n\n  useEffect(() => {\n    if (oauthAccessToken) setAuth({ type: 'oauth2', token: oauthAccessToken });\n  }, [oauthAccessToken]);\n  const [pathParams, setPathParams] = useState<Record<string, string>>({});\n  const [queryParams, setQueryParams] = useState<Record<string, string>>({});\n  const [headerParams, setHeaderParams] = useState<Record<string, string>>({});\n  const [requestBody, setRequestBody] = useState<string>('');\n  const [localExecutionResult, setLocalExecutionResult] = useState<\n    PlaygroundExecutionResult | undefined\n  >(executionResult);\n  const responseSchema = useMemo(\n    () => getResponseSchema(api, localExecutionResult?.status),\n    [api, localExecutionResult?.status]\n  );\n\n  // Error state management\n  const [apiError, setApiError] = useState<string | null>(null);\n  const [storageError, setStorageError] = useState<string | null>(null);\n  const [resultError, setResultError] = useState<string | null>(null);\n\n  // Track previous API to detect changes\n  const prevApiRef = useRef<{ method: string; path: string } | null>(null);\n\n  // Track if this is initial load to prevent clearing on mount\n  const isInitialLoadRef = useRef(true);\n\n  // Ref for focus management\n  const closeButtonRef = useRef<HTMLButtonElement>(null);\n  const panelRef = useRef<HTMLDivElement>(null);\n\n  /**\n   * Validate API specification on mount/change\n   */\n  useEffect(() => {\n    const error = validateApiSpec(api);\n    setApiError(error);\n  }, [api]);\n\n  /**\n   * Load saved configuration from localStorage\n   */\n  const loadSavedConfig = useCallback(() => {\n    if (apiError) {\n      return;\n    }\n\n    try {\n      const savedConfig = loadPlaygroundConfig(api.path, api.method);\n\n      // URL 始终使用 spec 级别的共享配置，不使用 per-API 的旧 URL\n      const specUrl = loadSpecBaseUrl(specName);\n      const baseUrl = specUrl || servers?.[0]?.url || '';\n      setUrl(baseUrl);\n\n      if (savedConfig) {\n        setAuth(savedConfig.auth);\n        setPathParams(savedConfig.pathParams || {});\n        setQueryParams(savedConfig.queryParams || {});\n        setHeaderParams(savedConfig.headerParams || {});\n        setRequestBody(savedConfig.requestBody || '');\n      } else {\n        initializeDefaults();\n      }\n\n      setStorageError(null);\n    } catch (error) {\n      console.error('Failed to load playground configuration:', error);\n      setStorageError('Unable to load saved settings. Using default values.');\n      initializeDefaults();\n    }\n  }, [api.path, api.method, apiError, specName, servers]);\n\n  /**\n   * Initialize default values from API specification\n   */\n  const initializeDefaults = useCallback(() => {\n    if (!api || apiError) {\n      return;\n    }\n\n    // Load saved base URL from spec, or use first server\n    const savedUrl = loadSpecBaseUrl(specName);\n    const defaultUrl = savedUrl || servers?.[0]?.url || '';\n    setUrl(defaultUrl);\n\n    const defaultPath: Record<string, string> = {};\n    const defaultQuery: Record<string, string> = {};\n    const defaultHeaders: Record<string, string> = {};\n\n    if (api.parameters && api.parameters.length > 0) {\n      api.parameters.forEach((param) => {\n        if (param.schema && hasCircularReference(param.schema)) {\n          console.warn(`Parameter \"${param.name}\" has circular reference in schema, skipping defaults`);\n          return;\n        }\n\n        const defaultValue = getSchemaInputValue(param.schema);\n\n        if (param.in === 'path') {\n          defaultPath[param.name] = defaultValue;\n        } else if (param.in === 'query') {\n          defaultQuery[param.name] = defaultValue;\n        } else if (param.in === 'header') {\n          defaultHeaders[param.name] = defaultValue;\n        }\n      });\n    }\n\n    setPathParams(defaultPath);\n    setQueryParams(defaultQuery);\n    setHeaderParams(defaultHeaders);\n\n    setAuth(undefined);\n    setRequestBody('');\n  }, [api, apiError, specName, servers]);\n\n  /**\n   * Save current configuration to localStorage\n   */\n  const saveCurrentConfig = useCallback(() => {\n    if (apiError) {\n      return;\n    }\n\n    try {\n      const config: PlaygroundConfig = {\n        url,\n        auth,\n        pathParams,\n        queryParams,\n        headerParams,\n        requestBody: requestBody || undefined,\n        timestamp: Date.now(),\n      };\n\n      savePlaygroundConfig(api.path, api.method, config);\n      setStorageError(null);\n    } catch (error) {\n      const isDOMException = error instanceof DOMException;\n      const isQuotaError =\n        isDOMException &&\n        (error.name === 'QuotaExceededError' || error.name === 'NS_ERROR_DOM_QUOTA_REACHED');\n\n      if (isQuotaError) {\n        console.warn('localStorage quota exceeded');\n        setStorageError('Storage quota exceeded. Settings cannot be saved.');\n      } else {\n        console.error('Failed to save playground configuration:', error);\n        setStorageError('Settings cannot be saved. localStorage may be disabled.');\n      }\n    }\n  }, [url, auth, pathParams, queryParams, headerParams, requestBody, api.path, api.method, apiError]);\n\n  /**\n   * Detect API changes and reset configuration\n   */\n  useEffect(() => {\n    const currentApi = { method: api.method, path: api.path };\n    const prevApi = prevApiRef.current;\n\n    const hasApiChanged = prevApi && (\n      prevApi.method !== currentApi.method ||\n      prevApi.path !== currentApi.path\n    );\n\n    if (hasApiChanged) {\n      setLocalExecutionResult(undefined);\n      loadSavedConfig();\n    } else if (isInitialLoadRef.current) {\n      loadSavedConfig();\n      isInitialLoadRef.current = false;\n    }\n\n    prevApiRef.current = currentApi;\n  }, [api.method, api.path, loadSavedConfig]);\n\n  /**\n   * Clear results when any parameter changes\n   */\n  const clearResultsIfNeeded = useCallback(() => {\n    if (!isInitialLoadRef.current && localExecutionResult) {\n      setLocalExecutionResult(undefined);\n    }\n  }, [localExecutionResult]);\n\n  useEffect(() => {\n    clearResultsIfNeeded();\n  }, [url, pathParams, queryParams, headerParams, requestBody, auth]);\n\n  /**\n   * Save configuration when parameters change\n   */\n  useEffect(() => {\n    if (!isInitialLoadRef.current) {\n      saveCurrentConfig();\n    }\n  }, [saveCurrentConfig]);\n\n  /**\n   * Sync external execution result with local state\n   */\n  useEffect(() => {\n    if (executionResult) {\n      if (validateExecutionResult(executionResult)) {\n        setLocalExecutionResult(executionResult);\n        setResultError(null);\n      } else {\n        console.error('Invalid execution result structure:', executionResult);\n        setResultError('Invalid response format. The API response structure is unexpected.');\n        setLocalExecutionResult(undefined);\n      }\n    }\n  }, [executionResult]);\n\n  /**\n   * Focus management - Set focus when panel becomes visible\n   */\n  useEffect(() => {\n    if (visible && closeButtonRef.current) {\n      closeButtonRef.current.focus();\n    }\n  }, [visible]);\n\n  /**\n   * Keyboard shortcuts - Handle Escape key\n   */\n  useEffect(() => {\n    if (!visible) return;\n\n    const handleKeyDown = (event: KeyboardEvent) => {\n      if (event.key === 'Escape') {\n        const target = event.target as HTMLElement;\n        const isInEditor = target.closest('.monaco-editor');\n\n        if (!isInEditor) {\n          event.preventDefault();\n          onVisibleChange(false);\n        }\n      }\n    };\n\n    document.addEventListener('keydown', handleKeyDown);\n\n    return () => {\n      document.removeEventListener('keydown', handleKeyDown);\n    };\n  }, [visible, onVisibleChange]);\n\n  /**\n   * Notify parent of state changes\n   */\n  useEffect(() => {\n    if (onStateChange) {\n      onStateChange({\n        isOpen: visible,\n        parameters: {\n          url,\n          pathParams,\n          queryParams,\n          headerParams,\n          requestBody,\n          auth,\n        },\n      });\n    }\n  }, [visible, url, pathParams, queryParams, headerParams, requestBody, auth, onStateChange]);\n\n  /**\n   * 当前请求参数快照，供 handleExecute 和 CodeSnippets 复用\n   */\n  const currentRequest = useMemo<PlaygroundRequest>(() => ({\n    url,\n    method: api.method,\n    apiPath: api.path,\n    path: pathParams,\n    query: queryParams,\n    headers: headerParams,\n    body: requestBody ? (() => { try { return JSON.parse(requestBody); } catch { return undefined; } })() : undefined,\n    auth,\n  }), [url, api.method, api.path, pathParams, queryParams, headerParams, requestBody, auth]);\n\n  /**\n   * 代码生成场景列表\n   */\n  const codeGenScenarios = useMemo(() => {\n    return getCodeGenScenarios ? getCodeGenScenarios() : [];\n  }, [getCodeGenScenarios]);\n\n  const hasCodeGen = !!(onGenerateCode && codeGenScenarios.length > 0);\n\n  /**\n   * Handle execute button click\n   */\n  const handleExecute = useCallback(() => {\n    saveCurrentConfig();\n    onExecute(currentRequest);\n  }, [currentRequest, onExecute, saveCurrentConfig]);\n\n  /**\n   * Handle panel close\n   */\n  const handleClose = useCallback(() => {\n    onVisibleChange(false);\n  }, [onVisibleChange]);\n\n  if (!visible) {\n    return null;\n  }\n\n  const dismissStorageError = () => {\n    setStorageError(null);\n  };\n\n  const dismissResultError = () => {\n    setResultError(null);\n  };\n\n  return (\n    <div\n      ref={panelRef}\n      className=\"h-full flex flex-col bg-background\"\n      role=\"complementary\"\n      aria-label={t('apiTestingPlayground')}\n    >\n      {/* Header */}\n      <CardHeader className=\"flex flex-row items-center justify-between space-y-0 px-0 pt-0 pb-4\">\n        <CardTitle className=\"text-lg\" id=\"playground-title\">\n          {api?.method || 'Unknown'} {api?.path || 'Unknown'}\n        </CardTitle>\n        <Button\n          ref={closeButtonRef}\n          variant=\"ghost\"\n          size=\"icon\"\n          onClick={handleClose}\n          aria-label={t('closePlayground')}\n        >\n          <X className=\"h-4 w-4\" />\n        </Button>\n      </CardHeader>\n\n      {/* Content */}\n      <CardContent className=\"flex-1 overflow-y-auto space-y-6 px-0 pt-0\">\n        {/* API Error */}\n        {apiError && (\n          <div\n            className=\"flex items-start gap-3 p-4 border border-red-200 bg-red-50 rounded-md dark:border-red-900 dark:bg-red-950\"\n            role=\"alert\"\n            aria-live=\"polite\"\n          >\n            <AlertCircle className=\"h-5 w-5 text-red-600 dark:text-red-400 mt-0.5 flex-shrink-0\" />\n            <div className=\"flex-1\">\n              <p className=\"text-sm font-medium text-red-800 dark:text-red-200\">\n                Invalid API Specification\n              </p>\n              <p className=\"text-sm text-red-700 dark:text-red-300 mt-1\">\n                {apiError}\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* Storage Error */}\n        {storageError && !apiError && (\n          <div\n            className=\"flex items-start gap-3 p-4 border border-yellow-200 bg-yellow-50 rounded-md dark:border-yellow-900 dark:bg-yellow-950\"\n            role=\"alert\"\n            aria-live=\"polite\"\n          >\n            <AlertCircle className=\"h-5 w-5 text-yellow-600 dark:text-yellow-400 mt-0.5 flex-shrink-0\" />\n            <div className=\"flex-1\">\n              <p className=\"text-sm font-medium text-yellow-800 dark:text-yellow-200\">\n                Storage Warning\n              </p>\n              <p className=\"text-sm text-yellow-700 dark:text-yellow-300 mt-1\">\n                {storageError}\n              </p>\n            </div>\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              onClick={dismissStorageError}\n              aria-label=\"Dismiss storage warning\"\n              className=\"h-6 w-6 p-0 hover:bg-yellow-100 dark:hover:bg-yellow-900\"\n            >\n              <XCircle className=\"h-4 w-4\" />\n            </Button>\n          </div>\n        )}\n\n        {/* Result Error */}\n        {resultError && !apiError && (\n          <div\n            className=\"flex items-start gap-3 p-4 border border-red-200 bg-red-50 rounded-md dark:border-red-900 dark:bg-red-950\"\n            role=\"alert\"\n            aria-live=\"polite\"\n          >\n            <AlertCircle className=\"h-5 w-5 text-red-600 dark:text-red-400 mt-0.5 flex-shrink-0\" />\n            <div className=\"flex-1\">\n              <p className=\"text-sm font-medium text-red-800 dark:text-red-200\">\n                Invalid Response\n              </p>\n              <p className=\"text-sm text-red-700 dark:text-red-300 mt-1\">\n                {resultError}\n              </p>\n            </div>\n            <Button\n              variant=\"ghost\"\n              size=\"sm\"\n              onClick={dismissResultError}\n              aria-label=\"Dismiss result error\"\n              className=\"h-6 w-6 p-0 hover:bg-red-100 dark:hover:bg-red-900\"\n            >\n              <XCircle className=\"h-4 w-4\" />\n            </Button>\n          </div>\n        )}\n\n        {/* Only render form if API is valid */}\n        {!apiError && (\n          <>\n            {/* URL Configuration */}\n            <UrlConfiguration\n              specName={specName}\n              servers={servers}\n              value={url}\n              onChange={setUrl}\n              apiPath={api.path}\n            />\n\n            {/* Authentication Configuration */}\n            {(api as any).securitySchemes && (\n              <AuthConfiguration\n                securitySchemes={(api as any).securitySchemes}\n                value={auth}\n                onChange={setAuth}\n                schemeName={Object.keys((api as any).securitySchemes)[0]}\n                onOAuthAuthorize={onOAuthAuthorize}\n                onOAuthClear={onOAuthClear}\n                oauthState={oauthState}\n                requiredScopes={oauthRequiredScopes}\n              />\n            )}\n\n            {/* Path Parameters */}\n            {api.parameters?.some((p) => p.in === 'path') && (\n              <ParametersForm\n                parameters={api.parameters.filter((p) => p.in === 'path') as any}\n                values={pathParams}\n                onChange={setPathParams}\n                parameterType=\"path\"\n              />\n            )}\n\n            {/* Query Parameters */}\n            {api.parameters?.some((p) => p.in === 'query') && (\n              <ParametersForm\n                parameters={api.parameters.filter((p) => p.in === 'query') as any}\n                values={queryParams}\n                onChange={setQueryParams}\n                parameterType=\"query\"\n              />\n            )}\n\n            {/* Header Parameters */}\n            {api.parameters?.some((p) => p.in === 'header') && (\n              <ParametersForm\n                parameters={api.parameters.filter((p) => p.in === 'header') as any}\n                values={headerParams}\n                onChange={setHeaderParams}\n                parameterType=\"header\"\n              />\n            )}\n\n            {/* Request Body */}\n            {(api as any).requestBody && (\n              <div className=\"space-y-2\">\n                <h3 className=\"te