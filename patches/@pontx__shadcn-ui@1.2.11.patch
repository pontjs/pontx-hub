nter\">\n        <div className=\"text-center text-destructive\">\n          <p className=\"text-lg mb-2\">加载失败</p>\n          <p className=\"text-sm text-muted-foreground\">{error}</p>\n        </div>\n      </div>\n    );\n  }\n\n  /* 当前选中的 schema */\n  const selectedSchema = selectedSchemaName && schemas ? schemas[selectedSchemaName] : undefined;\n\n  return (\n    <div className=\"min-h-screen bg-background\">\n      {/* 头部 */}\n      <header className=\"border-b bg-card\">\n        <div className=\"px-4 py-3 flex items-center justify-between\">\n          <h1 className=\"text-xl font-bold\">Pontx API 文档</h1>\n          {specList.length > 1 && (\n            <Select\n              value={currentSpecName}\n              onValueChange={handleSpecSwitch}\n            >\n              <SelectTrigger className=\"w-auto min-w-52\" aria-label=\"切换 API 规范\">\n                <SelectValue>{currentSpecName}</SelectValue>\n              </SelectTrigger>\n              <SelectContent>\n                {specList.map((s) => (\n                  <SelectItem key={s.name} value={s.name}>\n                    {s.name} ({s.apiCount} APIs)\n                  </SelectItem>\n                ))}\n              </SelectContent>\n            </Select>\n          )}\n        </div>\n      </header>\n\n      {/* 主体 */}\n      {currentSpec && (\n        <div className=\"flex h-[calc(100vh-53px)]\">\n          {/* 左侧目录 */}\n          <aside className=\"w-72 border-r bg-card shrink-0 flex flex-col\">\n            <ApiDirectory\n              spec={currentSpec as PontxSpec}\n              selectedApiName={selectedApiName}\n              onApiSelect={handleApiSelect}\n              className=\"flex-1 min-h-0\"\n            />\n\n            {/* Schemas 列表 */}\n            {schemaNames.length > 0 && (\n              <div className=\"border-t border-border\">\n                <div className=\"px-3 py-2 text-xs font-medium text-muted-foreground uppercase tracking-wider\">\n                  数据结构\