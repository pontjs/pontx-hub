+{"version":3,"file":"App-Dvy4hN5d.js","sources":["../src/components/ui/collapsible.tsx","../src/components/ui/loading-spinner.tsx","../src/components/ui/status-badge.tsx","../src/components/ui/empty-state.tsx","../src/components/ui/separator.tsx","../src/app/hooks/useSpecs.ts","../src/app/hooks/useCodeGen.ts","../src/app/hooks/useUrlRoute.ts","../src/app/App.tsx"],"sourcesContent":["import * as React from \"react\";\nimport * as CollapsiblePrimitive from \"@radix-ui/react-collapsible\";\nimport { ChevronDown } from \"lucide-react\";\n\nimport { cn } from \"@/utils/cn\";\n\nconst Collapsible = CollapsiblePrimitive.Root;\n\nexport interface CollapsibleTriggerProps\n  extends React.ComponentPropsWithoutRef<typeof CollapsiblePrimitive.Trigger> {\n  showChevron?: boolean;\n}\n\nconst CollapsibleTrigger = React.forwardRef<\n  React.ElementRef<typeof CollapsiblePrimitive.Trigger>,\n  CollapsibleTriggerProps\n>(({ className, children, showChevron = true, ...props }, ref) => (\n  <CollapsiblePrimitive.Trigger\n    ref={ref}\n    className={cn(\n      \"group/collapsible-trigger flex w-full items-center justify-between gap-3 text-left transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 [&[data-state=open]>svg]:rotate-180\",\n      className\n    )}\n    {...props}\n  >\n    {children}\n    {showChevron ? (\n      <ChevronDown\n        aria-hidden=\"true\"\n        className=\"h-4 w-4 shrink-0 text-muted-foreground transition-transform duration-200\"\n      />\n    ) : null}\n  </CollapsiblePrimitive.Trigger>\n));\nCollapsibleTrigger.displayName = CollapsiblePrimitive.Trigger.displayName;\n\nconst CollapsibleContent = React.forwardRef<\n  React.ElementRef<typeof CollapsiblePrimitive.Content>,\n  React.ComponentPropsWithoutRef<typeof CollapsiblePrimitive.Content>\n>(({ className, ...props }, ref) => (\n  <CollapsiblePrimitive.Content\n    ref={ref}\n    className={cn(\"overflow-hidden\", className)}\n    {...props}\n  />\n));\nCollapsibleContent.displayName = CollapsiblePrimitive.Content.displayName;\n\nexport { Collapsible, CollapsibleTrigger, CollapsibleContent };\n","import React from \"react\";\nimport { cn } from \"@/utils/cn\";\n\ninterface LoadingSpinnerProps {\n  /** 加载文本 */\n  text?: string;\n  /** 自定义样式类名 */\n  className?: string;\n  /** 尺寸 */\n  size?: \"sm\" | \"md\" | \"lg\";\n}\n\nexport const LoadingSpinner: React.FC<LoadingSpinnerProps> = ({\n  text = \"加载中...\",\n  className = \"\",\n  size = \"md\",\n}) => {\n  const sizeClasses = {\n    sm: \"h-4 w-4\",\n    md: \"h-8 w-8\",\n    lg: \"h-12 w-12\",\n  };\n\n  return (\n    <div className={cn(\"flex items-center justify-center py-12\", className)}>\n      <div className=\"flex flex-col items-center space-y-3\">\n        <div\n          className={cn(\n            \"animate-spin rounded-full border-b-2 border-primary\",\n            sizeClasses[size]\n          )}\n        ></div>\n        {text && <span className=\"text-sm text-muted-foreground\">{text}</span>}\n      </div>\n    </div>\n  );\n};\n\nexport default LoadingSpinner;\n","import * as React from \"react\";\nimport { cva, type VariantProps } from \"class-variance-authority\";\n\nimport { cn } from \"@/utils/cn\";\n\nconst statusBadgeVariants = cva(\n  \"inline-flex min-h-6 items-center gap-1.5 rounded-full border px-2.5 text-[11px] font-semibold leading-none\",\n  {\n    variants: {\n      tone: {\n        neutral: \"border-border bg-muted text-muted-foreground\",\n        info: \"border-info/20 bg-info-subtle text-info-foreground\",\n        success: \"border-success/20 bg-success-subtle text-success-foreground\",\n        warning: \"border-warning/25 bg-warning-subtle text-warning-foreground\",\n        danger: \"border-destructive/20 bg-destructive/5 text-destructive\",\n      },\n    },\n    defaultVariants: { tone: \"neutral\" },\n  }\n);\n\nexport interface StatusBadgeProps\n  extends React.HTMLAttributes<HTMLSpanElement>,\n    VariantProps<typeof statusBadgeVariants> {\n  showDot?: boolean;\n}\n\nconst StatusBadge = React.forwardRef<HTMLSpanElement, StatusBadgeProps>(\n  ({ className, tone, showDot = false, children, ...props }, ref) => (\n    <span\n      ref={ref}\n      className={cn(statusBadgeVariants({ tone }), className)}\n      {...props}\n    >\n      {showDot ? (\n        <span className=\"h-1.5 w-1.5 rounded-full bg-current\" aria-hidden=\"true\" />\n      ) : null}\n      {children}\n    </span>\n  )\n);\nStatusBadge.displayName = \"StatusBadge\";\n\nexport { StatusBadge, statusBadgeVariants };\n","import * as React from \"react\";\n\nimport { cn } from \"@/utils/cn\";\n\nexport interface EmptyStateProps\n  extends Omit<React.HTMLAttributes<HTMLDivElement>, \"title\"> {\n  icon?: React.ReactNode;\n  title: React.ReactNode;\n  description?: React.ReactNode;\n  action?: React.ReactNode;\n}\n\nconst EmptyState = React.forwardRef<HTMLDivElement, EmptyStateProps>(\n  ({ className, icon, title, description, action, ...props }, ref) => (\n    <div\n      ref={ref}\n      className={cn(\n        \"flex min-h-48 flex-col items-center justify-center rounded-xl border border-dashed border-border bg-muted/35 px-6 py-10 text-center\",\n        className\n      )}\n      {...props}\n    >\n      {icon ? (\n        <div className=\"mb-4 grid h-10 w-10 place-items-center rounded-lg border border-border bg-card text-muted-foreground shadow-xs\">\n          {icon}\n        </div>\n      ) : null}\n      <strong className=\"text-sm font-semibold text-foreground\">{title}</strong>\n      {description ? (\n        <p className=\"mt-1.5 max-w-md text-sm leading-6 text-muted-foreground\">\n          {description}\n        </p>\n      ) : null}\n      {action ? <div className=\"mt-5\">{action}</div> : null}\n    </div>\n  )\n);\nEmptyState.displayName = \"EmptyState\";\n\nexport { EmptyState };\n","import * as React from \"react\"\nimport * as SeparatorPrimitive from \"@radix-ui/react-separator\"\n\nimport { cn } from \"@/utils/cn\"\n\nconst Separator = React.forwardRef<\n  React.ElementRef<typeof SeparatorPrimitive.Root>,\n  React.ComponentPropsWithoutRef<typeof SeparatorPrimitive.Root>\n>(\n  (\n    { className, orientation = \"horizontal\", decorative = true, ...props },\n    ref\n  ) => (\n    <SeparatorPrimitive.Root\n      ref={ref}\n      decorative={decorative}\n      orientation={orientation}\n      className={cn(\n        \"shrink-0 bg-border\",\n        orientation === \"horizontal\" ? \"h-[1px] w-full\" : \"h-full w-[1px]\",\n        className\n      )}\n      {...props}\n    />\n  )\n)\nSeparator.displayName = SeparatorPrimitive.Root.displayName\n\nexport { Separator }\n","/**\n * @author jasonHzq\n * @description 从 pontx service API 获取 spec 数据的 hook\n */\n\nimport { useState, useEffect, useCallback } from \"react\";\nimport type { PontxSpec } from \"@pontx/spec\";\n\n/** pontx service /api/specs 返回的摘要信息 */\ninterface SpecSummary {\n  name: string;\n  url?: string;\n  localPath?: string;\n  apiCount: number;\n  hasRemoteSpec: boolean;\n}\n\n/** 全局配置，由 pontx WebServer 注入 */\ninterface PontxConfig {\n  apiBaseUrl: string;\n}\n\n/** 读取 pontx 注入的全局配置 */\nfunction getConfig(): PontxConfig {\n  const config = (window as any).__PONTX_CONFIG__;\n  return {\n    apiBaseUrl: config?.apiBaseUrl || \"\",\n  };\n}\n\nexport function useSpecs(initialSpecName?: string) {\n  const [specList, setSpecList] = useState<SpecSummary[]>([]);\n  const [currentSpec, setCurrentSpec] = useState<PontxSpec | null>(null);\n  const [currentSpecName, setCurrentSpecName] = useState(\"\");\n  const [loading, setLoading] = useState(true);\n  const [error, setError] = useState<string | null>(null);\n\n  const { apiBaseUrl } = getConfig();\n\n  /** 获取指定 spec 的完整数据 */\n  const switchSpec = useCallback(\n    async (name: string) => {\n      try {\n        setLoading(true);\n        setError(null);\n        const res = await fetch(`${apiBaseUrl}/api/spec?name=${encodeURIComponent(name)}`);\n        if (!res.ok) {\n          throw new Error(`获取 spec 失败: ${res.statusText}`);\n        }\n        const spec: PontxSpec = await res.json();\n        setCurrentSpec(spec);\n        setCurrentSpecName(name);\n      } catch (err) {\n        setError(err instanceof Error ? err.message : \"未知错误\");\n      } finally {\n        setLoading(false);\n      }\n    },\n    [apiBaseUrl]\n  );\n\n  /** 启动时获取 spec 列表，并加载第一个 */\n  useEffect(() => {\n    async function init() {\n      try {\n        setLoading(true);\n        setError(null);\n\n        const res = await fetch(`${apiBaseUrl}/api/specs`);\n        if (!res.ok) {\n          throw new Error(`获取 specs 列表失败: ${res.statusText}`);\n        }\n        const list: SpecSummary[] = await res.json();\n        setSpecList(list);\n\n        if (list.length > 0) {\n          /* 优先加载 URL 指定的 spec，否则加载第一个 */\n          const target =\n            initialSpecName && list.some((s) => s.name === initialSpecName)\n              ? initialSpecName\n              : list[0].name;\n          await switchSpec(target);\n        } else {\n          setLoading(false);\n        }\n      } catch (err) {\n        setError(err instanceof Error ? err.message : \"未知错误\");\n        setLoading(false);\n      }\n    }\n\n    init();\n  }, [apiBaseUrl, switchSpec]);\n\n  return { specList, currentSpec, currentSpecName, switchSpec, loading, error };\n}\n","/**\n * @author jasonHzq\n * @description 从 pontx service API 获取代码生成场景并生成代码的 hook\n */\n\nimport { useState, useEffect, useCallback, useRef } from \"react\";\nimport type { CodeGenScenario, CodeGenRequest } from \"../../types/playground\";\n\n/** 读取 pontx 注入的全局配置中的 apiBaseUrl */\nfunction getApiBaseUrl(): string {\n  return (window as any).__PONTX_CONFIG__?.apiBaseUrl || \"\";\n}\n\n/**\n * 代码生成 hook\n *\n * 在远程模式下，从 pontx service 获取代码生成场景列表，\n * 并提供基于当前 API 身份（specName/selectedApiName）的代码生成回调。\n *\n * @param specName - 当前选中的 spec 名称\n * @param selectedApiName - 当前选中的 API 全名（格式: \"tagName/apiName\" 或 \"apiName\"）\n */\nexport function useCodeGen(specName: string, selectedApiName?: string) {\n  const apiBaseUrl = getApiBaseUrl();\n  const [scenarios, setScenarios] = useState<CodeGenScenario[]>([]);\n\n  /* ref 保持最新值，避免 onGenerateCode 闭包过期 */\n  const specNameRef = useRef(specName);\n  const selectedApiNameRef = useRef(selectedApiName);\n  specNameRef.current = specName;\n  selectedApiNameRef.current = selectedApiName;\n\n  /* 启动时获取场景列表 */\n  useEffect(() => {\n    fetch(`${apiBaseUrl}/api/code-gen/scenarios`)\n      .then((r) => r.json())\n      .then((data) => setScenarios(data.scenarios || []))\n      .catch(() => {});\n  }, [apiBaseUrl]);\n\n  /** 返回场景列表 */\n  const getCodeGenScenarios = useCallback(() => scenarios, [scenarios]);\n\n  /**\n   * 生成代码回调\n   * 通过 ref 获取最新的 specName 和 selectedApiName，\n   * 解析出 tagName/apiName，调用 pontx service 的代码生成 API\n   */\n  const onGenerateCode = useCallback(\n    async (req: CodeGenRequest): Promise<string> => {\n      const name = selectedApiNameRef.current;\n      if (!name) return \"// 请先选择一个 API\";\n\n      /* spec.apis key 格式: \"tagName/apiName\" 或 \"apiName\" */\n      const slashIdx = name.indexOf(\"/\");\n      const tagName = slashIdx !== -1 ? name.substring(0, slashIdx) : \"\";\n      const apiName = slashIdx !== -1 ? name.substring(slashIdx + 1) : name;\n\n      const res = await fetch(`${apiBaseUrl}/api/code-gen/generate`, {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          scenarioId: req.scenarioId,\n          specName: specNameRef.current,\n          tagName,\n          apiName,\n          requestParams: { ...req.request.path, ...req.request.query },\n          bodyParams: req.request.body || {},\n        }),\n      });\n\n      if (!res.ok) {\n        const err = await res.json().catch(() => ({}));\n        return `// 代码生成失败: ${(err as any).error || res.statusText}`;\n      }\n\n      const data = await res.json();\n      return data.code || \"// 无生成结果\";\n    },\n    [apiBaseUrl]\n  );\n\n  const hasScenarios = scenarios.length > 0;\n  return {\n    getCodeGenScenarios: hasScenarios ? getCodeGenScenarios : undefined,\n    onGenerateCode: hasScenarios ? onGenerateCode : undefined,\n  };\n}\n","/**\n * @author jasonHzq\n * @description URL 路由同步 hook，将 spec/API/schema 选择状态映射到浏览器 URL\n *\n * 路由格式：\n *   /{specName}/apis/{tagName}/{apiName}    — API 详情\n *   /{specName}/schemas/{schemaName}        — 数据结构详情\n *   /{specName}                             — spec 首页\n *   /                                       — 默认首页\n */\n\nimport { useRef, useEffect, useCallback } from \"react\";\n\n/** 路由状态 */\nexport interface RouteState {\n  specName?: string;\n  /** 元数据类型 */\n  type?: \"apis\" | \"schemas\";\n  /** API 所属的 tag 分组名 */\n  tagName?: string;\n  /** API name */\n  apiName?: string;\n  /** Schema name */\n  schemaName?: string;\n  /** Playground 面板是否打开 */\n  playgroundOpen?: boolean;\n}\n\n/** 从 URL 解析路由状态 */\nexport function parseRoute(\n  pathname = window.location.pathname,\n  search = window.location.search,\n): RouteState {\n  const segments = pathname\n    .replace(/^\\//, \"\")\n    .split(\"/\")\n    .filter(Boolean)\n    .map(decodeURIComponent);\n\n  const params = new URLSearchParams(search);\n  const playgroundOpen = params.get(\"playground\") === \"open\";\n\n  if (segments.length === 0) return { playgroundOpen: playgroundOpen || undefined };\n\n  const specName = segments[0];\n\n  if (segments.length === 1) return { specName, playgroundOpen: playgroundOpen || undefined };\n\n  const metaType = segments[1];\n\n  if (metaType === \"apis\" && segments.length >= 4) {\n    const tagName = segments[2];\n    const rawApiName = segments[3];\n    return {\n      specName,\n      type: \"apis\",\n      tagName,\n      apiName: `${tagName}/${rawApiName}`,\n      playgroundOpen: playgroundOpen || undefined,\n    };\n  }\n\n  if (metaType === \"schemas\" && segments.length >= 3) {\n    return {\n      specName,\n      type: \"schemas\",\n      schemaName: segments[2],\n      playgroundOpen: playgroundOpen || undefined,\n    };\n  }\n\n  return { specName, playgroundOpen: playgroundOpen || undefined };\n}\n\n/** 根据路由状态构建完整 URL（pathname + search） */\nfunction buildUrl(state: RouteState): string {\n  let pathname: string;\n  if (!state.specName) {\n    pathname = \"/\";\n  } else {\n    const base = \"/\" + encodeURIComponent(state.specName);\n\n    if (state.type === \"apis\" && state.tagName && state.apiName) {\n      const shortApiName = state.apiName.startsWith(state.tagName + \"/\")\n        ? state.apiName.slice(state.tagName.length + 1)\n        : state.apiName;\n      pathname = `${base}/apis/${encodeURIComponent(state.tagName)}/${encodeURIComponent(shortApiName)}`;\n    } else if (state.type === \"schemas\" && state.schemaName) {\n      pathname = `${base}/schemas/${encodeURIComponent(state.schemaName)}`;\n    } else {\n      pathname = base;\n    }\n  }\n\n  if (state.playgroundOpen) {\n    return pathname + \"?playground=open\";\n  }\n  return pathname;\n}\n\ntype PopStateCallback = (route: RouteState) => void;\n\nexport function useUrlRoute() {\n  const callbackRef = useRef<PopStateCallback | null>(null);\n  const initialRoute = useRef<RouteState>(parseRoute());\n\n  /** 监听浏览器前进/后退 */\n  useEffect(() => {\n    const handler = () => {\n      callbackRef.current?.(parseRoute());\n    };\n    window.addEventListener(\"popstate\", handler);\n    return () => window.removeEventListener(\"popstate\", handler);\n  }, []);\n\n  const pushRoute = useCallback((state: RouteState) => {\n    const url = buildUrl(state);\n    const currentUrl = window.location.pathname + window.location.search;\n    if (url !== currentUrl) {\n      history.pushState(null, \"\", url);\n    }\n  }, []);\n\n  const replaceRoute = useCallback((state: RouteState) => {\n    history.replaceState(null, \"\", buildUrl(state));\n  }, []);\n\n  /** 便捷方法：推送 API 路由 */\n  const pushApiRoute = useCallback(\n    (specName: string, tagName: string, apiName: string) => {\n      pushRoute({ specName, type: \"apis\", tagName, apiName });\n    },\n    [pushRoute],\n  );\n\n  /** 便捷方法：推送 schema 路由 */\n  const pushSchemaRoute = useCallback(\n    (specName: string, schemaName: string) => {\n      pushRoute({ specName, type: \"schemas\", schemaName });\n    },\n    [pushRoute],\n  );\n\n  /** 便捷方法：推送 spec 首页路由 */\n  const pushSpecRoute = useCallback(\n    (specName: string) => {\n      pushRoute({ specName });\n    },\n    [pushRoute],\n  );\n\n  /** 更新 playground 打开状态（使用 replaceState 避免污染历史） */\n  const replacePlaygroundState = useCallback(\n    (open: boolean) => {\n      const current = parseRoute();\n      replaceRoute({ ...current, playgroundOpen: open || undefined });\n    },\n    [replaceRoute],\n  );\n\n  /** 注册 popstate 回调 */\n  const onPopState = useCallback((cb: PopStateCallback) => {\n    callbackRef.current = cb;\n    return () => {\n      callbackRef.current = null;\n    };\n  }, []);\n\n  return {\n    initialRoute: initialRoute.current,\n    pushRoute,\n    replaceRoute,\n    pushApiRoute,\n    pushSchemaRoute,\n    pushSpecRoute,\n    replacePlaygroundState,\n    onPopState,\n  };\n}\n","/**\n * @author jasonHzq\n * @description Pontx API 文档 SPA 主应用组件\n */\n\nimport { useState, useEffect, lazy, Suspense, useCallback, useRef } from \"react\";\nimport {\n  ApiDirectory,\n  LoadingSpinner,\n  SchemaViewer,\n  Select,\n  SelectContent,\n  SelectItem,\n  SelectTrigger,\n  SelectValue,\n} from \"../index\";\nimport type { PlaygroundRequest, PlaygroundExecutionResult, CodeGenScenario, CodeGenRequest } from \"../types/playground\";\nimport { PontxSpec } from \"@pontx/spec\";\nimport type { PontxAPI } from \"@pontx/spec\";\nimport { useSpecs } from \"./hooks/useSpecs\";\nimport { useCodeGen } from \"./hooks/useCodeGen\";\nimport { useUrlRoute, type RouteState } from \"./hooks/useUrlRoute\";\n\n/* 懒加载 API 文档组件 */\nconst ApiDocumentation = lazy(() =>\n  import(\"../api-documentation\").then((mod) => ({\n    default: mod.ApiDocumentation,\n  }))\n);\n\nexport interface PontxAppProps {\n  /** 静态 spec 数据，传入后跳过 useSpecs() 远程加载 */\n  spec?: PontxSpec;\n  /** 获取代码生成场景列表 */\n  getCodeGenScenarios?: () => CodeGenScenario[];\n  /** 根据请求参数和场景生成代码 */\n  onGenerateCode?: (req: CodeGenRequest) => string | Promise<string>;\n}\n\n/** 从 spec 的 tagGroups 中查找 apiName 对应的 tagName */\nfunction findTagForApi(spec: PontxSpec, apiName: string): string | undefined {\n  const tagGroups = PontxSpec.getTagGroups(spec) as Array<{ name: string; apis: Record<string, PontxAPI> }>;\n  for (const group of tagGroups) {\n    if (apiName in group.apis) return group.name;\n  }\n  return undefined;\n}\n\n/** 从 spec 中按名称查找 API */\nfunction findApiByName(spec: PontxSpec, apiName: string): PontxAPI | undefined {\n  const tagGroups = PontxSpec.getTagGroups(spec) as Array<{ name: string; apis: Record<string, PontxAPI> }>;\n  for (const group of tagGroups) {\n    const api = group.apis[apiName];\n    if (api) return api;\n  }\n  return undefined;\n}\n\nfunction App({ spec: staticSpec, getCodeGenScenarios, onGenerateCode }: PontxAppProps = {}) {\n  /* 静态模式 vs 远程模式 */\n  const isStatic = !!staticSpec;\n\n  /* URL 路由 */\n  const route = useUrlRoute();\n  const { initialRoute } = route;\n  const initialRouteApplied = useRef(false);\n\n  const remote = useSpecs(initialRoute.specName);\n\n  const specList = isStatic ? [] : remote.specList;\n  const currentSpec = isStatic ? staticSpec : remote.currentSpec;\n  const currentSpecName = isStatic ? (staticSpec.name || \"default\") : remote.currentSpecName;\n  const switchSpec = remote.switchSpec;\n  const loading = isStatic ? false : remote.loading;\n  const error = isStatic ? null : remote.error;\n\n  /* 当前选中的 API */\n  const [selectedApiName, setSelectedApiName] = useState<string | undefined>();\n  const [selectedApi, setSelectedApi] = useState<PontxAPI | undefined>();\n\n  /* 当前选中的 Schema */\n  const [selectedSchemaName, setSelectedSchemaName] = useState<string | undefined>();\n\n  /* 远程模式下的代码生成 */\n  const codeGen = useCodeGen(currentSpecName, selectedApiName);\n  const effectiveGetCodeGenScenarios = getCodeGenScenarios || codeGen.getCodeGenScenarios;\n  const effectiveOnGenerateCode = onGenerateCode || codeGen.onGenerateCode;\n\n  /* Playground 面板打开状态 */\n  const [playgroundOpen, setPlaygroundOpen] = useState(initialRoute.playgroundOpen || false);\n\n  /* Playground 执行状态 */\n  const [executionResults, setExecutionResults] = useState<Record<string, PlaygroundExecutionResult | undefined>>({});\n  const [executingApis, setExecutingApis] = useState<Record<string, boolean>>({});\n\n  /* 初始路由恢复：spec 加载完成后，从 URL 恢复选中状态 */\n  useEffect(() => {\n    if (!currentSpec || initialRouteApplied.current) return;\n    initialRouteApplied.current = true;\n\n    if (initialRoute.type === \"apis\" && initialRoute.apiName) {\n      const api = findApiByName(currentSpec, initialRoute.apiName);\n      if (api) {\n        setSelectedApiName(initialRoute.apiName);\n        setSelectedApi({ ...api, components: currentSpec.components } as PontxAPI);\n        setSelectedSchemaName(undefined);\n      }\n    } else if (initialRoute.type === \"schemas\" && initialRoute.schemaName) {\n      setSelectedSchemaName(initialRoute.schemaName);\n      setSelectedApiName(undefined);\n      setSelectedApi(undefined);\n    }\n  }, [currentSpec, initialRoute]);\n\n  /* 监听浏览器前进/后退 */\n  useEffect(() => {\n    return route.onPopState((newRoute: RouteState) => {\n      /* spec 切换 */\n      if (newRoute.specName && newRoute.specName !== currentSpecName) {\n        switchSpec(newRoute.specName);\n      }\n\n      /* 恢复 playground 状态 */\n      setPlaygroundOpen(newRoute.playgroundOpen || false);\n\n      /* 恢复选中 */\n      if (newRoute.type === \"apis\" && newRoute.apiName && currentSpec) {\n        const api = findApiByName(currentSpec, newRoute.apiName);\n        if (api) {\n          setSelectedApiName(newRoute.apiName);\n       